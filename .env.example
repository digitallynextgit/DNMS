# =============================================================================
# DNMS environment. COMMIT THIS FILE, NEVER .env.
#
# Every variable the app reads, with no values. Add a line here whenever you add
# one to .env, or the next deploy is missing it and nobody finds out until the
# feature that needs it fails in production.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV="production"
DATABASE_URL="postgresql://user:pass@host:5432/dnms"

# Auth.js. AUTH_SECRET signs the session JWT - rotating it signs everyone out.
AUTH_SECRET="generate-with: openssl rand -base64 32"
# The app sets trustHost:true, so this is not required for sign-in to work. Set
# it anyway on the VPS: anything that builds an absolute URL outside a request
# (emails, some redirects) falls back to it.
NEXTAUTH_URL="https://dnms.digitallynext.com"

# ── Multi-tenancy (M4/M5) ────────────────────────────────────────────────────
# How hard the tenant guard enforces scoping (server/tenant-guard.ts):
#   off    - disabled
#   warn   - scope when there is a context, log loudly when there is not
#   strict - throw instead of logging
# USE STRICT. On "warn", a query that reaches the database with no tenant
# context reads across EVERY tenant instead of failing.
TENANT_ENFORCEMENT="strict"

# Who may open /platform, the console that lists every customer.
# Comma-separated emails. UNSET MEANS NOBODY - it never falls back to tenant
# admins. Being listed is not sufficient on its own: the session must also be in
# the founding tenant (server/platform-admin.ts).
PLATFORM_ADMINS="owner@yourcompany.com"

# ── Scheduled work ───────────────────────────────────────────────────────────
# Bearer token for /api/cron/*. FAILS CLOSED: unset means every cron job refuses
# to run, rather than running unauthenticated.
CRON_SECRET=""
# Set to "1" to stop the in-process schedulers (server/scheduler.ts). Leave unset
# in production - the cron ROUTES on this deployment have never been called, so
# anything relying on them would silently never run.
# DISABLE_INLINE_SCHEDULER=""

# ── Attendance ───────────────────────────────────────────────────────────────
# Platform-wide fallback secret for the biometric push hook. Resolves to the
# FOUNDING tenant only. New companies get a per-tenant secret in tenants.hook_secret
# instead; this exists so the terminal already installed in the office keeps
# working. Unset means the hook is off - it never defaults to open.
ATTENDANCE_HOOK_SECRET=""

# ── Encryption ───────────────────────────────────────────────────────────────
# AES-256-GCM key for Gmail app passwords (lib/crypto.ts). Rotating it makes
# every stored app password undecryptable, so they must be re-entered.
ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

# ── Google ───────────────────────────────────────────────────────────────────
# OAuth. Optional: without both, the "Sign in with Google" button is not rendered.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Service account for the DNMS Files shared drive.
GOOGLE_DRIVE_KEY_FILE=""
GOOGLE_DRIVE_SHARED_DRIVE_ID=""

# ── Public / headless APIs ───────────────────────────────────────────────────
# X-API-Key for the marketing site. Two keys on purpose: the write one can store
# applicant PII, so it must be rotatable independently of the read one.
CAREERS_API_KEY=""
CAREERS_WRITE_API_KEY=""

# ── AI ───────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=""

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_SUBJECT="mailto:admin@yourcompany.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Must match VAPID_PUBLIC_KEY - the browser needs it, so it is exposed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ── Not env vars ─────────────────────────────────────────────────────────────
# APP_URL and EMAIL_LOGO_URL live in the app_settings TABLE, not here. Change
# them in Admin → Settings.
