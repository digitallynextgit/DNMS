generator client {
  provider = "prisma-client-js"
  /// partialIndexes is needed for the partial unique index on ProjectWorkbook; without it `db push` sees that index as drift and drops it.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// A customer company. Digitally Next is tenant #1.
/// Tenant-scoped models keep `tenantId` as a plain scalar with a DB DEFAULT (FK enforced in SQL), not a Prisma relation.
model Tenant {
  id     String @id @default(uuid()) @map("id")
  /// URL segment: dnms.digitallynext.com/{slug}/...
  slug   String @unique @map("slug")
  name   String @map("name")
  /// ACTIVE | SUSPENDED | READ_ONLY
  status String @default("ACTIVE") @map("status")
  /// TRIAL | STARTER | RED | ENTERPRISE
  plan   String @default("ENTERPRISE") @map("plan")

  trialEndsAt DateTime? @map("trial_ends_at")

  /// Per-tenant secret the biometric terminal posts with, so one tenant's device can't write another's punches.
  /// Plain text because admins must read it back to type into the device. Null = push not configured.
  hookSecret String? @unique @map("hook_secret")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("tenants")
}

/// A person at the platform level, keyed by email. Not tenant-scoped: a Membership binds a User to a company.
/// setPassword() still also writes the legacy employees/client_users.password_hash columns so a rollback keeps working.
model User {
  id String @id @default(uuid()) @map("id")

  /// Always lower-cased via normalizeEmail() - the unique index is case-sensitive.
  email String @unique @map("email")
  name  String @map("name")

  /// Null = invited but never activated, or a Google-only account.
  passwordHash       String?   @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// Sessions issued before this are revoked, so a stolen cookie dies when the password changes.
  passwordChangedAt  DateTime? @map("password_changed_at")
  emailVerified      DateTime? @map("email_verified")
  lastLoginAt        DateTime? @map("last_login_at")

  /// Platform-wide lock; a membership's isActive only locks one company.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  passwordResets PasswordReset[]

  @@index([isActive])
  @@map("users")
}

enum MembershipKind {
  STAFF
  CLIENT
}

/// Binds a User to a Tenant. STAFF uses employeeId, CLIENT uses clientUserId.
/// The DB enforces this with a CHECK (exactly the matching id is set) and composite FKs (profile tenant must match).
model Membership {
  id       String         @id @default(uuid()) @map("id")
  userId   String         @map("user_id")
  tenantId String         @map("tenant_id")
  kind     MembershipKind @map("kind")

  employeeId   String? @map("employee_id")
  clientUserId String? @map("client_user_id")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clientUser ClientUser? @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  oauthGrants OAuthGrant[]

  /// A person can hold both a STAFF and a CLIENT membership in one tenant (e.g. a contractor who is also a client contact).
  @@unique([userId, tenantId, kind])
  @@unique([employeeId])
  @@unique([clientUserId])
  @@index([tenantId, isActive])
  @@index([userId])
  @@map("memberships")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// MONTHLY = 1/12 of the entitlement each month; UPFRONT = all of it at once (e.g. Maternity, LWP).
enum AccrualMethod {
  MONTHLY
  UPFRONT
}

// Which tier currently owns a pending leave request (routed by who applied).
enum LeaveApprovalStage {
  MANAGER
  HR
  ADMIN
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// Where the client's brand is in its lifecycle - shown as the project "Phase".
enum ProjectStage {
  LAUNCH
  GROWTH
  REBRANDING
  DECLINE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
  ON_HOLD
  DISCARDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  TECHNICAL
  HR
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

enum AttendanceSource {
  DEVICE
  GPS
  QR
  MANUAL
  CSV
}

enum DocumentCategory {
  IDENTITY
  ACADEMIC
  PROFESSIONAL
  EMPLOYMENT
  TAX
  COMPANY_POLICY
  TEMPLATE
  OTHER
}

// One template per kind per tenant.
enum ChecklistKind {
  ONBOARDING
  EXIT
}

// CLEARANCE is a sign-off by a named person; while a required one is unsigned the exit can't be completed.
enum ChecklistItemKind {
  TASK
  CLEARANCE
}

// Resolved to a real employee when the checklist is created; HR stays unresolved (a pool, not a person).
enum ChecklistAssigneeRole {
  HR
  MANAGER
  EMPLOYEE
  DEPARTMENT_HEAD
}

enum ChecklistStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Account {
  id                String  @id @default(cuid()) @map("id")
  userId            String  @map("user_id")
  type              String  @map("type")
  provider          String  @map("provider")
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token") @db.Text
  access_token      String? @map("access_token") @db.Text
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String? @map("scope")
  id_token          String? @map("id_token") @db.Text
  session_state     String? @map("session_state")

  employee Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("id")
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @map("expires")

  employee Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String   @map("identifier")
  token      String   @unique @map("token")
  expires    DateTime @map("expires")

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Role {
  tenantId    String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String   @id @default(uuid()) @map("id")
  name        String   @map("name")
  displayName String   @map("display_name")
  description String?  @map("description")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  employeeRoles   EmployeeRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @map("id")
  scope       String   @unique @map("scope")
  module      String   @map("module")
  action      String   @map("action")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId     String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model EmployeeRole {
  tenantId   String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String  @id @default(uuid()) @map("id")
  employeeId String  @map("employee_id")
  roleId     String  @map("role_id")
  scopeType  String? @map("scope_type")
  scopeId    String? @map("scope_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([employeeId, roleId, scopeType, scopeId])
  @@index([tenantId])
  @@map("employee_roles")
}

model AuditLog {
  tenantId   String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String   @id @default(uuid()) @map("id")
  actorId    String?  @map("actor_id")
  action     String   @map("action")
  module     String   @map("module")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?    @map("changes")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([module])
  @@index([createdAt])
  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([tenantId])
  @@map("audit_logs")
}

model Department {
  tenantId         String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id               String   @id @default(uuid()) @map("id")
  name             String   @map("name")
  code             String   @map("code")
  description      String?  @map("description")
  headId           String?  @map("head_id")
  parentId         String?  @map("parent_id")
  isActive         Boolean  @default(true) @map("is_active")
  careersTone      String?  @map("careers_tone")
  careersJobsLabel String?  @map("careers_jobs_label")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  head            Employee?               @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  parent          Department?             @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Department[]            @relation("DepartmentHierarchy")
  employees       Employee[]
  jobPostings     JobPosting[]
  jobRoles        JobRole[]
  clearanceItems  ChecklistTemplateItem[] @relation("ChecklistClearanceDepartment")

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Designation {
  tenantId         String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id               String   @id @default(uuid()) @map("id")
  title            String   @map("title")
  level            Int      @map("level") // 1-13 (L1-L13)
  code             String?  @map("code") // "L1".."L13"; several titles can share a code
  phase            String?  @map("phase") // FOUNDATION | ELEVATE | PINNACLE
  maxMonthlySalary Float?   @map("max_monthly_salary") // null for L10+ (no cap)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@unique([tenantId, title])
  @@index([tenantId])
  @@map("designations")
}

// A job role within a department (e.g. "Full Stack Developer"); separate from the Designation grade.
model JobRole {
  tenantId     String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String   @id @default(uuid()) @map("id")
  name         String   @map("name")
  departmentId String   @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([tenantId])
  @@map("job_roles")
}

model Employee {
  tenantId   String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String  @id @default(uuid()) @map("id")
  employeeNo String  @map("employee_no")
  deviceId   String? @map("device_id")

  firstName     String  @map("first_name")
  lastName      String  @map("last_name")
  email         String  @unique @map("email")
  personalEmail String? @unique @map("personal_email")
  phone         String? @map("phone")
  personalPhone String? @map("personal_phone")

  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          Gender?   @map("gender")
  nationality     String?   @map("nationality")
  bloodGroup      String?   @map("blood_group")
  // profilePhoto is the display URL; profilePhotoKey is the B2 object key, kept so the old file can be deleted.
  profilePhoto    String?   @map("profile_photo")
  profilePhotoKey String?   @map("profile_photo_key")

  currentAddress   Json? @map("current_address")
  permanentAddress Json? @map("permanent_address")
  emergencyContact Json? @map("emergency_contact")

  departmentId     String?        @map("department_id")
  designationId    String?        @map("designation_id")
  jobRoleId        String?        @map("job_role_id")
  managerId        String?        @map("manager_id")
  dottedManagerId  String?        @map("dotted_manager_id")
  employmentType   EmploymentType @default(FULL_TIME) @map("employment_type")
  status           EmployeeStatus @default(ACTIVE) @map("status")
  dateOfJoining    DateTime?      @map("date_of_joining") @db.Date
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  confirmationDate DateTime?      @map("confirmation_date") @db.Date
  // Effective probation = onProbation AND today < dateOfJoining + probationMonths (3 or 6). Admin can end it early.
  onProbation      Boolean        @default(true) @map("on_probation")
  probationMonths  Int            @default(6) @map("probation_months")
  workLocation     String?        @map("work_location")
  resignationDate  DateTime?      @map("resignation_date") @db.Date
  lastWorkingDate  DateTime?      @map("last_working_date") @db.Date

  passwordHash       String?   @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  emailVerified      DateTime? @map("email_verified")
  // Forces the user to /change-password until they set a new one (e.g. after an HR reset).
  mustChangePassword Boolean   @default(false) @map("must_change_password")

  // Encrypted Gmail App Password (AES-256-GCM, iv:tag:ct) used by sendEmailAs(). Never return it from an API.
  gmailAppPassword String? @map("gmail_app_password")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  jobRole            JobRole?     @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  manager            Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       Employee[]   @relation("EmployeeManager")
  dottedManager      Employee?    @relation("EmployeeDottedManager", fields: [dottedManagerId], references: [id], onDelete: SetNull)
  dottedSubordinates Employee[]   @relation("EmployeeDottedManager")

  storageAccounts StorageAccount[] @relation("StorageAccountAuthor")

  chatParticipations ConversationParticipant[] @relation("ChatParticipant")
  chatMessages       ChatMessage[]             @relation("ChatSender")
  chatReactions      ChatMessageReaction[]     @relation("ChatReactor")
  msgReactions       ProjectMessageReaction[]  @relation("ProjectMessageReactor")

  announcements     Announcement[] @relation("AnnouncementAuthor")
  photoAlbums       PhotoAlbum[]   @relation("AlbumAuthor")
  photos            Photo[]        @relation("PhotoUploader")
  departmentsHeaded Department[]   @relation("DepartmentHead")

  accounts Account[]
  sessions Session[]

  /// Optional only because the FK lives on memberships; every employee has one.
  membership Membership?

  employeeRoles EmployeeRole[]

  auditLogs AuditLog[]

  documents         Document[]         @relation("EmployeeDocuments")
  employeeDocuments EmployeeDocument[] @relation("EmployeePersonalDocuments")
  docRequests       DocumentRequest[]  @relation("DocRequestEmployee")
  docRequestsMade   DocumentRequest[]  @relation("DocRequestRequester")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  stockIssues StockIssue[]

  // AI apps connected via MCP
  oauthGrants OAuthGrant[]

  attendanceLogs          AttendanceLog[]
  regularizations         AttendanceRegularization[] @relation("RegularizationEmployee")
  regularizationsReviewed AttendanceRegularization[] @relation("RegularizationReviewer")

  leaveRequests         LeaveRequest[] @relation("LeaveRequests")
  leaveApprovals        LeaveRequest[] @relation("LeaveApprovals")
  leaveCurrentApprovals LeaveRequest[] @relation("LeaveCurrentApprovals")
  leaveBalances         LeaveBalance[]

  salaryStructure SalaryStructure?
  payrollRecords  PayrollRecord[]

  projectMemberships ProjectMember[]
  assignedTasks      ProjectTask[]          @relation("TaskAssignee")
  raisedRequirements ProjectRequirement[]   @relation("RequirementRaiser")
  ownedRequirements  ProjectRequirement[]   @relation("RequirementOwner")
  createdTasks       ProjectTask[]          @relation("TaskCreator")
  taskStatusChanges  TaskStatusPeriod[]     @relation("TaskStatusActor")
  contentEntries     ContentCalendarEntry[] @relation("ContentAssignee")
  sheetsCreated      ProjectSheet[]         @relation("SheetAuthor")
  workbookTeamsCreated ProjectWorkbookTeam[] @relation("WorkbookTeamAuthor")
  workbookTeamSeats  ProjectWorkbookTeamMember[] @relation("WorkbookTeamMembership")
  workbooksCreated   ProjectWorkbook[]      @relation("WorkbookAuthor")
  workbooksAssigned  ProjectWorkbook[]      @relation("WorkbookAssignee")
  sheetRowsCreated   ProjectSheetRow[]      @relation("SheetRowAuthor")
  sheetEvents        ProjectSheetEvent[]    @relation("SheetEventActor")
  timesheets         Timesheet[]
  ownedProjects      Project[]              @relation("ProjectOwner")
  ownedClients       Client[]               @relation("ClientOwner")
  brandAssets        BrandAsset[]           @relation("BrandAssetUploader")

  perfKpis             PerfKpi[]    @relation("EmployeePerfKpis")
  evaluations          Evaluation[] @relation("EvaluationEmployee")
  evaluationsToRate    Evaluation[] @relation("EvaluationManager")
  evaluationsToControl Evaluation[] @relation("EvaluationController")

  jobPostings JobPosting[] @relation("PostingCreator")
  interviews  Interview[]  @relation("Interviewer")

  passwordResets PasswordReset[]

  // Lets HR/admin lift the 15-minute task edit window (lib/edit-window.ts) for this person.
  canEditPastTasks          Boolean    @default(false) @map("can_edit_past_tasks")
  /// Recorded so a standing bypass of the edit window is attributable.
  pastTaskAccessGrantedAt   DateTime?  @map("past_task_access_granted_at")
  pastTaskAccessGrantedById String?    @map("past_task_access_granted_by_id")
  pastTaskAccessGrantedBy   Employee?  @relation("PastTaskAccessGranter", fields: [pastTaskAccessGrantedById], references: [id], onDelete: SetNull)
  pastTaskAccessGrants      Employee[] @relation("PastTaskAccessGranter")

  taskReminderPreference TaskReminderPreference?

  referralsMade      CareerApplication[] @relation("ReferralReferrer")
  referredHireRecord CareerApplication[] @relation("ReferralHire")

  wfhRequests         WfhRequest[] @relation("WfhRequester")
  wfhManagerApprovals WfhRequest[] @relation("WfhManagerApprover")
  wfhHrApprovals      WfhRequest[] @relation("WfhHrApprover")

  floatingHolidays FloatingHolidaySelection[]

  resignations         Resignation[] @relation("ResignationEmployee")
  resignationsReviewed Resignation[] @relation("ResignationReviewer")

  checklists          ChecklistInstance[]     @relation("ChecklistEmployee")
  checklistsStarted   ChecklistInstance[]     @relation("ChecklistStartedBy")
  checklistsCompleted ChecklistInstance[]     @relation("ChecklistCompletedBy")
  checklistItems      ChecklistInstanceItem[] @relation("ChecklistItemAssignee")
  checklistItemsDone  ChecklistInstanceItem[] @relation("ChecklistItemDoneBy")

  joineeScorecard       JoineeScorecard?  @relation("JoineeScorecardEmployee")
  joineeScorecardsSpoc  JoineeScorecard[] @relation("JoineeScorecardHrSpoc")

  managedTeams           ProjectTeam[]          @relation("TeamManager")
  projectTeamMemberships ProjectTeamMember[]    @relation("ProjectTeamMembership")
  uploadedResources      ProjectResource[]      @relation("ResourceUploader")
  reviewedResources      ProjectResource[]      @relation("ResourceStaffReviewer")
  createdFolders         ProjectFolder[]        @relation("FolderCreator")
  createdLinks           ProjectLink[]          @relation("LinkCreator")
  taskComments           TaskComment[]          @relation("CommentAuthor")
  projectActivities      ProjectActivity[]      @relation("ActivityActor")
  projectMessages        ProjectMessage[]       @relation("MessageAuthor")
  messageReplies         ProjectMessageReply[]  @relation("MessageReplyAuthor")
  messageReads           ProjectMessageRead[]
  createdPasswords       ProjectPasswordEntry[] @relation("PasswordCreator")

  createdClientUsers  ClientUser[]          @relation("ClientUserCreator")
  createdClients      Client[]              @relation("ClientCreator")
  grantedClientAccess ClientProjectAccess[] @relation("ClientAccessGranter")

  projectTemplates ProjectEmailTemplate[] @relation("ProjectTemplateAuthor")
  mailerAssets     ProjectMailerAsset[]   @relation("MailerAssetAuthor")
  campaigns        ProjectCampaign[]      @relation("CampaignAuthor")

  ownedAssets           ProjectAsset[]    @relation("AssetOwner")
  ownedMonitors         UptimeMonitor[]   @relation("MonitorOwner")
  acknowledgedIncidents UptimeIncident[]  @relation("IncidentAcknowledger")
  pollVotes             MessagePollVote[] @relation("PollVoter")
  sharedContacts        MessageContact[]  @relation("SharedContact")

  goalsCreated         ProjectGoal[]             @relation("GoalCreator")
  goalsOwned           ProjectGoal[]             @relation("GoalOwner")
  deliverablesMade     ProjectDeliverable[]      @relation("DeliverableMaker")
  deliverablesLogged   ProjectDeliverable[]      @relation("DeliverableLogger")
  deliverablesVerified ProjectDeliverable[]      @relation("DeliverableVerifier")
  deliverablesAccepted ProjectDeliverable[]      @relation("DeliverableAcceptor")
  deliverableEvents    ProjectDeliverableEvent[] @relation("DeliverableEventActor")
  goalTargetsCreated   ProjectGoalTarget[]       @relation("GoalTargetCreator")
  goalEvents           ProjectGoalEvent[]        @relation("GoalEventActor")

  @@unique([tenantId, employeeNo])
  @@index([managerId])
  @@index([status, isActive])
  @@index([createdAt])
  @@index([departmentId])
  @@index([designationId])
  @@index([tenantId])
  @@map("employees")
}

model Document {
  tenantId     String           @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String           @id @default(uuid()) @map("id")
  title        String           @map("title")
  description  String?          @map("description")
  category     DocumentCategory @default(OTHER) @map("category")
  fileName     String           @map("file_name")
  fileSize     Int              @map("file_size")
  mimeType     String           @map("mime_type")
  objectKey    String           @map("object_key")
  version      Int              @default(1) @map("version")
  employeeId   String?          @map("employee_id")
  uploadedById String           @map("uploaded_by_id")
  isCompanyDoc Boolean          @default(false) @map("is_company_doc")
  expiresAt    DateTime?        @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  employee Employee? @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([category])
  @@index([isCompanyDoc])
  @@index([tenantId])
  @@map("documents")
}

// Personal employee documents, kept apart from company-wide `Document`s.
model EmployeeDocument {
  tenantId     String           @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String           @id @default(uuid()) @map("id")
  employeeId   String           @map("employee_id")
  title        String           @map("title")
  category     DocumentCategory @default(OTHER) @map("category")
  fileName     String           @map("file_name")
  fileSize     Int              @map("file_size")
  mimeType     String           @map("mime_type")
  objectKey    String           @map("object_key")
  uploadedById String           @map("uploaded_by_id")
  expiresAt    DateTime?        @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  employee Employee @relation("EmployeePersonalDocuments", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([category])
  @@index([tenantId])
  @@map("employee_documents")
}

// HR asks an employee to upload a specific document; fulfilled when they upload.
model DocumentRequest {
  tenantId      String           @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id            String           @id @default(uuid()) @map("id")
  employeeId    String           @map("employee_id")
  requestedById String           @map("requested_by_id")
  title         String           @map("title")
  category      DocumentCategory @default(OTHER) @map("category")
  note          String?          @map("note")
  dueDate       DateTime?        @map("due_date") @db.Date
  status        String           @default("PENDING") @map("status") // PENDING | FULFILLED | CANCELLED
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  employee    Employee @relation("DocRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy Employee @relation("DocRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([tenantId])
  @@map("document_requests")
}

model EmailTemplate {
  tenantId    String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String   @id @default(uuid()) @map("id")
  slug        String   @map("slug")
  name        String   @map("name")
  subject     String   @map("subject")
  bodyHtml    String   @map("body_html") @db.Text
  bodyText    String?  @map("body_text") @db.Text
  mergeFields String[] @map("merge_fields")
  isActive    Boolean  @default(true) @map("is_active")
  trigger     String?  @map("trigger")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  emailLogs EmailLog[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("email_templates")
}

model EmailLog {
  tenantId       String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id             String    @id @default(uuid()) @map("id")
  templateId     String?   @map("template_id")
  recipientEmail String    @map("recipient_email")
  subject        String    @map("subject")
  status         String    @default("queued") @map("status")
  error          String?   @map("error")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
  @@map("email_logs")
}

model Notification {
  tenantId   String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String    @id @default(uuid()) @map("id")
  employeeId String    @map("employee_id")
  title      String    @map("title")
  message    String    @map("message")
  type       String    @map("type")
  link       String?   @map("link")
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isRead])
  @@index([createdAt])
  @@index([employeeId, createdAt])
  // Org-wide unread count: the [employeeId, isRead] index can't serve a pure isRead filter.
  @@index([isRead])
  @@index([tenantId])
  @@map("notifications")
}

/// One row per browser/device with push permission, so alerts arrive even with no DNMS tab open.
model PushSubscription {
  tenantId   String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String   @id @default(uuid()) @map("id")
  employeeId String   @map("employee_id")
  endpoint   String   @unique @map("endpoint")
  p256dh     String   @map("p256dh")
  auth       String   @map("auth")
  userAgent  String?  @map("user_agent")
  /// Site that registered this browser (from the Origin header). Sends filter on it, so a dev server
  /// sharing the production DB doesn't make every notification fire twice.
  origin     String?  @map("origin")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, origin])
  @@index([tenantId])
  @@map("push_subscriptions")
}

/// Reminders before a running task's time budget runs out. No row = defaults in features/notifications/constants.ts.
model TaskReminderPreference {
  tenantId   String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String  @id @default(uuid()) @map("id")
  employeeId String  @unique @map("employee_id")
  enabled    Boolean @default(true) @map("enabled")

  /// Minutes before the estimate runs out that the first reminder fires.
  leadMinutes Int @default(15) @map("lead_minutes")

  /// Max reminders per task run, the first one included.
  reminderCount Int @default(1) @map("reminder_count")

  /// Minutes between reminders (lead 15 / count 3 / every 5 fires at 15, 10 and 5 minutes out).
  repeatEveryMinutes Int @default(5) @map("repeat_every_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("task_reminder_preferences")
}

/// Reminders already sent for one task run (one uninterrupted IN_PROGRESS stretch, keyed by inProgressSince).
/// The unique key stops a re-run or catch-up cron from sending one twice.
model TaskReminderState {
  tenantId     String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String    @id @default(uuid()) @map("id")
  taskId       String    @map("task_id")
  runStartedAt DateTime  @map("run_started_at")
  sentCount    Int       @default(0) @map("sent_count")
  lastSentAt   DateTime? @map("last_sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, runStartedAt])
  @@index([createdAt])
  @@index([tenantId])
  @@map("task_reminder_states")
}

model HikvisionDevice {
  tenantId     String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String    @id @default(uuid()) @map("id")
  name         String    @map("name")
  deviceSerial String    @unique @map("device_serial")
  ipAddress    String    @map("ip_address")
  port         Int       @default(8000) @map("port")
  username     String    @default("admin") @map("username")
  password     String    @map("password")
  location     String?   @map("location")
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncAt   DateTime? @map("last_sync_at")

  /// Last punch PUSHED to /api/attendance/hook. Unlike lastSyncAt (also set by the pull sync), this shows
  /// whether realtime push actually works.
  lastPushAt DateTime? @map("last_push_at")

  /// The device's own identity, read on first connect. ipAddress moves with DHCP; these find the box again.
  hardwareSerial String?  @map("hardware_serial")
  macAddress     String?  @map("mac_address")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attendanceLogs AttendanceLog[]

  @@index([tenantId])
  @@map("hikvision_devices")
}

model AttendanceLog {
  tenantId       String           @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id             String           @id @default(uuid()) @map("id")
  employeeId     String           @map("employee_id")
  deviceId       String?          @map("device_id")
  date           DateTime         @map("date") @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  workHours      Float?           @map("work_hours")
  status         AttendanceStatus @default(PRESENT) @map("status")
  // isManual = the row has at least one HR correction. The *Manual flags lock only the field HR changed;
  // every other field keeps syncing from the device.
  isManual       Boolean          @default(false) @map("is_manual")
  checkInManual  Boolean          @default(false) @map("check_in_manual")
  checkOutManual Boolean          @default(false) @map("check_out_manual")
  statusManual   Boolean          @default(false) @map("status_manual")
  source         String?          @map("source")
  notes          String?          @map("notes")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   HikvisionDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
  @@index([tenantId])
  @@map("attendance_logs")
}

// Employee-submitted correction of a missed/wrong punch, approved by HR/manager.
model AttendanceRegularization {
  tenantId          String      @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id                String      @id @default(uuid()) @map("id")
  employeeId        String      @map("employee_id")
  date              DateTime    @map("date") @db.Date
  requestedCheckIn  DateTime?   @map("requested_check_in")
  requestedCheckOut DateTime?   @map("requested_check_out")
  reason            String      @map("reason")
  status            LeaveStatus @default(PENDING) @map("status")
  reviewerId        String?     @map("reviewer_id")
  reviewNote        String?     @map("review_note")
  reviewedAt        DateTime?   @map("reviewed_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  employee Employee  @relation("RegularizationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee? @relation("RegularizationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([tenantId])
  @@map("attendance_regularizations")
}

model Holiday {
  tenantId    String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String   @id @default(uuid()) @map("id")
  name        String   @map("name")
  date        DateTime @map("date") @db.Date
  description String?  @map("description")
  isOptional  Boolean  @default(false) @map("is_optional") // true = floating holiday
  createdAt   DateTime @default(now()) @map("created_at")

  floatingSelections FloatingHolidaySelection[]

  @@unique([tenantId, date, name])
  @@index([tenantId])
  @@map("holidays")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @map("id")
  email     String   @unique @map("email")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// Public marketing-site enquiries; platform-global (no tenantId). Saved before the email is sent, so
// emailSent says whether the notification went out.
model ContactEnquiry {
  id        String   @id @default(uuid()) @map("id")
  name      String   @map("name")
  email     String   @map("email")
  company   String?  @map("company")
  topic     String   @map("topic")
  message   String   @map("message")
  emailSent Boolean  @default(false) @map("email_sent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_enquiries")
}

// Office stock register. Stock left = purchased - issued (computed, never stored).
model StockItem {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")

  name          String   @map("name")
  /// Column order in the register matrix; new items append.
  position      Int      @default(0) @map("position")
  /// Purchase price per piece, as uploaded. Null when the sheet had none.
  pricePerPiece Decimal? @map("price_per_piece") @db.Decimal(12, 2)
  purchasedQty  Int      @default(0) @map("purchased_qty")
  notes         String?  @map("notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issues StockIssue[]

  @@unique([tenantId, name])
  @@map("stock_items")
}

model StockIssue {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")

  itemId String @map("item_id")

  /// Holder as typed; kept even when linked to an employee.
  holderName String  @map("holder_name")
  /// Optional link to a matching employee; an unlinked name is a valid state.
  employeeId String? @map("employee_id")

  quantity Int       @default(1) @map("quantity")
  issuedOn DateTime? @map("issued_on") @db.Date
  notes    String?   @map("notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item     StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// SetNull: the register row outlives the employee, and holderName still says who.
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([itemId])
  @@index([employeeId])
  @@index([tenantId, holderName])
  @@map("stock_issues")
}

model WfhRequest {
  tenantId          String      @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id                String      @id @default(uuid()) @map("id")
  employeeId        String      @map("employee_id")
  // A request covers a range of working days: `date` is the first day, `endDate` the last (== date for one day).
  date              DateTime    @map("date") @db.Date
  endDate           DateTime    @map("end_date") @db.Date
  /// Working days in the range (weekends and holidays skipped, so Fri-Mon is 2).
  totalDays         Int         @default(1) @map("total_days")
  reason            String?     @map("reason")
  status            LeaveStatus @default(PENDING) @map("status")
  isEmergency       Boolean     @default(false) @map("is_emergency") // tier 1/2 emergency override
  // The manager's call ("APPROVED" | "REJECTED"); the first decision (manager or HR) is final.
  managerDecision   String?     @map("manager_decision")
  managerApproverId String?     @map("manager_approver_id")
  managerApprovedAt DateTime?   @map("manager_approved_at")
  hrApproverId      String?     @map("hr_approver_id")
  hrApprovedAt      DateTime?   @map("hr_approved_at")
  rejectionReason   String?     @map("rejection_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  employee        Employee  @relation("WfhRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  managerApprover Employee? @relation("WfhManagerApprover", fields: [managerApproverId], references: [id], onDelete: SetNull)
  hrApprover      Employee? @relation("WfhHrApprover", fields: [hrApproverId], references: [id], onDelete: SetNull)

  // Overlap guard: a partial EXCLUDE constraint (wfh_requests_no_active_overlap) in the migrations,
  // since Prisma can't express EXCLUDE.
  @@index([employeeId])
  @@index([status])
  @@index([date, endDate])
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("wfh_requests")
}

// Admin-editable runtime config (SMTP, HR inbox, branding). Secret values are stored encrypted.
model AppSetting {
  key       String   @id @map("key")
  value     String?  @map("value")
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Resignation {
  tenantId                 String      @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id                       String      @id @default(uuid()) @map("id")
  employeeId               String      @map("employee_id")
  reason                   String?     @map("reason")
  requestedLastWorkingDate DateTime?   @map("requested_last_working_date") @db.Date
  status                   LeaveStatus @default(PENDING) @map("status")
  reviewerId               String?     @map("reviewer_id")
  reviewNote               String?     @map("review_note")
  reviewedAt               DateTime?   @map("reviewed_at")
  // Message-ID of the email to HR, so the approve/decline reply lands on the same Gmail thread.
  requestEmailMessageId    String?     @map("request_email_message_id")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  employee  Employee           @relation("ResignationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer  Employee?          @relation("ResignationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  checklist ChecklistInstance?

  @@index([employeeId])
  @@index([status])
  @@index([tenantId])
  @@map("resignations")
}

// HR checklists. An instance COPIES its template's text, so editing the template never rewords a signed record.
model ChecklistTemplate {
  tenantId    String        @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String        @id @default(uuid()) @map("id")
  kind        ChecklistKind @map("kind")
  name        String        @map("name")
  description String?       @map("description")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  sections  ChecklistTemplateSection[]
  instances ChecklistInstance[]

  @@unique([tenantId, kind])
  @@index([tenantId])
  @@map("checklist_templates")
}

model ChecklistTemplateSection {
  tenantId     String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String   @id @default(uuid()) @map("id")
  templateId   String   @map("template_id")
  title        String   @map("title")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  template ChecklistTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ChecklistTemplateItem[]

  @@index([templateId])
  @@index([tenantId])
  @@map("checklist_template_sections")
}

model ChecklistTemplateItem {
  tenantId     String                @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String                @id @default(uuid()) @map("id")
  sectionId    String                @map("section_id")
  text         String                @map("text")
  helpText     String?               @map("help_text")
  itemKind     ChecklistItemKind     @default(TASK) @map("item_kind")
  assigneeRole ChecklistAssigneeRole @default(HR) @map("assignee_role")
  /// Department that clears DEPARTMENT_HEAD items (Finance and IT/Admin are just Departments here).
  clearanceDepartmentId String?      @map("clearance_department_id")
  /// A required CLEARANCE blocks completion. A required TASK only warns.
  isRequired   Boolean               @default(true) @map("is_required")
  /// Days from the instance's anchor date (joining date / last working date).
  offsetDays   Int?                  @map("offset_days")
  displayOrder Int                   @default(0) @map("display_order")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  section    ChecklistTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  department Department?              @relation("ChecklistClearanceDepartment", fields: [clearanceDepartmentId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@index([tenantId])
  @@map("checklist_template_items")
}

model ChecklistInstance {
  tenantId   String          @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String          @id @default(uuid()) @map("id")
  kind       ChecklistKind   @map("kind")
  employeeId String          @map("employee_id")
  /// Exit checklists hang off the resignation that started them. One each.
  resignationId String?      @unique @map("resignation_id")
  /// Provenance only; nulled if the template is deleted, since the snapshot stands on its own.
  templateId String?         @map("template_id")
  status     ChecklistStatus @default(IN_PROGRESS) @map("status")
  /// dateOfJoining for onboarding, lastWorkingDate for exit; item due dates derive from it.
  anchorDate DateTime?       @db.Date @map("anchor_date")

  startedById   String?   @map("started_by_id")
  completedAt   DateTime? @map("completed_at")
  completedById String?   @map("completed_by_id")
  cancelReason  String?   @map("cancel_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee    Employee                @relation("ChecklistEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  resignation Resignation?            @relation(fields: [resignationId], references: [id], onDelete: SetNull)
  template    ChecklistTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startedBy   Employee?               @relation("ChecklistStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  completedBy Employee?               @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  items       ChecklistInstanceItem[]

  @@index([employeeId])
  @@index([kind, status])
  @@index([status])
  @@index([tenantId])
  @@map("checklist_instances")
}

/// 15-day new-joinee scorecard: manager's and HR's daily 1-5 ratings, then observations and a recommendation.
/// Only raw scores are stored; criteria and averages live in features/joinee-scorecard/lib/scorecard.ts.
model JoineeScorecard {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")

  employeeId          String   @map("employee_id")
  /// HR's single point of contact for this joinee.
  hrSpocId            String?  @map("hr_spoc_id")
  managerObservations String?  @map("manager_observations") @db.Text
  hrObservations      String?  @map("hr_observations") @db.Text
  /// CONTINUE | CONTINUE_WITH_IMPROVEMENTS | REVIEW_REQUIRED (null = not decided yet)
  recommendation      String?  @map("recommendation")
  createdById         String?  @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  employee Employee              @relation("JoineeScorecardEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  hrSpoc   Employee?             @relation("JoineeScorecardHrSpoc", fields: [hrSpocId], references: [id], onDelete: SetNull)
  days     JoineeScorecardDay[]

  @@unique([employeeId])
  @@index([tenantId])
  @@map("joinee_scorecards")
}

/// One working day of a JoineeScorecard. Scores are 1-5 or null; a CHECK constraint holds the range.
model JoineeScorecardDay {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")

  scorecardId String   @map("scorecard_id")
  /// 1..15
  dayNumber   Int      @map("day_number")
  date        DateTime @map("date") @db.Date

  mgrJobRole       Int? @map("mgr_job_role")
  mgrCommunication Int? @map("mgr_communication")
  mgrLearning      Int? @map("mgr_learning")
  hrDiscipline     Int? @map("hr_discipline")
  hrCulture        Int? @map("hr_culture")
  hrLearning       Int? @map("hr_learning")

  updatedAt DateTime @updatedAt @map("updated_at")

  scorecard JoineeScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, dayNumber])
  @@index([tenantId])
