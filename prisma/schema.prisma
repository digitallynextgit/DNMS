// =============================================================================
// DNMS Prisma Schema - Phase 1 + Phase 2 + Phase 3 + Phase 4
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ── Attendance ────────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

// ── Leave ─────────────────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// How a leave type's annual entitlement becomes available over the year.
// MONTHLY = drip 1/12 each month (recomputed, self-healing).
// UPFRONT = full entitlement available immediately (e.g. Maternity, LWP).
enum AccrualMethod {
  MONTHLY
  UPFRONT
}

// Which tier currently owns a pending leave request (routed by who applied).
enum LeaveApprovalStage {
  MANAGER
  HR
  ADMIN
}

// ── Payroll ───────────────────────────────────────────────────────────────────

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
}

// ── Projects ──────────────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
  ON_HOLD
  DISCARDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

// ── Recruitment ───────────────────────────────────────────────────────────────

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  TECHNICAL
  HR
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

// ── M12 Attendance sources ─────────────────────────────────────────────────────

enum AttendanceSource {
  DEVICE
  GPS
  QR
  MANUAL
  CSV
}

// ── Documents ─────────────────────────────────────────────────────────────────

enum DocumentCategory {
  IDENTITY
  ACADEMIC
  PROFESSIONAL
  EMPLOYMENT
  TAX
  COMPANY_POLICY
  TEMPLATE
  OTHER
}

// =============================================================================
// NEXT-AUTH MODELS
// =============================================================================

model Account {
  id                String  @id @default(cuid()) @map("id")
  userId            String  @map("user_id")
  type              String  @map("type")
  provider          String  @map("provider")
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token") @db.Text
  access_token      String? @map("access_token") @db.Text
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String? @map("scope")
  id_token          String? @map("id_token") @db.Text
  session_state     String? @map("session_state")

  employee Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("id")
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @map("expires")

  employee Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String   @map("identifier")
  token      String   @unique @map("token")
  expires    DateTime @map("expires")

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// PBAC - ROLES & PERMISSIONS
// =============================================================================

model Role {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  displayName String   @map("display_name")
  description String?  @map("description")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  employeeRoles   EmployeeRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @map("id")
  scope       String   @unique @map("scope")
  module      String   @map("module")
  action      String   @map("action")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  id         String  @id @default(uuid()) @map("id")
  employeeId String  @map("employee_id")
  roleId     String  @map("role_id")
  scopeType  String? @map("scope_type")
  scopeId    String? @map("scope_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([employeeId, roleId, scopeType, scopeId])
  @@map("employee_roles")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @map("id")
  actorId    String?  @map("actor_id")
  action     String   @map("action")
  module     String   @map("module")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?    @map("changes")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([module])
  @@index([createdAt])
  // Composite: filter by module/actor AND sort by createdAt in one index scan.
  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// DEPARTMENT & DESIGNATION
// =============================================================================

model Department {
  id               String   @id @default(uuid()) @map("id")
  name             String   @unique @map("name")
  code             String   @unique @map("code")
  description      String?  @map("description")
  headId           String?  @map("head_id")
  parentId         String?  @map("parent_id")
  isActive         Boolean  @default(true) @map("is_active")
  careersTone      String?  @map("careers_tone")
  careersJobsLabel String?  @map("careers_jobs_label")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  head        Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")
  employees   Employee[]
  jobPostings JobPosting[]
  jobRoles    JobRole[]

  @@map("departments")
}

model Designation {
  id               String   @id @default(uuid()) @map("id")
  title            String   @unique @map("title")
  level            Int      @map("level") // 1-13 (L1-L13)
  code             String?  @map("code") // "L1", "L2", … "L13" (multiple titles can share a code, e.g. CCO + CHRO both L11)
  phase            String?  @map("phase") // FOUNDATION | ELEVATE | PINNACLE
  maxMonthlySalary Float?   @map("max_monthly_salary") // null for L10+ (no cap)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("designations")
}

// Specific job role within a department (e.g. Web Development -> "Full Stack
// Developer"). Distinct from Designation (the L1-L13 grade) and Department (the
// team). Employees reference one optionally.
model JobRole {
  id           String   @id @default(uuid()) @map("id")
  name         String   @map("name")
  departmentId String   @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("job_roles")
}

// =============================================================================
// EMPLOYEE (also serves as Auth User)
// =============================================================================

model Employee {
  id         String  @id @default(uuid()) @map("id")
  employeeNo String  @unique @map("employee_no")
  deviceId   String? @map("device_id")

  // Identity
  firstName     String  @map("first_name")
  lastName      String  @map("last_name")
  email         String  @unique @map("email")
  personalEmail String? @unique @map("personal_email")
  phone         String? @map("phone")
  personalPhone String? @map("personal_phone")

  // Personal info
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          Gender?   @map("gender")
  nationality     String?   @map("nationality")
  bloodGroup      String?   @map("blood_group")
  // profilePhoto holds the displayable URL (a stable /api serve route for B2 photos,
  // or a legacy Supabase URL). profilePhotoKey is the B2 object key, kept so the old
  // file can be deleted when the photo changes or is removed.
  profilePhoto    String?   @map("profile_photo")
  profilePhotoKey String?   @map("profile_photo_key")

  // Addresses & emergency contact (JSON)
  currentAddress   Json? @map("current_address")
  permanentAddress Json? @map("permanent_address")
  emergencyContact Json? @map("emergency_contact")

  // Employment
  departmentId     String?        @map("department_id")
  designationId    String?        @map("designation_id")
  jobRoleId        String?        @map("job_role_id")
  managerId        String?        @map("manager_id")
  dottedManagerId  String?        @map("dotted_manager_id")
  employmentType   EmploymentType @default(FULL_TIME) @map("employment_type")
  status           EmployeeStatus @default(ACTIVE) @map("status")
  dateOfJoining    DateTime?      @map("date_of_joining") @db.Date
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  confirmationDate DateTime?      @map("confirmation_date") @db.Date
  // Probation: effective status = onProbation AND today < (dateOfJoining + probationMonths).
  // Admin toggles onProbation off to confirm early; probationMonths is 3 or 6.
  onProbation      Boolean        @default(true) @map("on_probation")
  probationMonths  Int            @default(6) @map("probation_months")
  workLocation     String?        @map("work_location")
  resignationDate  DateTime?      @map("resignation_date") @db.Date
  lastWorkingDate  DateTime?      @map("last_working_date") @db.Date

  // Auth fields
  passwordHash       String?   @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  emailVerified      DateTime? @map("email_verified")
  // When true, the employee is forced to the /change-password page on every
  // request until they set a new password (e.g. after an HR-issued password).
  mustChangePassword Boolean   @default(false) @map("must_change_password")

  // Outbound email: encrypted Gmail App Password (AES-256-GCM, format: iv:tag:ct).
  // Used by sendEmailAs() to send mail from this employee's @digitallynext.com address.
  // Never return in API responses - strip in every GET handler.
  gmailAppPassword String? @map("gmail_app_password")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  jobRole            JobRole?     @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  manager            Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       Employee[]   @relation("EmployeeManager")
  dottedManager      Employee?    @relation("EmployeeDottedManager", fields: [dottedManagerId], references: [id], onDelete: SetNull)
  dottedSubordinates Employee[]   @relation("EmployeeDottedManager")
  departmentsHeaded  Department[] @relation("DepartmentHead")

  // Next-Auth
  accounts Account[]
  sessions Session[]

  // PBAC
  employeeRoles EmployeeRole[]

  // Audit
  auditLogs AuditLog[]

  // Documents
  documents         Document[]         @relation("EmployeeDocuments")
  employeeDocuments EmployeeDocument[] @relation("EmployeePersonalDocuments")
  docRequests       DocumentRequest[]  @relation("DocRequestEmployee")
  docRequestsMade   DocumentRequest[]  @relation("DocRequestRequester")

  // Notifications
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  // Attendance
  attendanceLogs          AttendanceLog[]
  regularizations         AttendanceRegularization[] @relation("RegularizationEmployee")
  regularizationsReviewed AttendanceRegularization[] @relation("RegularizationReviewer")

  // Leave
  leaveRequests         LeaveRequest[] @relation("LeaveRequests")
  leaveApprovals        LeaveRequest[] @relation("LeaveApprovals")
  leaveCurrentApprovals LeaveRequest[] @relation("LeaveCurrentApprovals")
  leaveBalances         LeaveBalance[]

  // Payroll
  salaryStructure SalaryStructure?
  payrollRecords  PayrollRecord[]

  // Projects
  projectMemberships ProjectMember[]
  assignedTasks      ProjectTask[]          @relation("TaskAssignee")
  raisedRequirements ProjectRequirement[]   @relation("RequirementRaiser")
  ownedRequirements  ProjectRequirement[]   @relation("RequirementOwner")
  createdTasks       ProjectTask[]          @relation("TaskCreator")
  taskStatusChanges  TaskStatusPeriod[]     @relation("TaskStatusActor")
  contentEntries     ContentCalendarEntry[] @relation("ContentAssignee")
  timesheets         Timesheet[]
  ownedProjects      Project[]              @relation("ProjectOwner")
  brandAssets        BrandAsset[]           @relation("BrandAssetUploader")

  // Performance
  perfKpis             PerfKpi[]    @relation("EmployeePerfKpis")
  evaluations          Evaluation[] @relation("EvaluationEmployee")
  evaluationsToRate    Evaluation[] @relation("EvaluationManager")
  evaluationsToControl Evaluation[] @relation("EvaluationController")

  // Recruitment
  jobPostings JobPosting[] @relation("PostingCreator")
  interviews  Interview[]  @relation("Interviewer")

  // Password reset
  passwordResets PasswordReset[]

  // ── Task edit override ──────────────────────────────────────────────────────
  // Normally the person who raised a task may correct it for 15 minutes and no
  // longer (see lib/edit-window.ts) - after that only the manager can. That is
  // right for a commitment other people plan around, and wrong when somebody
  // needs to write up a day they forgot to fill in, or fix last week's sheet.
  // HR/admin can lift the window for one person from their profile.
  canEditPastTasks          Boolean    @default(false) @map("can_edit_past_tasks")
  /// Who granted it and when - a standing bypass of a control has to be
  /// attributable, or nobody can answer "why can this person rewrite history".
  pastTaskAccessGrantedAt   DateTime?  @map("past_task_access_granted_at")
  pastTaskAccessGrantedById String?    @map("past_task_access_granted_by_id")
  pastTaskAccessGrantedBy   Employee?  @relation("PastTaskAccessGranter", fields: [pastTaskAccessGrantedById], references: [id], onDelete: SetNull)
  pastTaskAccessGrants      Employee[] @relation("PastTaskAccessGranter")

  // Notifications
  taskReminderPreference TaskReminderPreference?

  // Referrals - people this employee sent us, and the hire they became.
  referralsMade      CareerApplication[] @relation("ReferralReferrer")
  referredHireRecord CareerApplication[] @relation("ReferralHire")

  // Work From Home
  wfhRequests         WfhRequest[] @relation("WfhRequester")
  wfhManagerApprovals WfhRequest[] @relation("WfhManagerApprover")
  wfhHrApprovals      WfhRequest[] @relation("WfhHrApprover")

  // Floating holiday selections
  floatingHolidays FloatingHolidaySelection[]

  // Resignation (self-service, manager/HR approved)
  resignations         Resignation[] @relation("ResignationEmployee")
  resignationsReviewed Resignation[] @relation("ResignationReviewer")

  // V2 Project Management
  managedTeams           ProjectTeam[]          @relation("TeamManager")
  projectTeamMemberships ProjectTeamMember[]    @relation("ProjectTeamMembership")
  uploadedResources      ProjectResource[]      @relation("ResourceUploader")
  taskComments           TaskComment[]          @relation("CommentAuthor")
  projectActivities      ProjectActivity[]      @relation("ActivityActor")
  projectMessages        ProjectMessage[]       @relation("MessageAuthor")
  messageReplies         ProjectMessageReply[]  @relation("MessageReplyAuthor")
  messageReads           ProjectMessageRead[]
  createdPasswords       ProjectPasswordEntry[] @relation("PasswordCreator")

  // Client portal administration
  createdClientUsers  ClientUser[]          @relation("ClientUserCreator")
  grantedClientAccess ClientProjectAccess[] @relation("ClientAccessGranter")

  // Project mailer
  projectTemplates ProjectEmailTemplate[] @relation("ProjectTemplateAuthor")
  mailerAssets     ProjectMailerAsset[]   @relation("MailerAssetAuthor")
  campaigns        ProjectCampaign[]      @relation("CampaignAuthor")

  // Monitoring
  ownedAssets           ProjectAsset[]   @relation("AssetOwner")
  ownedMonitors         UptimeMonitor[]  @relation("MonitorOwner")
  acknowledgedIncidents UptimeIncident[] @relation("IncidentAcknowledger")

  // Employee had NO indexes at all. These serve the manager/team queues and the
  // status filters used by the directory, dashboard and accrual jobs.
  @@index([managerId])
  @@index([status, isActive])
  @@map("employees")
}

// =============================================================================
// DOCUMENT
// =============================================================================

model Document {
  id           String           @id @default(uuid()) @map("id")
  title        String           @map("title")
  description  String?          @map("description")
  category     DocumentCategory @default(OTHER) @map("category")
  fileName     String           @map("file_name")
  fileSize     Int              @map("file_size")
  mimeType     String           @map("mime_type")
  objectKey    String           @map("object_key")
  version      Int              @default(1) @map("version")
  employeeId   String?          @map("employee_id")
  uploadedById String           @map("uploaded_by_id")
  isCompanyDoc Boolean          @default(false) @map("is_company_doc")
  expiresAt    DateTime?        @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  employee Employee? @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([category])
  @@index([isCompanyDoc])
  @@map("documents")
}

// Dedicated table for personal employee documents (identity, academic, etc.)
// captured during onboarding and over the lifecycle. Kept separate from the
// general `Document` model so company-wide files and personal files don't mix.
model EmployeeDocument {
  id           String           @id @default(uuid()) @map("id")
  employeeId   String           @map("employee_id")
  title        String           @map("title")
  category     DocumentCategory @default(OTHER) @map("category")
  fileName     String           @map("file_name")
  fileSize     Int              @map("file_size")
  mimeType     String           @map("mime_type")
  objectKey    String           @map("object_key")
  uploadedById String           @map("uploaded_by_id")
  expiresAt    DateTime?        @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  employee Employee @relation("EmployeePersonalDocuments", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([category])
  @@map("employee_documents")
}

// HR asks an employee to upload a specific document; fulfilled when they upload.
model DocumentRequest {
  id            String           @id @default(uuid()) @map("id")
  employeeId    String           @map("employee_id")
  requestedById String           @map("requested_by_id")
  title         String           @map("title")
  category      DocumentCategory @default(OTHER) @map("category")
  note          String?          @map("note")
  dueDate       DateTime?        @map("due_date") @db.Date
  status        String           @default("PENDING") @map("status") // PENDING | FULFILLED | CANCELLED
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  employee    Employee @relation("DocRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy Employee @relation("DocRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("document_requests")
}

// =============================================================================
// EMAIL TEMPLATES & LOGS
// =============================================================================

model EmailTemplate {
  id          String   @id @default(uuid()) @map("id")
  slug        String   @unique @map("slug")
  name        String   @map("name")
  subject     String   @map("subject")
  bodyHtml    String   @map("body_html") @db.Text
  bodyText    String?  @map("body_text") @db.Text
  mergeFields String[] @map("merge_fields")
  isActive    Boolean  @default(true) @map("is_active")
  trigger     String?  @map("trigger")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  emailLogs EmailLog[]

  @@map("email_templates")
}

model EmailLog {
  id             String    @id @default(uuid()) @map("id")
  templateId     String?   @map("template_id")
  recipientEmail String    @map("recipient_email")
  subject        String    @map("subject")
  status         String    @default("queued") @map("status")
  error          String?   @map("error")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

// =============================================================================
// NOTIFICATION
// =============================================================================

model Notification {
  id         String    @id @default(uuid()) @map("id")
  employeeId String    @map("employee_id")
  title      String    @map("title")
  message    String    @map("message")
  type       String    @map("type")
  link       String?   @map("link")
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isRead])
  @@index([createdAt])
  // Serves the inbox: where employeeId + orderBy createdAt desc. The
  // ([employeeId, isRead]) index above cannot satisfy that sort.
  @@index([employeeId, createdAt])
  @@map("notifications")
}

/// A browser Web Push subscription. One row per browser/device an employee has
/// granted notification permission on, so alerts reach them even when no DNMS
/// tab is open (SSE only works while a page is live).
model PushSubscription {
  id         String   @id @default(uuid()) @map("id")
  employeeId String   @map("employee_id")
  endpoint   String   @unique @map("endpoint")
  p256dh     String   @map("p256dh")
  auth       String   @map("auth")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("push_subscriptions")
}

/// How an employee wants to be warned that the time budgeted for a running task
/// is about to run out. One row per employee; a missing row means the defaults
/// in features/notifications/constants.ts, so nobody has to opt in to be warned.
model TaskReminderPreference {
  id         String  @id @default(uuid()) @map("id")
  employeeId String  @unique @map("employee_id")
  enabled    Boolean @default(true) @map("enabled")

  /// Minutes before the estimate runs out that the FIRST reminder fires.
  /// 15 = "a task booked for an hour warns me at the 45-minute mark".
  leadMinutes Int @default(15) @map("lead_minutes")

  /// How many reminders a single run of a task may produce, the first one
  /// included. 1 = warn once and stay quiet.
  reminderCount Int @default(1) @map("reminder_count")

  /// Gap between consecutive reminders. With lead 15 / count 3 / every 5 the
  /// warnings land 15, 10 and 5 minutes out; a gap that overshoots the deadline
  /// simply reads as "over the estimate by N minutes".
  repeatEveryMinutes Int @default(5) @map("repeat_every_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("task_reminder_preferences")
}

/// What has already been sent for ONE run of a task, where a run is a single
/// uninterrupted IN_PROGRESS stretch (identified by the task's inProgressSince).
/// Pausing and restarting a task therefore earns a fresh set of reminders, and a
/// cron that runs twice - or catches up after an outage - cannot re-send one.
model TaskReminderState {
  id           String    @id @default(uuid()) @map("id")
  taskId       String    @map("task_id")
  runStartedAt DateTime  @map("run_started_at")
  sentCount    Int       @default(0) @map("sent_count")
  lastSentAt   DateTime? @map("last_sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, runStartedAt])
  @@index([createdAt])
  @@map("task_reminder_states")
}

// =============================================================================
// ATTENDANCE (M3)
// =============================================================================

model HikvisionDevice {
  id           String    @id @default(uuid()) @map("id")
  name         String    @map("name")
  deviceSerial String    @unique @map("device_serial")
  ipAddress    String    @map("ip_address")
  port         Int       @default(8000) @map("port")
  username     String    @default("admin") @map("username")
  password     String    @map("password")
  location     String?   @map("location")
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  attendanceLogs AttendanceLog[]

  @@map("hikvision_devices")
}

model AttendanceLog {
  id             String           @id @default(uuid()) @map("id")
  employeeId     String           @map("employee_id")
  deviceId       String?          @map("device_id")
  date           DateTime         @map("date") @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  workHours      Float?           @map("work_hours")
  status         AttendanceStatus @default(PRESENT) @map("status")
  // `isManual` = "this row carries at least one HR correction" (drives the Manual
  // badge / export / delete-guard). The three flags below are PER-FIELD locks: only
  // the value HR actually changed is pinned; every other field keeps syncing from
  // the device. (A row-level lock froze the whole day, so fixing a check-in also
  // froze that day's check-out.)
  isManual       Boolean          @default(false) @map("is_manual")
  checkInManual  Boolean          @default(false) @map("check_in_manual")
  checkOutManual Boolean          @default(false) @map("check_out_manual")
  statusManual   Boolean          @default(false) @map("status_manual")
  source         String?          @map("source")
  notes          String?          @map("notes")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   HikvisionDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
  @@map("attendance_logs")
}

// Employee-submitted correction of a missed/wrong punch, approved by HR/manager.
model AttendanceRegularization {
  id                String      @id @default(uuid()) @map("id")
  employeeId        String      @map("employee_id")
  date              DateTime    @map("date") @db.Date
  requestedCheckIn  DateTime?   @map("requested_check_in")
  requestedCheckOut DateTime?   @map("requested_check_out")
  reason            String      @map("reason")
  status            LeaveStatus @default(PENDING) @map("status")
  reviewerId        String?     @map("reviewer_id")
  reviewNote        String?     @map("review_note")
  reviewedAt        DateTime?   @map("reviewed_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  employee Employee  @relation("RegularizationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee? @relation("RegularizationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@map("attendance_regularizations")
}

model Holiday {
  id          String   @id @default(uuid()) @map("id")
  name        String   @map("name")
  date        DateTime @map("date") @db.Date
  description String?  @map("description")
  isOptional  Boolean  @default(false) @map("is_optional") // true = floating holiday
  createdAt   DateTime @default(now()) @map("created_at")

  floatingSelections FloatingHolidaySelection[]

  @@unique([date, name])
  @@map("holidays")
}

// =============================================================================
// WORK FROM HOME (WFH)
// =============================================================================

model WfhRequest {
  id                String      @id @default(uuid()) @map("id")
  employeeId        String      @map("employee_id")
  date              DateTime    @map("date") @db.Date // single day WFH
  reason            String?     @map("reason")
  status            LeaveStatus @default(PENDING) @map("status")
  isEmergency       Boolean     @default(false) @map("is_emergency") // tier 1/2 emergency override
  // The reporting manager's advisory call ("APPROVED" | "REJECTED"); HR makes the
  // final decision and can override it (mirrors leave / floating-holiday requests).
  managerDecision   String?     @map("manager_decision")
  managerApproverId String?     @map("manager_approver_id")
  managerApprovedAt DateTime?   @map("manager_approved_at")
  hrApproverId      String?     @map("hr_approver_id")
  hrApprovedAt      DateTime?   @map("hr_approved_at")
  rejectionReason   String?     @map("rejection_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  employee        Employee  @relation("WfhRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  managerApprover Employee? @relation("WfhManagerApprover", fields: [managerApproverId], references: [id], onDelete: SetNull)
  hrApprover      Employee? @relation("WfhHrApprover", fields: [hrApproverId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@map("wfh_requests")
}

// =============================================================================
// RESIGNATION (self-service, manager/HR approved)
// An employee submits a resignation; it stays PENDING until their direct
// manager (or HR) approves. On approval the employee is set to RESIGNED and
// deactivated (isActive=false), which blocks any further login.
// =============================================================================

// =============================================================================
// APP SETTING - admin-editable runtime config (SMTP, HR inbox, branding…).
// Key/value; secret values (e.g. SMTP passwords) are stored encrypted.
// =============================================================================
model AppSetting {
  key       String   @id @map("key")
  value     String?  @map("value")
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Resignation {
  id                       String      @id @default(uuid()) @map("id")
  employeeId               String      @map("employee_id")
  reason                   String?     @map("reason")
  requestedLastWorkingDate DateTime?   @map("requested_last_working_date") @db.Date
  status                   LeaveStatus @default(PENDING) @map("status")
  reviewerId               String?     @map("reviewer_id")
  reviewNote               String?     @map("review_note")
  reviewedAt               DateTime?   @map("reviewed_at")
  // Message-ID of the resignation email sent to HR, so the approve/decline
  // email can reply on the same Gmail thread.
  requestEmailMessageId    String?     @map("request_email_message_id")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  employee Employee  @relation("ResignationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee? @relation("ResignationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@map("resignations")
}

// =============================================================================
// FLOATING HOLIDAY SELECTION
// Employees pick any 3 of the 12 floating holidays each year.
// =============================================================================

model FloatingHolidaySelection {
  id                String      @id @default(uuid()) @map("id")
  employeeId        String      @map("employee_id")
  holidayId         String      @map("holiday_id")
  year              Int         @map("year")
  status            LeaveStatus @default(PENDING) @map("status")
  reason            String?     @map("reason")
  // Approval routing: manager review is the first step (recorded but NOT final -
  // HR can still approve a manager-rejected request); HR approval is the last call.
  managerDecision   String?     @map("manager_decision") // "APPROVED" | "REJECTED"
  managerApproverId String?     @map("manager_approver_id")
  managerApprovedAt DateTime?   @map("manager_approved_at")
  hrApproverId      String?     @map("hr_approver_id")
  hrApprovedAt      DateTime?   @map("hr_approved_at")
  rejectionReason   String?     @map("rejection_reason")
  reviewedAt        DateTime?   @map("reviewed_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  holiday  Holiday  @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([employeeId, holidayId, year])
  @@index([employeeId, year])
  @@index([status])
  @@map("floating_holiday_selections")
}

model AttendancePolicy {
  id              String   @id @default(uuid()) @map("id")
  name            String   @unique @map("name")
  workHoursPerDay Float    @default(8) @map("work_hours_per_day")
  workDaysPerWeek Int      @default(5) @map("work_days_per_week")
  checkInTime     String   @default("09:00") @map("check_in_time")
  checkOutTime    String   @default("18:00") @map("check_out_time")
  lateGraceMins   Int      @default(15) @map("late_grace_mins")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("attendance_policies")
}

// =============================================================================
// LEAVE MANAGEMENT (M4)
// =============================================================================

model LeaveType {
  id               String        @id @default(uuid()) @map("id")
  name             String        @unique @map("name")
  code             String        @unique @map("code")
  description      String?       @map("description")
  isPaid           Boolean       @default(true) @map("is_paid")
  maxDaysPerYear   Int           @default(0) @map("max_days_per_year")
  carryForward     Boolean       @default(false) @map("carry_forward")
  maxCarryDays     Int           @default(0) @map("max_carry_days")
  requiresApproval Boolean       @default(true) @map("requires_approval")
  accrualMethod    AccrualMethod @default(UPFRONT) @map("accrual_method")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  leavePolicies LeavePolicy[]

  @@map("leave_types")
}

// Entitlement matrix: how many days of a leave type each employment type gets
// per year. Falls back to LeaveType.maxDaysPerYear when no row exists.
model LeavePolicy {
  id             String         @id @default(uuid()) @map("id")
  employmentType EmploymentType @map("employment_type")
  leaveTypeId    String         @map("leave_type_id")
  daysPerYear    Float          @default(0) @map("days_per_year")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employmentType, leaveTypeId])
  @@map("leave_policies")
}

model LeaveBalance {
  id          String @id @default(uuid()) @map("id")
  employeeId  String @map("employee_id")
  leaveTypeId String @map("leave_type_id")
  year        Int    @map("year")
  allocated   Float  @default(0) @map("allocated")
  accrued     Float  @default(0) @map("accrued")
  used        Float  @default(0) @map("used")
  pending     Float  @default(0) @map("pending")
  carried     Float  @default(0) @map("carried")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                   String              @id @default(uuid()) @map("id")
  employeeId           String              @map("employee_id")
  leaveTypeId          String              @map("leave_type_id")
  startDate            DateTime            @map("start_date") @db.Date
  endDate              DateTime            @map("end_date") @db.Date
  totalDays            Float               @map("total_days")
  reason               String?             @map("reason")
  status               LeaveStatus         @default(PENDING) @map("status")
  approverId           String?             @map("approver_id")
  approvedAt           DateTime?           @map("approved_at")
  rejectionReason      String?             @map("rejection_reason")
  // The reporting manager's advisory call ("APPROVED" | "REJECTED"); HR makes
  // the final decision and can override it (mirrors floating-holiday requests).
  managerDecision      String?             @map("manager_decision")
  lateNoticePenalty    Boolean             @default(false) @map("late_notice_penalty")
  // Routing: which tier currently owns this request and, for a MANAGER-stage
  // request, the specific manager who must act. Null currentApproverId means a
  // role queue (any HR / any Admin, per approvalStage).
  approvalStage        LeaveApprovalStage? @map("approval_stage")
  currentApproverId    String?             @map("current_approver_id")
  // The application email's Message-ID + subject, captured when the request
  // letter is sent, so the approve/reject reply threads onto the same email
  // conversation (Gmail).
  requestMailMessageId String?             @map("request_mail_message_id")
  requestMailSubject   String?             @map("request_mail_subject")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  employee        Employee  @relation("LeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver        Employee? @relation("LeaveApprovals", fields: [approverId], references: [id], onDelete: SetNull)
  currentApprover Employee? @relation("LeaveCurrentApprovals", fields: [currentApproverId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([currentApproverId])
  @@index([approvalStage, status])
  @@map("leave_requests")
}

// =============================================================================
// PAYROLL (M5)
// =============================================================================

model SalaryStructure {
  id                 String   @id @default(uuid()) @map("id")
  employeeId         String   @unique @map("employee_id")
  basicSalary        Float    @map("basic_salary")
  hra                Float    @default(0) @map("hra")
  conveyance         Float    @default(0) @map("conveyance")
  medicalAllowance   Float    @default(0) @map("medical_allowance")
  telephoneAllowance Float    @default(0) @map("telephone_allowance")
  otherAllowances    Float    @default(0) @map("other_allowances")
  pfEmployee         Float    @default(0) @map("pf_employee")
  pfEmployer         Float    @default(0) @map("pf_employer")
  esi                Float    @default(0) @map("esi")
  tds                Float    @default(0) @map("tds")
  effectiveFrom      DateTime @map("effective_from") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRecords PayrollRecord[]

  @@map("salary_structures")
}

model PayrollRecord {
  id                String  @id @default(uuid()) @map("id")
  employeeId        String  @map("employee_id")
  salaryStructureId String? @map("salary_structure_id")
  month             Int     @map("month")
  year              Int     @map("year")
  workingDays       Int     @map("working_days")
  presentDays       Float   @map("present_days")
  leaveDays         Float   @default(0) @map("leave_days")
  lopDays           Float   @default(0) @map("lop_days")

  // Earnings
  basicSalary        Float @map("basic_salary")
  hra                Float @default(0) @map("hra")
  conveyance         Float @default(0) @map("conveyance")
  medicalAllowance   Float @default(0) @map("medical_allowance")
  telephoneAllowance Float @default(0) @map("telephone_allowance")
  otherAllowances    Float @default(0) @map("other_allowances")
  overtime           Float @default(0) @map("overtime")
  grossSalary        Float @map("gross_salary")

  // Deductions
  pfEmployee      Float @default(0) @map("pf_employee")
  pfEmployer      Float @default(0) @map("pf_employer")
  esi             Float @default(0) @map("esi")
  tds             Float @default(0) @map("tds")
  otherDeductions Float @default(0) @map("other_deductions")
  totalDeductions Float @map("total_deductions")

  netSalary    Float         @map("net_salary")
  status       PayrollStatus @default(DRAFT) @map("status")
  processedAt  DateTime?     @map("processed_at")
  approvedById String?       @map("approved_by_id")
  paidAt       DateTime?     @map("paid_at")
  notes        String?       @map("notes")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)

  @@unique([employeeId, month, year])
  @@index([month, year])
  @@index([status])
  @@map("payroll_records")
}

// =============================================================================
// PROJECTS & TASKS (M9)
// =============================================================================

model Project {
  id             String        @id @default(uuid()) @map("id")
  name           String        @map("name")
  description    String?       @map("description") @db.Text
  code           String        @unique @map("code")
  // URL identifier, derived from the name at creation ("RUDIONE / LEOCYM" ->
  // "rudione-leocym"). Nullable so pre-existing rows stay valid; every read path
  // falls back to the id, and /projects/[id] resolves either form. Deliberately
  // NOT regenerated on rename - a slug that moves breaks every link already shared.
  slug           String?       @unique @map("slug")
  status         ProjectStatus @default(PLANNING) @map("status")
  priority       TaskPriority  @default(MEDIUM) @map("priority")
  /// Stable serve URL (/api/projects/<id>/logo?v=<ts>), NOT a bucket URL - the
  /// bucket is private, so the route redirects to a short-lived signed URL. The
  /// ?v= changes on every upload so cached <img>s refresh.
  logo           String?       @map("logo")
  /// The B2 object key behind `logo`. Null for a project with no logo.
  logoKey        String?       @map("logo_key")
  ownerId        String        @map("owner_id")
  // DEPRECATED: the phase feature was removed from the app; this column is kept
  // only so the shared DB stays compatible with the currently-deployed build.
  // Safe to drop once the phase-removal code is deployed everywhere.
  currentPhaseId String?       @map("current_phase_id")
  startDate      DateTime?     @map("start_date") @db.Date // "Onboarding Date" in UI
  endDate        DateTime?     @map("end_date") @db.Date // deprecated - kept for back-compat
  budget         Float?        @map("budget")
  isArchived     Boolean       @default(false) @map("is_archived")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  owner           Employee               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  currentPhase    ProjectPhase?          @relation(fields: [currentPhaseId], references: [id], onDelete: SetNull)
  members         ProjectMember[] // legacy - kept for migration safety
  teams           ProjectTeam[] // v2 - primary structure
  tasks           ProjectTask[]
  resources       ProjectResource[]
  timesheets      Timesheet[]
  activities      ProjectActivity[]
  messages        ProjectMessage[]
  messageReads    ProjectMessageRead[]
  passwordEntries ProjectPasswordEntry[]
  brand           ProjectBrand?
  brandAssets     BrandAsset[]
  contentCalendar ContentCalendarEntry[]
  integration     ProjectIntegration?
  metaCampaigns   MetaCampaign[]
  seoProperties   SeoProperty[]
  requirements    ProjectRequirement[]

  // Client portal + marketplace
  // Mailer
  mailers        ProjectMailer[]
  emailTemplates ProjectEmailTemplate[]
  recipients     ProjectRecipient[]
  campaigns      ProjectCampaign[]

  // Monitoring
  assets         ProjectAsset[]
  uptimeMonitors UptimeMonitor[]

  clientAccess        ClientProjectAccess[]
  clientActivity      ClientActivityLog[]
  marketplaceChannels MarketplaceChannel[]
  products            Product[]
  projectMailerAssets ProjectMailerAsset[]

  @@index([status])
  @@index([ownerId])
  @@map("projects")
}

// Per-project ad-platform connection (currently Meta Ads). Secrets are stored
// ENCRYPTED (lib/crypto) - the app decrypts them server-side only to call the API.
model ProjectIntegration {
  id              String    @id @default(uuid())
  projectId       String    @unique @map("project_id")
  provider        String    @default("META") @map("provider")
  metaAppId       String?   @map("meta_app_id")
  metaAppSecret   String?   @map("meta_app_secret") // encrypted
  metaAccessToken String?   @map("meta_access_token") @db.Text // encrypted
  metaAdAccountId String?   @map("meta_ad_account_id")
  status          String    @default("pending") @map("status") // "connected" | "pending"
  lastSyncedAt    DateTime? @map("last_synced_at")
  lastSyncError   String?   @map("last_sync_error") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_integrations")
}

// A Meta ad campaign synced for a project.
model MetaCampaign {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  campaignId String   @map("campaign_id") // Meta's campaign id
  name       String   @map("name")
  status     String   @map("status")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metrics MetaCampaignMetric[]

  @@unique([projectId, campaignId])
  @@index([projectId])
  @@map("meta_campaigns")
}

// One row per campaign per day (Meta insights, time_increment=1).
model MetaCampaignMetric {
  id                String   @id @default(uuid())
  campaignId        String   @map("campaign_id") // FK -> MetaCampaign.id
  date              DateTime @map("date") @db.Date
  spend             Decimal  @default(0) @map("spend") @db.Decimal(14, 2)
  impressions       BigInt   @default(0) @map("impressions")
  clicks            BigInt   @default(0) @map("clicks")
  ctr               Decimal  @default(0) @map("ctr") @db.Decimal(8, 4)
  cpc               Decimal  @default(0) @map("cpc") @db.Decimal(10, 2)
  cpm               Decimal  @default(0) @map("cpm") @db.Decimal(10, 2)
  reach             BigInt   @default(0) @map("reach")
  conversions       Int      @default(0) @map("conversions")
  costPerConversion Decimal  @default(0) @map("cost_per_conversion") @db.Decimal(10, 2)
  purchases         Int      @default(0) @map("purchases")
  purchaseValue     Decimal  @default(0) @map("purchase_value") @db.Decimal(14, 2)
  roas              Decimal  @default(0) @map("roas") @db.Decimal(10, 2)
  addToCart         Int      @default(0) @map("add_to_cart")
  landingPageViews  Int      @default(0) @map("landing_page_views")
  currency          String   @default("INR") @map("currency")
  createdAt         DateTime @default(now()) @map("created_at")

  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
  @@map("meta_campaign_metrics")
}

// DEPRECATED (kept for deploy-compat, see Project.currentPhaseId).
model ProjectPhase {
  id           String   @id @default(uuid()) @map("id")
  name         String   @map("name")
  description  String?  @map("description")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  parentId     String?  @map("parent_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent   ProjectPhase?  @relation("PhaseParent", fields: [parentId], references: [id], onDelete: SetNull)
  children ProjectPhase[] @relation("PhaseParent")
  projects Project[]

  @@map("project_phases")
}

// ─── Brand / Strategy workspace (per project) ─────────────────────────────────
// Holds the brand strategy for a project: brief, digital objectives, the
// manifestation plan (4 themes), overview doc, and brand guidelines. The JSON
// columns store the semi-structured parts (see features/projects/brand.ts).
model ProjectBrand {
  id            String   @id @default(uuid()) @map("id")
  projectId     String   @unique @map("project_id")
  brief         String?  @map("brief") @db.Text // brand brief (from client)
  overview      String?  @map("overview") @db.Text // brand overview / research doc
  objectives    Json?    @map("objectives") // digital objective targets
  manifestation Json?    @map("manifestation") // the 4 manifestation themes
  guidelines    Json?    @map("guidelines") // colors, fonts, logos notes, ui/ux
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_brands")
}

// Uploaded brand files (brief document, logo images) stored in B2.
