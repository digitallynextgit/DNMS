// A reply in a message thread - lets a single message hold an ongoing conversation.
model ProjectMessageReply {
  id           String   @id @default(uuid()) @map("id")
  messageId    String   @map("message_id")
  authorId     String   @map("author_id")
  content      String   @map("content") @db.Text
  mentionedIds String[] @default([]) @map("mentioned_ids")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  message ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  Employee       @relation("MessageReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("project_message_replies")
}

// Per-user "last time I opened this project's Messages tab" - powers the unread badge.
model ProjectMessageRead {
  id         String   @id @default(uuid()) @map("id")
  projectId  String   @map("project_id")
  employeeId String   @map("employee_id")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@map("project_message_reads")
}

model ProjectPasswordEntry {
  id          String   @id @default(uuid()) @map("id")
  projectId   String   @map("project_id")
  label       String   @map("label")
  username    String?  @map("username")
  encPassword String   @map("enc_password") @db.Text
  url         String?  @map("url")
  notes       String?  @map("notes") @db.Text
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy Employee @relation("PasswordCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_password_entries")
