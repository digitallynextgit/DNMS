model LeaveRequest {
  tenantId             String              @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id                   String              @id @default(uuid()) @map("id")
  employeeId           String              @map("employee_id")
  leaveTypeId          String              @map("leave_type_id")
  startDate            DateTime            @map("start_date") @db.Date
  endDate              DateTime            @map("end_date") @db.Date
  totalDays            Float               @map("total_days")
  reason               String?             @map("reason")
  status               LeaveStatus         @default(PENDING) @map("status")
  approverId           String?             @map("approver_id")
  approvedAt           DateTime?           @map("approved_at")
  rejectionReason      String?             @map("rejection_reason")
  // The manager's advisory call ("APPROVED" | "REJECTED"); HR makes the final decision.
  managerDecision      String?             @map("manager_decision")
  lateNoticePenalty    Boolean             @default(false) @map("late_notice_penalty")
  // Which tier owns the request now. currentApproverId = the manager at MANAGER stage; null = a role queue.
  approvalStage        LeaveApprovalStage? @map("approval_stage")
  currentApproverId    String?             @map("current_approver_id")
  // Message-ID + subject of the application email, so the approve/reject reply threads onto it in Gmail.
  requestMailMessageId String?             @map("request_mail_message_id")
  requestMailSubject   String?             @map("request_mail_subject")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  employee        Employee  @relation("LeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver        Employee? @relation("LeaveApprovals", fields: [approverId], references: [id], onDelete: SetNull)
  currentApprover Employee? @relation("LeaveCurrentApprovals", fields: [currentApproverId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([currentApproverId])
  @@index([approvalStage, status])
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("leave_requests")
}

