model Project {
  tenantId       String        @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id             String        @id @default(uuid()) @map("id")
  name           String        @map("name")
  description    String?       @map("description") @db.Text
  code           String        @map("code")
  // URL slug from the name at creation; null on old rows (reads fall back to id). Never regenerated on
  // rename, so shared links keep working.
  slug           String?       @map("slug")
  status         ProjectStatus @default(PLANNING) @map("status")
  priority       TaskPriority  @default(MEDIUM) @map("priority")
  /// The brand lifecycle "Phase" shown in the UI. Not `currentPhase` (unused legacy relation). Null = not set.
  stage          ProjectStage? @map("stage")
  /// Stable serve URL (/api/projects/<id>/logo?v=<ts>) that redirects to a signed URL; ?v= busts the cache.
  logo           String?       @map("logo")
  /// B2 object key behind `logo`.
  logoKey        String?       @map("logo_key")
  ownerId        String        @map("owner_id")
  /// The company this is delivered for. Null = an internal project.
  clientId       String?       @map("client_id")
  // DEPRECATED: the phase feature is gone; kept so the shared DB stays compatible with the deployed build.
  currentPhaseId String?       @map("current_phase_id")
  startDate      DateTime?     @map("start_date") @db.Date // "Onboarding Date" in UI
  endDate        DateTime?     @map("end_date") @db.Date // deprecated - kept for back-compat
  budget         Float?        @map("budget")
  isArchived     Boolean       @default(false) @map("is_archived")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  owner           Employee               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  currentPhase    ProjectPhase?          @relation(fields: [currentPhaseId], references: [id], onDelete: SetNull)
  members         ProjectMember[] // legacy - kept for migration safety
  teams           ProjectTeam[] // v2 - primary structure
  tasks           ProjectTask[]
  resources       ProjectResource[]
  folders         ProjectFolder[]
  links           ProjectLink[]
  deliverables    ProjectDeliverable[]
  timesheets      Timesheet[]
  activities      ProjectActivity[]
  messages        ProjectMessage[]
  messageReads    ProjectMessageRead[]
  passwordEntries ProjectPasswordEntry[]
  brand           ProjectBrand?
  brandAssets     BrandAsset[]
  contentCalendar ContentCalendarEntry[]
  sheets          ProjectSheet[]
  workbooks       ProjectWorkbook[]
  integration     ProjectIntegration?
  metaCampaigns   MetaCampaign[]
  seoProperties   SeoProperty[]
  requirements    ProjectRequirement[]

  mailers        ProjectMailer[]
  emailTemplates ProjectEmailTemplate[]
  recipients     ProjectRecipient[]
  campaigns      ProjectCampaign[]

  assets         ProjectAsset[]
  uptimeMonitors UptimeMonitor[]

  clientAccess        ClientProjectAccess[]
  clientActivity      ClientActivityLog[]
  marketplaceChannels MarketplaceChannel[]
  products            Product[]
  projectMailerAssets ProjectMailerAsset[]
  projectGoals        ProjectGoal[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([status])
  @@index([ownerId])
  @@index([clientId])
  @@index([tenantId])
  @@map("projects")
}

