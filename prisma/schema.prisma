model ProjectTask {
  id               String             @id @default(uuid()) @map("id")
  // Null = ADHOC: work that belongs to no client - meetings, interviews,
  // internal QC. It used to be a stand-in "ADHOC" project, which made it show
  // up everywhere a real client did (portfolio, progress, billing) and read as
  // an account nobody could name. An adhoc task has no project and no team; the
  // assignee's line manager stands in for the team manager on it.
  projectId        String?            @map("project_id")
  teamId           String?            @map("team_id") // v2 - null for legacy tasks and adhoc work
  title            String             @map("title")
  description      String?            @map("description") @db.Text
  status           TaskStatus         @default(TODO) @map("status")
  priority         TaskPriority       @default(MEDIUM) @map("priority")
  assigneeId       String?            @map("assignee_id")
  creatorId        String             @map("creator_id")
  startDate        DateTime?          @map("start_date") @db.Date
  dueDate          DateTime?          @map("due_date") @db.Date
  completedAt      DateTime?          @map("completed_at")
  estimatedHours   Float?             @map("estimated_hours")
  loggedHours      Float              @default(0) @map("logged_hours")
  // Set the moment a task enters IN_PROGRESS, cleared when it leaves. The time
  // between the two is added to loggedHours, so "time spent" is measured rather
  // than remembered. Non-null therefore means "the clock is running right now".
  inProgressSince  DateTime?          @map("in_progress_since")
  tags             String[]           @map("tags")
  // Where the work lives: the brief, the doc, the published page. A blog or a
  // product page is not finished until there is a URL to point at, and that URL
  // used to end up in a chat message nobody could find later.
  links            String[]           @map("links")
  // Nothing writes PENDING_APPROVAL any more - tasks are self-service, so every
  // new one is APPROVED. The column stays for the REJECTED rows already on
  // record (with their rejectionReason), which the views still hide.
  approvalStatus   TaskApprovalStatus @default(APPROVED) @map("approval_status")
  // Raised by a manager/admin for someone else, rather than planned by the
  // assignee themselves. Informational only - it gates nothing.
  isManagerCreated Boolean            @default(true) @map("is_manager_created")
  rejectionReason  String?            @map("rejection_reason")
  // ON_HOLD requires a reason + the date it's expected to resume/finish by;
  // DISCARDED requires a reason. Kept alongside status so the history reads.
  holdReason       String?            @map("hold_reason") @db.Text
  holdExpectedDate DateTime?          @map("hold_expected_date") @db.Date
  discardReason    String?            @map("discard_reason") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  isMilestone Boolean @default(false) @map("is_milestone")

  // Which tracked site this work is for. Null = the project as a whole. Lets an
  // account like KYG (13 subdomains under one project) see what is actually
  // being done per subdomain.
  seoPropertyId String? @map("seo_property_id")

  // Set while this task is waiting on a ProjectRequirement. Cleared when the
  // requirement is resolved, so "blocked" is derived from live data rather than
  // a flag somebody has to remember to unset.
  requirementId String? @map("requirement_id")

  // The task this one was raised from when that task was put ON_HOLD. Putting
  // work on hold books the unfinished hours onto a new task dated for the day it
  // is expected to resume, and this is the link back. It also makes the spawn
  // idempotent: a task held, resumed and held again updates its existing
  // follow-up instead of littering the board with copies.
  resumedFromId String? @map("resumed_from_id")

  project        Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seoProperty    SeoProperty?          @relation(fields: [seoPropertyId], references: [id], onDelete: SetNull)
  requirement    ProjectRequirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  // SetNull, not Cascade: deleting the held task must not take the follow-up
  // (and the hours booked on it) with it.
  resumedFrom    ProjectTask?          @relation("TaskResume", fields: [resumedFromId], references: [id], onDelete: SetNull)
  resumeTasks    ProjectTask[]         @relation("TaskResume")
  team           ProjectTeam?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee       Employee?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        Employee              @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  timesheets     Timesheet[]
  comments       TaskComment[]
  checklistItems TaskChecklistItem[]
  statusPeriods  TaskStatusPeriod[]
  reminderStates TaskReminderState[]
  // Set when this task was generated from a content-calendar post.
  contentEntry   ContentCalendarEntry?

  @@index([projectId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([approvalStatus])
  // Serves the "is there already an open follow-up for this task?" lookup done
  // every time a task is put on hold.
  @@index([resumedFromId])
  @@map("project_tasks")
}

model TaskComment {
  id        String   @id @default(uuid()) @map("id")
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  content   String   @map("content") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Employee    @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskChecklistItem {
  id           String   @id @default(uuid()) @map("id")
  taskId       String   @map("task_id")
  text         String   @map("text")
  isChecked    Boolean  @default(false) @map("is_checked")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

/**
 * One row per stretch a task spent in a single status.
 * The open row (endedAt = null) is the status the task is in right now. On every
 * status change the open row is closed with its duration and a new one opened,
 * which makes "how long did this sit in To-do / In Progress / On Hold" a read
 * rather than a reconstruction. The first row is created lazily on the first
 * transition, backdated to the task's createdAt, so history is complete for
 * tasks that existed before this table did.
 */
model TaskStatusPeriod {
  id              String     @id @default(uuid()) @map("id")
  taskId          String     @map("task_id")
  status          TaskStatus @map("status")
  /**
   * Who moved the task INTO this status. Null for the backdated first row.
   */
  actorId         String?    @map("actor_id")
  startedAt       DateTime   @map("started_at")
  endedAt         DateTime?  @map("ended_at")
  /**
   * Denormalised endedAt - startedAt, so totals do not need date maths in SQL.
   */
  durationSeconds Int?       @map("duration_seconds")
  /**
   * Why the task was moved INTO this status - the hold reason, the discard
   * reason. Stored per period rather than read off the task, because the task
   * only carries its CURRENT reason: coming off hold clears holdReason, so the
   * history would lose the answer to "why was this parked in June" the moment
   * the work resumed.
   */
  note            String?    @map("note") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")

  task  ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor Employee?   @relation("TaskStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, startedAt])
  @@map("task_status_periods")
}

// ── Requirements ──────────────────────────────────────────────────────────────
// A dependency a team has on someone OUTSIDE it: verification documents, client
// credentials, an access grant, copy, a sign-off. Deliberately not a task (it is
// not the recipient's delivery work, and it would distort their throughput) and
// not a chat message (nobody can answer "what is WEB blocked on" from a thread).

enum RequirementType {
  DOCUMENT
  CREDENTIAL
  ACCESS
  CONTENT
  DESIGN
  APPROVAL
  PAYMENT
  OTHER
}

enum RequirementStatus {
  OPEN
  IN_PROGRESS
  PROVIDED
  REJECTED
  CLOSED
}

model ProjectRequirement {
  id              String            @id @default(uuid()) @map("id")
  projectId       String            @map("project_id")
  teamId          String?           @map("team_id") // the blocked team
  raisedById      String            @map("raised_by_id")
  requestedFromId String            @map("requested_from_id") // usually the Account Manager
  type            RequirementType   @default(OTHER) @map("type")
  status          RequirementStatus @default(OPEN) @map("status")
  title           String            @map("title")
  details         String?           @map("details") @db.Text
  neededBy        DateTime?         @map("needed_by") @db.Date
  /// Set when it leaves OPEN/IN_PROGRESS, so "how long were we blocked" is stored.
  resolvedAt      DateTime?         @map("resolved_at")
  /// Why it was refused, or the note left when provided.
  resolutionNote  String?           @map("resolution_note") @db.Text
  /// Suppresses the daily overdue nudge without closing the requirement.
  remindedAt      DateTime?         @map("reminded_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team          ProjectTeam?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  raisedBy      Employee      @relation("RequirementRaiser", fields: [raisedById], references: [id], onDelete: Cascade)
  requestedFrom Employee      @relation("RequirementOwner", fields: [requestedFromId], references: [id], onDelete: Cascade)
  /// The work this is holding up. A task has at most one blocking requirement.
  blockedTasks  ProjectTask[]

  @@index([projectId, status])
  @@index([requestedFromId, status])
  @@index([raisedById])
  @@map("project_requirements")
}

model ProjectActivity {
  id         String   @id @default(uuid()) @map("id")
  projectId  String   @map("project_id")
  actorId    String   @map("actor_id")
  type       String   @map("type")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  meta       Json?    @map("meta")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   Employee @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("project_activities")
}

model ProjectMessage {
  id           String   @id @default(uuid()) @map("id")
  projectId    String   @map("project_id")
  authorId     String   @map("author_id")
  title        String   @map("title")
  content      String   @map("content") @db.Text
  isPinned     Boolean  @default(false) @map("is_pinned")
  // Employee ids tagged via @mention in the content; drives notifications + highlighting.
  mentionedIds String[] @default([]) @map("mentioned_ids")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  Employee              @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies ProjectMessageReply[]

  @@index([projectId])
  @@map("project_messages")
