  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  objectKey    String   @unique @map("object_key") // B2 object key
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy Employee? @relation("BrandAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("brand_assets")
}

// A single scheduled content-calendar post for a project.
model ContentCalendarEntry {
  id        String    @id @default(uuid()) @map("id")
  projectId String    @map("project_id")
  date      DateTime? @map("date") @db.Date
  platform  String?   @map("platform") // Meta, Instagram, LinkedIn, YouTube …
  theme     String?   @map("theme") // occasion / topic
  format    String?   @map("format") // Reel, Static, Carousel, Poll, Video …
  hook      String?   @map("hook") @db.Text
  content   String?   @map("content") @db.Text
  status    String    @default("PLANNED") @map("status") // PLANNED | IN_PROGRESS | READY | POSTED
  link      String?   @map("link")

  // Who is responsible for writing/publishing this post. Setting an assignee is
  // what turns a calendar row into real, reminded work.
  assigneeId String?   @map("assignee_id")
  // The ProjectTask mirroring this entry, so a planned post shows up on the
  // assignee's board and in their reminders. Kept in sync both ways.
  taskId     String?   @unique @map("task_id")
  // Last time the "publish today" reminder went out, so the daily cron notifies
  // once per entry instead of every run.
  remindedAt DateTime? @map("reminded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee Employee?    @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  task     ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([assigneeId])
  @@index([date, status])
  @@map("content_calendar_entries")
}

