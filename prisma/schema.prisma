  updatedAt    DateTime @updatedAt @map("updated_at")

  /// What this quotes: a reply or the opening post (exactly one is set). SetNull so the quote shows "message deleted".
  replyToId     String? @map("reply_to_id")
  replyToRootId String? @map("reply_to_root_id")

  message     ProjectMessage             @relation(fields: [messageId], references: [id], onDelete: Cascade)
