  id         String @id @default(uuid()) @map("id")
  instanceId String @map("instance_id")

  /// Snapshot copied from the template.
  sectionTitle String                @map("section_title")
  text         String                @map("text")
  helpText     String?               @map("help_text")
  itemKind     ChecklistItemKind     @default(TASK) @map("item_kind")
  assigneeRole ChecklistAssigneeRole @default(HR) @map("assignee_role")
  /// The resolved person; null = the HR pool. A CLEARANCE with an assignee can only be signed by that
  /// person (or an HR override).
  assigneeId   String?               @map("assignee_id")
  isRequired   Boolean               @default(true) @map("is_required")
  dueDate      DateTime?             @db.Date @map("due_date")
  displayOrder Int                   @default(0) @map("display_order")
