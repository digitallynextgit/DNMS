// One row per campaign per day (Meta insights, time_increment=1).
model MetaCampaignMetric {
  tenantId          String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id                String   @id @default(uuid())
  campaignId        String   @map("campaign_id") // FK -> MetaCampaign.id
  date              DateTime @map("date") @db.Date
  spend             Decimal  @default(0) @map("spend") @db.Decimal(14, 2)
  impressions       BigInt   @default(0) @map("impressions")
  clicks            BigInt   @default(0) @map("clicks")
  ctr               Decimal  @default(0) @map("ctr") @db.Decimal(8, 4)
  cpc               Decimal  @default(0) @map("cpc") @db.Decimal(10, 2)
  cpm               Decimal  @default(0) @map("cpm") @db.Decimal(10, 2)
  reach             BigInt   @default(0) @map("reach")
  conversions       Int      @default(0) @map("conversions")
  costPerConversion Decimal  @default(0) @map("cost_per_conversion") @db.Decimal(10, 2)
  purchases         Int      @default(0) @map("purchases")
  purchaseValue     Decimal  @default(0) @map("purchase_value") @db.Decimal(14, 2)
  roas              Decimal  @default(0) @map("roas") @db.Decimal(10, 2)
  addToCart         Int      @default(0) @map("add_to_cart")
  landingPageViews  Int      @default(0) @map("landing_page_views")
  currency          String   @default("INR") @map("currency")
  createdAt         DateTime @default(now()) @map("created_at")

  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
  @@index([tenantId])
  @@map("meta_campaign_metrics")
}

