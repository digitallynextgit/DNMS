model ContentCalendarEntry {
  tenantId  String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String    @id @default(uuid()) @map("id")
  projectId String    @map("project_id")
  date      DateTime? @map("date") @db.Date
  platform  String?   @map("platform") // Meta, Instagram, LinkedIn, YouTube …
  theme     String?   @map("theme") // occasion / topic
  format    String?   @map("format") // Reel, Static, Carousel, Poll, Video …
  hook      String?   @map("hook") @db.Text
  content   String?   @map("content") @db.Text
  status    String    @default("PLANNED") @map("status") // PLANNED | IN_PROGRESS | READY | POSTED
  link      String?   @map("link")

  // Setting an assignee turns a calendar row into real, reminded work.
  assigneeId String?   @map("assignee_id")
  // The ProjectTask mirroring this entry (synced both ways), so it shows on the assignee's board.
  taskId     String?   @unique @map("task_id")
  // Last "publish today" reminder, so the daily cron notifies once per entry.
  remindedAt DateTime? @map("reminded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee Employee?    @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  task     ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

