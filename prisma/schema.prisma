/// A team-defined spreadsheet (content calendar, campaign plan, tracker): one tab of a ProjectWorkbook.
model ProjectSheet {
  tenantId    String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String   @id @default(uuid()) @map("id")
  projectId   String   @map("project_id")
  name        String   @map("name")
  description String?  @map("description")
  /// Tab order, left to right.
  position    Int      @default(0) @map("position")
  /// Row heights in px keyed by row position ({ "0": 56 }). Kept on the sheet because a row only exists once
  /// something is typed into it.
  rowHeights  Json?    @map("row_heights")
  /// The workbook this tab belongs to - what the Calendars UI calls a "sheet".
  workbookId  String   @map("workbook_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workbook  ProjectWorkbook      @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  createdBy Employee?            @relation("SheetAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  columns   ProjectSheetColumn[]
  rows      ProjectSheetRow[]
  events    ProjectSheetEvent[]

  @@unique([workbookId, name])
  @@index([projectId])
  @@index([workbookId])
  @@index([tenantId])
  @@map("project_sheets")
}

/// A named set of tabs - what the Calendars UI calls a "sheet". Deleting it deletes every tab.
model ProjectWorkbook {
  tenantId     String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String   @id @default(uuid()) @map("id")
  projectId    String   @map("project_id")
  name         String   @map("name")
  /// The month this calendar edition covers, stored as its 1st day (2026-09-01 = September 2026).
  /// NULL = an undated calendar; the two unique indexes below keep both cases unique by name.
  periodMonth  DateTime? @map("period_month") @db.Date
  position     Int      @default(0) @map("position")
  createdById  String?  @map("created_by_id")
  /// Set when a CLIENT started this calendar from the portal. A client may delete only calendars they started.
  createdByClientId String? @map("created_by_client_id")
  /// The calendar manager supervising this month (not necessarily the author). Null = unassigned.
  assignedToId String?  @map("assigned_to_id")
  /// Publishes this calendar to the client portal. Off by default on purpose: internal sheets must be shared
  /// deliberately.
  isClientVisible Boolean @default(false) @map("is_client_visible")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  Employee?      @relation("WorkbookAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdByClient ClientUser? @relation("WorkbookClientAuthor", fields: [createdByClientId], references: [id], onDelete: SetNull)
  assignedTo Employee?      @relation("WorkbookAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  sheets     ProjectSheet[]
  teams      ProjectWorkbookTeam[]

  /// One calendar of a given name per month (dated editions). Also serves the month picker's ordered read.
  @@unique([projectId, name, periodMonth])
  /// NULLs are distinct in a Postgres unique index, so this partial index keeps undated calendars unique.
  /// Don't look up by `undatedName`: Prisma omits the predicate, so findUnique acts like findFirst.
  @@unique([projectId, name], name: "undatedName", map: "project_workbooks_project_id_name_undated_key", where: raw("period_month IS NULL"))
  @@index([projectId])
  @@index([assignedToId])
  @@index([createdByClientId])
  @@index([projectId, isClientVisible])
  @@index([tenantId])
  @@map("project_workbooks")
}

/// Where a team's month stands (same words as tasks and deliverables).
enum WorkbookTeamStatus {
  TODO
  IN_PROGRESS
  /// Only reachable once the row has `quantity` links/files (features/projects/lib/workbook-team-progress.ts).
  DONE
  /// Blocked, but still owed.
  STUCK
  /// Dropped without being made; unlike removing the team, this remembers it was promised.
  DISCARDED
}

/// One team's commitment on a monthly calendar: how much they owe, by when, who is doing it, and what came out.
/// This is the plan, not a ProjectTask, and it creates none.
model ProjectWorkbookTeam {
  tenantId    String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String    @id @default(uuid()) @map("id")
  workbookId  String    @map("workbook_id")
  teamId      String    @map("team_id")
  /// Items this team owes. 0 = on it but not yet quantified.
  quantity    Int       @default(0) @map("quantity")
  status      WorkbookTeamStatus @default(TODO) @map("status")
  /// Null = no date agreed yet.
  dueOn       DateTime? @map("due_on") @db.Date
  /// http(s) links to the work (task, Drive folder, page), validated by the route. Uploads are ProjectResource rows.
  links       String[]  @default([]) @map("links")
  notes       String?   @map("notes") @db.Text
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workbook    ProjectWorkbook             @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  team        ProjectTeam                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   Employee?                   @relation("WorkbookTeamAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  members     ProjectWorkbookTeamMember[]
  attachments ProjectResource[]

  @@unique([workbookId, teamId])
  @@index([workbookId])
  @@index([teamId])
  @@index([dueOn])
  @@index([status])
  @@index([tenantId])
  @@map("project_workbook_teams")
}

/// Who on the team does this calendar's work (narrower than the whole team) and gets notified. Grants no access.
model ProjectWorkbookTeamMember {
  tenantId       String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id             String   @id @default(uuid()) @map("id")
  workbookTeamId String   @map("workbook_team_id")
  /// Copied from the parent row so "one team per calendar per person" can be a unique constraint.
  workbookId     String   @map("workbook_id")
  employeeId     String   @map("employee_id")
  addedAt        DateTime @default(now()) @map("added_at")

  workbookTeam ProjectWorkbookTeam @relation(fields: [workbookTeamId], references: [id], onDelete: Cascade)
  employee     Employee            @relation("WorkbookTeamMembership", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([workbookTeamId, employeeId])
  @@unique([workbookId, employeeId])
  @@index([workbookTeamId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("project_workbook_team_members")
}

model ProjectSheetColumn {
  tenantId  String          @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String          @id @default(uuid()) @map("id")
  sheetId   String          @map("sheet_id")
  name      String          @map("name")
  type      SheetColumnType @default(TEXT) @map("type")
  position  Int             @default(0) @map("position")
  /// Rendered width in px. Null lets the grid size it.
  width     Int?            @map("width")
  /// SELECT choices, as a JSON array of strings. Null for every other type.
  options   Json?           @map("options")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  sheet ProjectSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, position])
  @@index([tenantId])
  @@map("project_sheet_columns")
}

model ProjectSheetRow {
  tenantId    String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String   @id @default(uuid()) @map("id")
  sheetId     String   @map("sheet_id")
  position    Int      @default(0) @map("position")
  /// Cell values keyed by column id ({ "<uuid>": "Reel" }). One JSON blob because a sheet is always read whole;
  /// per-cell history lives in ProjectSheetEvent.
  cells       Json     @default("{}") @map("cells")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sheet     ProjectSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  createdBy Employee?    @relation("SheetRowAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sheetId, position])
  @@index([tenantId])
  @@map("project_sheet_rows")
}

enum SheetEventType {
  SHEET_CREATED
  SHEET_RENAMED
  COLUMN_ADDED
  COLUMN_UPDATED
  COLUMN_DELETED
  ROW_ADDED
  CELL_UPDATED
  ROW_DELETED
}

/// Append-only change log for a sheet. rowId/columnId are NOT foreign keys so deletion events survive the
/// deletion; `label` keeps the name as it read at the time.
model ProjectSheetEvent {
  tenantId  String         @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String         @id @default(uuid()) @map("id")
  sheetId   String         @map("sheet_id")
  rowId     String?        @map("row_id")
  columnId  String?        @map("column_id")
  type      SheetEventType @map("type")
  label     String?        @map("label")
  before    Json?          @map("before")
  after     Json?          @map("after")
  actorId   String?        @map("actor_id")
  /// Set when a CLIENT made the edit from the portal. Both actor ids null = a system write.
  actorClientId String?     @map("actor_client_id")
  createdAt DateTime       @default(now()) @map("created_at")

  sheet ProjectSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  actor Employee?    @relation("SheetEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorClient ClientUser? @relation("SheetEventClientActor", fields: [actorClientId], references: [id], onDelete: SetNull)

  @@index([sheetId, createdAt])
  @@index([tenantId])
  @@map("project_sheet_events")
}

model ProjectTeam {
  tenantId    String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String   @id @default(uuid()) @map("id")
  projectId   String   @map("project_id")
  name        String   @map("name") // ad-hoc, e.g. "Web Development"
  description String?  @map("description")
  managerId   String?  @map("manager_id") // nullable when team is empty
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manager      Employee?            @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      ProjectTeamMember[]
  tasks        ProjectTask[]
  resources    ProjectResource[]
  requirements ProjectRequirement[]
  deliverables ProjectDeliverable[]
  workbookTeams ProjectWorkbookTeam[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([tenantId])
  @@map("project_teams")
}

model ProjectTeamMember {
  tenantId   String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String   @id @default(uuid()) @map("id")
  teamId     String   @map("team_id")
  projectId  String   @map("project_id") // denormalised to enforce 1 team per project per employee
  employeeId String   @map("employee_id")
  joinedAt   DateTime @default(now()) @map("joined_at")

  team     ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee    @relation("ProjectTeamMembership", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@unique([projectId, employeeId])
  @@index([teamId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("project_team_members")
}

/// Review state of a client-shared file. Null = not part of a review (not "not yet reviewed").
enum AssetReviewStatus {
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum ResourceCategory {
  BRIEFS
  ASSETS
  DELIVERABLES
  REFERENCES
  OTHER
}

/// What kind of document a file is (ResourceCategory is its pipeline stage). Guessed on upload by
/// features/projects/lib/doc-tag.ts and editable; null on older rows.
enum DocTag {
  BRAND
  STRATEGY
  RESEARCH
  JOURNEY
  REPORT
  CREATIVE
  VIDEO
  PRODUCT
  LEGAL
  OTHER
}

model ProjectResource {
  tenantId      String           @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id            String           @id @default(uuid()) @map("id")
  projectId     String           @map("project_id")
  teamId        String?          @map("team_id") // null = project-level
  category      ResourceCategory @default(OTHER) @map("category")
  tag           DocTag?          @map("tag")
  fileName      String           @map("file_name")
  fileSize      Int              @map("file_size")
  mimeType      String           @map("mime_type")
  /// B2 object key. NULL when the file lives in Google Drive (video: too big for the 20 MB cap).
  /// Exactly one of objectKey / driveFileId is set (CHECK constraint).
  objectKey     String?          @unique @map("object_key")
  driveFileId   String?          @unique @map("drive_file_id")
  /// Drive's viewer URL - internal only, the file isn't public in Drive. Public sharing uses shareToken.
  driveWebViewLink String?       @map("drive_web_view_link")
  /// True while a share link exists, so the portal can show Copy without selecting the secret.
  isPublicLink  Boolean          @default(false) @map("is_public_link")
  /// Secret behind /api/public/share/<token>, which streams the video with no sign-in. Proxied because this
  /// Workspace forbids public Drive files; clearing it revokes the link. Never return it from a list query.
  shareToken    String?          @unique @map("share_token")
  sharedPubliclyAt DateTime?     @map("shared_publicly_at")
  description   String?          @map("description")
  /// Exactly one of uploadedById / uploadedByClientId is set (CHECK constraint).
  uploadedById  String?          @map("uploaded_by_id")
  /// Set when the file came from the client portal (staff and portal accounts are separate tables).
  uploadedByClientId String?     @map("uploaded_by_client_id")

  /// Visible in the client portal. Off by default on purpose: files reach outsiders only when deliberately shared.
  isClientVisible Boolean        @default(false) @map("is_client_visible")
  sharedAt      DateTime?        @map("shared_at")

  /// The approval loop. Only meaningful while isClientVisible.
  reviewStatus  AssetReviewStatus? @map("review_status")
  reviewedAt    DateTime?        @map("reviewed_at")
  reviewedByClientId String?     @map("reviewed_by_client_id")
  /// Set when STAFF reviewed instead - how a client's own upload gets decided.
  reviewedById  String?          @map("reviewed_by_id")
  reviewNote    String?          @map("review_note")
  /// Set when the file is a logged deliverable's output. SetNull so a wrong log line can't destroy the work.
  deliverableId String?          @map("deliverable_id")
  /// Set when the file is a team's output on a monthly calendar (SetNull for the same reason).
  workbookTeamId String?         @map("workbook_team_id")
  /// Folder in the Files tree; null = top level. The service refuses to delete a non-empty folder.
  folderId      String?          @map("folder_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        ProjectTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  uploadedBy  Employee?           @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByClient ClientUser?    @relation("ResourceClientUploader", fields: [uploadedByClientId], references: [id], onDelete: SetNull)
  reviewedByClient ClientUser?    @relation("ResourceReviewer", fields: [reviewedByClientId], references: [id], onDelete: SetNull)
  reviewedBy  Employee?           @relation("ResourceStaffReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deliverable ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  workbookTeam ProjectWorkbookTeam? @relation(fields: [workbookTeamId], references: [id], onDelete: SetNull)
  folder      ProjectFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([teamId])
  @@index([category])
  @@index([tag])
  @@index([deliverableId])
  @@index([workbookTeamId])
  @@index([projectId, folderId])
  @@index([projectId, isClientVisible])
  @@index([tenantId])
  @@map("project_resources")
}

/// A folder in a project's Files tab. With Google Drive set up, each folder mirrors a Drive sub-folder
/// (`driveFolderId`), and folders created in Drive are adopted on read. Null parentId = top level.
model ProjectFolder {
  tenantId      String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id            String   @id @default(uuid()) @map("id")
  projectId     String   @map("project_id")
  parentId      String?  @map("parent_id")
  name          String   @map("name")
  driveFolderId String?  @unique @map("drive_folder_id")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectFolder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFolder[]   @relation("FolderTree")
  createdBy Employee          @relation("FolderCreator", fields: [createdById], references: [id])
  resources ProjectResource[]
  links     ProjectLink[]

  @@index([projectId, parentId])
  @@index([tenantId])
  @@map("project_folders")
}

/// A URL saved in a project's Files tree (Figma, Notion, a live site), using the same folders and DocTags as files.
model ProjectLink {
  tenantId    String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String   @id @default(uuid()) @map("id")
  projectId   String   @map("project_id")
  folderId    String?  @map("folder_id")
  title       String   @map("title")
  url         String   @map("url")
  tag         DocTag?  @map("tag")
  description String?  @map("description")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy Employee       @relation("LinkCreator", fields: [createdById], references: [id])

  @@index([projectId, folderId])
  @@index([tenantId])
  @@map("project_links")
}

/// Something a person PRODUCED for a project (a video, product pages): one row per thing or batch (`quantity`).
/// Its files are ProjectResource rows (DELIVERABLES category) linked back here.
model ProjectDeliverable {
  tenantId          String            @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id                String            @id @default(uuid()) @map("id")
  projectId         String            @map("project_id")
  /// The team that owes/made it: from the plan, else the maker's team at logging time. Null = no team.
  teamId            String?           @map("team_id")
  /// Who made it. Null only while still owed and unclaimed (teamId says who owes it); a CHECK enforces this.
  employeeId        String?           @map("employee_id")
  /// Who wrote the entry - the maker, or a manager logging on their behalf.
  loggedById        String?           @map("logged_by_id")
  /// Set instead of loggedById for client-portal entries. No CHECK: older rows legitimately have neither.
  loggedByClientId  String?           @map("logged_by_client_id")
  taskId            String?           @map("task_id")
  /// "Video", "Reel"... free text, normalised so "reel" and "Reel" count together.
  type              String            @map("type")
  title             String            @map("title")
  /// "10 product pages" can be one entry. Every count sums this.
  quantity          Int               @default(1) @map("quantity")
  /// How many of `quantity` are made so far; DELIVERED is only offered once it reaches `quantity`.
  deliveredQuantity Int               @default(0) @map("delivered_quantity")
  /// PLANNED = owed; DELIVERED = made; ACCEPTED / REJECTED = the client's verdict, recorded by staff.
  status            DeliverableStatus @default(DELIVERED) @map("status")
  /// Current reason for STUCK / DISCARDED (history is on ProjectDeliverableEvent). Cleared when no longer needed.
  statusReason      String?           @map("status_reason")
  /// When a PLANNED row is owed by. Null for after-the-fact logging.
  dueOn             DateTime?         @map("due_on") @db.Date
  /// The window the commitment covers. Both set or both null, end >= start (CHECK). dueOn stays the deadline.
  periodStart       DateTime?         @map("period_start") @db.Date
  periodEnd         DateTime?         @map("period_end") @db.Date
  /// The goal this serves when the task link isn't enough. SetNull: removing a goal must not remove the work.
  goalId            String?           @map("goal_id")
  startedOn         DateTime?         @map("started_on") @db.Date
  /// The day it counts for. Null only while PLANNED / IN_PROGRESS (CHECK constraint).
  completedOn       DateTime?         @map("completed_on") @db.Date
  /// How many times it went REJECTED -> DELIVERED.
  revisionCount     Int               @default(0) @map("revision_count")
  acceptedAt        DateTime?         @map("accepted_at")
  acceptedById      String?           @map("accepted_by_id")
  /// Set instead of acceptedById when the client accepted it in the portal.
  acceptedByClientId String?          @map("accepted_by_client_id")
  acceptanceNote    String?           @map("acceptance_note") @db.Text
  /// Where it lives: the Drive folder, the published page. http(s) only.
  links             String[]          @default([]) @map("links")
  notes             String?           @map("notes") @db.Text
  /// Internal QC sign-off by a manager; null = self-reported. ACCEPTED is the client's word.
  verifiedById      String?           @map("verified_by_id")
  verifiedAt        DateTime?         @map("verified_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  project    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team       ProjectTeam?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  employee   Employee?                 @relation("DeliverableMaker", fields: [employeeId], references: [id], onDelete: Cascade)
  loggedBy   Employee?                 @relation("DeliverableLogger", fields: [loggedById], references: [id], onDelete: SetNull)
  verifiedBy Employee?                 @relation("DeliverableVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  acceptedBy Employee?                 @relation("DeliverableAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  loggedByClient   ClientUser?         @relation("DeliverableClientLogger", fields: [loggedByClientId], references: [id], onDelete: SetNull)
  acceptedByClient ClientUser?         @relation("DeliverableClientAcceptor", fields: [acceptedByClientId], references: [id], onDelete: SetNull)
  task       ProjectTask?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal       ProjectGoal?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  files      ProjectResource[]
  events     ProjectDeliverableEvent[]

  @@index([projectId, completedOn])
  @@index([employeeId, completedOn])
  @@index([projectId, status])
  @@index([projectId, periodStart])
  @@index([goalId])
  @@index([teamId])
  @@index([teamId, status])
  @@index([taskId])
  @@index([tenantId])
  @@map("project_deliverables")
}

enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  DELIVERED
  ACCEPTED
  REJECTED
  /// Blocked but still owed (stays on the open lists). Carries a reason.
  STUCK
  /// Closed without being made: counts as neither made nor owed. Carries a reason.
  DISCARDED
}

enum DeliverableEventType {
  CREATED
  EDITED
  STATUS_CHANGED
  VERIFIED
  UNVERIFIED
  /// A project manager edited a row whose period had closed for members.
  LOCKED_EDIT
}

/// History of one deliverable: never edited, deleted with its row.
model ProjectDeliverableEvent {
  tenantId      String               @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id            String               @id @default(uuid()) @map("id")
  deliverableId String               @map("deliverable_id")
  type          DeliverableEventType @map("type")
  fromStatus    DeliverableStatus?   @map("from_status")
  toStatus      DeliverableStatus?   @map("to_status")
  /// { field: [before, after] } for EDITED / LOCKED_EDIT / STATUS_CHANGED.
  changes       Json?                @map("changes")
  reason        String?              @map("reason") @db.Text
  actorId       String?              @map("actor_id")
  /// Set instead of actorId when the portal did it (actorId is an FK to employees).
  actorClientId String?              @map("actor_client_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  deliverable ProjectDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  actor       Employee?          @relation("DeliverableEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorClient ClientUser?        @relation("DeliverableEventClientActor", fields: [actorClientId], references: [id], onDelete: SetNull)

  @@index([deliverableId, createdAt])
  @@index([tenantId])
  @@map("project_deliverable_events")
}

/// "50 reels by March": goal progress counted from deliverables instead of task checkboxes.
model ProjectGoalTarget {
  tenantId        String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id              String    @id @default(uuid()) @map("id")
  goalId          String    @map("goal_id")
  /// Free text matched case-insensitively against ProjectDeliverable.type.
  deliverableType String    @map("deliverable_type")
  quantity        Int       @map("quantity")
  /// Both null = counts everything ever attributed to the goal.
  periodStart     DateTime? @map("period_start") @db.Date
  periodEnd       DateTime? @map("period_end") @db.Date
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  goal      ProjectGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdBy Employee?   @relation("GoalTargetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@index([tenantId])
  @@map("project_goal_targets")
}

