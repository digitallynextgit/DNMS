// =============================================================================
// PERFORMANCE EVALUATION (self + manager weighted scorecard)
//
// Each employee has a reusable PROFILE of KPIs/parameters, split by:
//   • evaluator: SELF | MANAGER  (the two sides can list different items)
//   • section:   A (Role Performance, 60%) | B (Workplace Discipline, 40%)
// Weights are auto equal-split within each section (see features/performance/
// evaluation.ts). Creating an evaluation SNAPSHOTS the profile into
// self_criteria / manager_criteria as JSON: [{ id, section, label, weight }].
// Ratings are JSON maps { [criterionId]: 1..5 }.
// =============================================================================

// Reusable per-employee KPI / parameter definition (the "profile").
model PerfKpi {
  id          String   @id @default(uuid()) @map("id")
  employeeId  String   @map("employee_id")
  evaluator   String   @map("evaluator") // "SELF" | "MANAGER"
  section     String   @map("section") // "A" | "B"
  label       String   @map("label")
  description String?  @map("description") @db.Text
  order       Int      @default(0) @map("order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation("EmployeePerfKpis", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("perf_kpis")
}

model Evaluation {
  id              String    @id @default(uuid()) @map("id")
  selfCriteria    Json      @map("self_criteria") // snapshot at creation time
  managerCriteria Json      @map("manager_criteria") // snapshot at creation time
  sectionALabel   String    @map("section_a_label")
  sectionBLabel   String    @map("section_b_label")
  employeeId      String    @map("employee_id")
  managerId       String?   @map("manager_id")
  periodLabel     String    @map("period_label")
  periodStart     DateTime? @map("period_start") @db.Date
  periodEnd       DateTime? @map("period_end") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date

  // PENDING → SELF_DONE / MANAGER_DONE → COMPLETED (both submitted)
  status String @default("PENDING") @map("status")

  selfRatings        Json?     @map("self_ratings")
  managerRatings     Json?     @map("manager_ratings")
  selfComment        String?   @map("self_comment") @db.Text
  managerComment     String?   @map("manager_comment") @db.Text
  selfSubmittedAt    DateTime? @map("self_submitted_at")
  managerSubmittedAt DateTime? @map("manager_submitted_at")

  // Optional 3rd reviewer (Project Controller) - recorded alongside; does not
  // change the final score (which is the manager's weighted score).
  controllerId          String?   @map("controller_id")
  controllerRatings     Json?     @map("controller_ratings")
  controllerComment     String?   @map("controller_comment") @db.Text
  controllerSubmittedAt DateTime? @map("controller_submitted_at")

  // Final = weighted manager score out of 100 (computed on manager submit)
  finalScore  Float?   @map("final_score")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee   Employee  @relation("EvaluationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager    Employee? @relation("EvaluationManager", fields: [managerId], references: [id], onDelete: SetNull)
  controller Employee? @relation("EvaluationController", fields: [controllerId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([managerId])
  @@index([status])
  @@map("evaluations")
}

// =============================================================================
// RECRUITMENT (M7)
// =============================================================================

model JobPosting {
  id               String    @id @default(uuid()) @map("id")
  title            String    @map("title")
  slug             String?   @map("slug")
  departmentId     String?   @map("department_id")
  description      String?   @map("description") @db.Text
  requirements     String?   @map("requirements") @db.Text
  location         String?   @map("location")
  type             String    @default("FULL_TIME") @map("type")
  salaryMin        Float?    @map("salary_min")
  salaryMax        Float?    @map("salary_max")
  status           JobStatus @default(DRAFT) @map("status")
  openings         Int       @default(1) @map("openings")
  closingDate      DateTime? @map("closing_date") @db.Date
  postedById       String    @map("posted_by_id")
  meta             String?   @map("meta")
  summary          String?   @map("summary") @db.Text
  intro            String?   @map("intro") @db.Text
  jobEssence       String?   @map("job_essence") @db.Text
  keyRequirements  String[]  @default([]) @map("key_requirements")
  currentOpenings  String[]  @default([]) @map("current_openings")
  publishToCareers Boolean   @default(false) @map("publish_to_careers")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  postedBy   Employee    @relation("PostingCreator", fields: [postedById], references: [id], onDelete: Restrict)
  applicants Applicant[]

  @@index([status])
  @@index([publishToCareers, status])
  @@map("job_postings")
}

model Applicant {
  id              String         @id @default(uuid()) @map("id")
  jobPostingId    String         @map("job_posting_id")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  email           String         @map("email")
  phone           String?        @map("phone")
  resumeUrl       String?        @map("resume_url")
  coverLetter     String?        @map("cover_letter") @db.Text
  stage           ApplicantStage @default(APPLIED) @map("stage")
  rating          Int?           @map("rating")
  notes           String?        @map("notes") @db.Text
  source          String?        @map("source")
  rejectionReason String?        @map("rejection_reason")
  appliedAt       DateTime       @default(now()) @map("applied_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([jobPostingId])
  @@index([stage])
  @@map("applicants")
}

model Interview {
  id            String          @id @default(uuid()) @map("id")
  applicantId   String          @map("applicant_id")
  interviewerId String?         @map("interviewer_id")
  type          InterviewType   @default(PHONE) @map("type")
  scheduledAt   DateTime        @map("scheduled_at")
  durationMins  Int             @default(60) @map("duration_mins")
  location      String?         @map("location")
  meetingLink   String?         @map("meeting_link")
  result        InterviewResult @default(PENDING) @map("result")
  feedback      String?         @map("feedback") @db.Text
  notes         String?         @map("notes") @db.Text
  rating        Int?            @map("rating")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewer Employee? @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@index([scheduledAt])
  @@map("interviews")
}

// =============================================================================
// M12 - MULTI-SOURCE ATTENDANCE
// =============================================================================

// =============================================================================
// PASSWORD RESET
// =============================================================================

model PasswordReset {
  id         String    @id @default(uuid()) @map("id")
  employeeId String    @map("employee_id")
  token      String    @unique @map("token")
  // bcrypt hash of the 6-digit OTP emailed to the employee. The plaintext OTP
  // is never stored. `token` is only handed to the client AFTER the OTP is
  // verified, so it doubles as the authorization for the final reset step.
  otpHash    String?   @map("otp_hash")
  // Number of failed OTP verification attempts; the row is invalidated after 5.
  attempts   Int       @default(0) @map("attempts")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// =============================================================================
// CAREERS - public careers taxonomy managed in the DNMS, served to the
// marketing site via GET /api/public/careers. 4-level tree:
//   CareerGroup -> CareerSubDepartment -> CareerRole -> CareerOpening
// =============================================================================

enum CareerMode {
  FULL_TIME
  INTERNSHIP
}

enum CareerStatus {
  DRAFT
  PUBLISHED
}

model CareerGroup {
  id        String       @id @default(uuid()) @map("id")
  mode      CareerMode   @map("mode")
  code      String       @map("code")
  title     String       @map("title")
  slug      String       @map("slug")
  jobsLabel String       @map("jobs_label")
  tone      String       @default("teal") @map("tone")
  order     Int          @default(0) @map("order")
  status    CareerStatus @default(DRAFT) @map("status")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  subDepartments CareerSubDepartment[]

  @@unique([mode, slug])
  @@index([mode, status])
  @@map("career_groups")
}

model CareerSubDepartment {
  id        String       @id @default(uuid()) @map("id")
  groupId   String       @map("group_id")
  title     String       @map("title")
  slug      String       @map("slug")
  jobsLabel String       @map("jobs_label")
  tone      String       @default("teal") @map("tone")
  order     Int          @default(0) @map("order")
  status    CareerStatus @default(DRAFT) @map("status")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  group CareerGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles CareerRole[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@map("career_sub_departments")
}

model CareerRole {
  id              String       @id @default(uuid()) @map("id")
  subDepartmentId String       @map("sub_department_id")
  title           String       @map("title")
  slug            String       @map("slug")
  meta            String?      @map("meta")
  summary         String?      @map("summary") @db.Text
  intro           String?      @map("intro") @db.Text
  jobEssence      String?      @map("job_essence") @db.Text
  keyRequirements String[]     @default([]) @map("key_requirements")
  order           Int          @default(0) @map("order")
  status          CareerStatus @default(DRAFT) @map("status")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  subDepartment CareerSubDepartment @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  openings      CareerOpening[]
  applications  CareerApplication[]

  @@unique([subDepartmentId, slug])
  @@index([subDepartmentId])
  @@map("career_roles")
}

// Where a candidate lands in HR's pipeline once they've applied.
enum CareerApplicationStatus {
  RECEIVED
  IN_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

// A careers application posted by the marketing site (server-to-server).
//
// The role is stored TWICE on purpose: as the slugs the site published, and as
// the titles the candidate actually saw. The site serves a cached/snapshotted
// tree, so an application can arrive for a role that was just closed or deleted -
// `careerRoleId` then resolves to null but `roleTitle` still tells HR what the
// person believed they applied to. We never drop the applicant.
model CareerApplication {
  id             String @id @map("id")
  idempotencyKey String @unique @map("idempotency_key")

  mode CareerMode @map("mode")

  // Slugs exactly as published by the read API.
  groupSlug       String  @map("group_slug")
  departmentSlug  String  @map("department_slug")
  roleSlug        String  @map("role_slug")
  // Titles exactly as displayed to the candidate (verbatim, never matched on).
  groupCode       String  @map("group_code")
  departmentTitle String  @map("department_title")
  roleTitle       String  @map("role_title")
  opening         String? @map("opening")

  // Resolved live role - null when the role was closed/deleted before we got here.
  careerRoleId String?     @map("career_role_id")
  careerRole   CareerRole? @relation(fields: [careerRoleId], references: [id], onDelete: SetNull)
  roleResolved Boolean     @default(false) @map("role_resolved")

  fullName  String  @map("full_name")
  email     String  @map("email")
  phone     String  @map("phone")
  linkedIn  String  @map("linked_in")
  portfolio String  @map("portfolio")
  resumeUrl String  @map("resume_url") @db.Text
  message   String? @map("message") @db.Text

  submittedAt DateTime @map("submitted_at")
  sourceUrl   String   @map("source_url") @db.Text

  // Same person + role again with a DIFFERENT idempotency key (a real re-apply,
  // not a network retry).
  isRepeat Boolean @default(false) @map("is_repeat")

  status    CareerApplicationStatus @default(RECEIVED) @map("status")
  hrNotes   String?                 @map("hr_notes") @db.Text
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  // ── Referral ────────────────────────────────────────────────────────────────
  // Employee id EXACTLY as the candidate typed it, kept even when it matches
  // nobody. A typo must never cost a real application, and HR can still see what
  // was meant and fix the link by hand.
  referrerEmployeeNo String?   @map("referrer_employee_no")
  // The resolved referrer. Null = never matched, or the employee record is gone.
  referrerId         String?   @map("referrer_id")
  referrer           Employee? @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  /// Set by HR when a hired applicant is linked to the employee record created
  /// for them. This is what starts the one-year clock on the reward.
  hiredEmployeeId    String?   @map("hired_employee_id")
  hiredEmployee      Employee? @relation("ReferralHire", fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  /// Frozen at payout - the referred employee's salary can change afterwards,
  /// and what was actually paid must not move with it.
  rewardAmount       Decimal?  @map("reward_amount") @db.Decimal(12, 2)
  rewardPaidAt       DateTime? @map("reward_paid_at")
  /// True once the referrer has been told the reward is due, so the eligibility
  /// job does not tell them again every time it runs.
  rewardNotifiedAt   DateTime? @map("reward_notified_at")
  /// Raised inside DNMS by an employee rather than posted by the careers site.
  isInternalReferral Boolean   @default(false) @map("is_internal_referral")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([careerRoleId])
  // Serves "my referrals" and the eligibility sweep.
  @@index([referrerId])
  @@index([hiredEmployeeId])
  @@map("career_applications")
}

model CareerOpening {
  id        String       @id @default(uuid()) @map("id")
  roleId    String       @map("role_id")
  label     String       @map("label")
  order     Int          @default(0) @map("order")
  status    CareerStatus @default(DRAFT) @map("status")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  role CareerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("career_openings")
}

// =============================================================================
// SEO
// =============================================================================
// One SeoProperty per project = the "project config" the automation reads
// (domain, money keywords, competitors, targets, Google property ids). Weekly
// crons write immutable SeoSnapshot rows pulled from Search Console, each with
// its per-query / per-page breakdown, so growth is a diff between snapshots
// rather than a live API call.

model SeoProperty {
  id        String @id @default(uuid()) @map("id")
  // NOT unique: one client project can own many sites. KYG, for example, is a
  // single account with 13 subdomains - same team, same Drive folder, same
  // content calendar - each needing its own Search Console tracking.
  projectId String @map("project_id")

  label     String  @map("label") // "Main site", "Blog", "Careers" …
  isPrimary Boolean @default(false) @map("is_primary")

  domain       String  @map("domain") // bare host, e.g. "digitallynext.com"
  // Search Console property id, exactly as GSC reports it:
  //   "sc-domain:example.com"  (domain property)  or  "https://example.com/"
  siteUrl      String? @map("site_url")
  gaPropertyId String? @map("ga_property_id") // GA4 numeric property id

  moneyKeywords String[] @default([]) @map("money_keywords")
  competitors   String[] @default([]) @map("competitors")
  // The 5-10 pages that actually earn money. Core Web Vitals and technical
  // checks run against these; empty falls back to the top pages by clicks.
  moneyPages    String[] @default([]) @map("money_pages")

  targetClicks   Int?   @map("target_clicks") // monthly organic clicks goal
  targetPosition Float? @map("target_position") // avg position goal for money keywords

  isActive      Boolean   @default(true) @map("is_active")
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastSyncError String?   @map("last_sync_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots        SeoSnapshot[]
  vitals           SeoVitals[]
  traffic          SeoTraffic[]
  scorecards       SeoScorecard[]
  audits           SeoTechnicalAudit[]
  // Work being done for this specific site.
  tasks            ProjectTask[]
  seoKeywords      SeoKeyword[]
  competitorAudits SeoCompetitorAudit[]
  contentBriefs    SeoContentBrief[]
  backlinks        SeoBacklink[]
  monitorRuns      SeoMonitorRun[]

  // The same site must not be tracked twice inside one project.
  @@unique([projectId, domain])
  @@index([projectId])
  @@index([isActive])
  @@map("seo_properties")
}

model SeoSnapshot {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  // Inclusive date window the metrics cover (GSC data lags ~2-3 days).
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  clicks      Int    @default(0) @map("clicks")
  impressions Int    @default(0) @map("impressions")
  ctr         Float  @default(0) @map("ctr") // 0..1
  position    Float  @default(0) @map("position") // average
  source      String @default("GSC") @map("source")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  queries  SeoQueryStat[]
  pages    SeoPageStat[]

  @@unique([propertyId, periodStart, periodEnd])
  @@index([propertyId, periodEnd])
  @@map("seo_snapshots")
}

model SeoQueryStat {
  id         String @id @default(uuid()) @map("id")
  snapshotId String @map("snapshot_id")

  query       String @map("query")
  clicks      Int    @default(0) @map("clicks")
  impressions Int    @default(0) @map("impressions")
  ctr         Float  @default(0) @map("ctr")
  position    Float  @default(0) @map("position")

  snapshot SeoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, clicks])
  @@map("seo_query_stats")
}

model SeoPageStat {
  id         String @id @default(uuid()) @map("id")
  snapshotId String @map("snapshot_id")

  page        String @map("page") @db.Text
  clicks      Int    @default(0) @map("clicks")
  impressions Int    @default(0) @map("impressions")
  ctr         Float  @default(0) @map("ctr")
  position    Float  @default(0) @map("position")

  snapshot SeoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, clicks])
  @@map("seo_page_stats")
}

// Core Web Vitals for one URL. CrUX gives real-user FIELD data (the ranking
// signal) but only for URLs with enough traffic; PSI lab data always answers, so
// we record which source a row came from rather than blending them.
model SeoVitals {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  url        String @map("url") @db.Text
  formFactor String @map("form_factor") // MOBILE | DESKTOP
  source     String @map("source") // CRUX_FIELD | PSI_LAB

  lcpMs            Int?    @map("lcp_ms")
  inpMs            Int?    @map("inp_ms")
  cls              Float?  @map("cls")
  fcpMs            Int?    @map("fcp_ms")
  ttfbMs           Int?    @map("ttfb_ms")
  performanceScore Int?    @map("performance_score") // lab only, 0-100
  /// GOOD | NEEDS_IMPROVEMENT | POOR - the all-three-green verdict.
  verdict          String? @map("verdict")

  checkedAt DateTime @default(now()) @map("checked_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, checkedAt])
  @@map("seo_vitals")
}

// Organic traffic + conversions from GA4 - the half of the scorecard Search
// Console cannot answer ("clicks prove, conversions pay").
model SeoTraffic {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  sessions        Int   @default(0) @map("sessions")
  engagedSessions Int   @default(0) @map("engaged_sessions")
  conversions     Float @default(0) @map("conversions")
  /// Sessions attributed to AI assistants (ChatGPT, Perplexity …) - the plan's
  /// "AI citations + referral traffic" metric.
  aiReferrals     Int   @default(0) @map("ai_referrals")

  source    String   @default("GA4") @map("source")
  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, periodStart, periodEnd])
  @@index([propertyId, periodEnd])
  @@map("seo_traffic")
}

// The monthly weighted scorecard (plan step 10). `coverage` records how much of
// the 100 points could actually be measured, so a score built from Search
// Console alone is never presented as if everything was checked.
model SeoScorecard {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  score    Float  @map("score") // 0-100, normalised over measured weight
  coverage Float  @map("coverage") // 0-100, share of weight measurable
  band     String @map("band") // HEALTHY | WATCH | INTERVENE | ESCALATE
  /// Per-metric breakdown: value, previous, points, weight, available.
  metrics  Json   @map("metrics")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, periodStart, periodEnd])
  @@index([propertyId, periodEnd])
  @@map("seo_scorecards")
}

// One technical-audit run for a site: crawl its money pages + check sitemap and
// robots, then record every issue found. `criticalCount` feeds the scorecard's
// "critical crawl errors" metric. Issues are stored as JSON rather than a child
// table because they are only ever read as a set alongside their parent audit.
model SeoTechnicalAudit {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  pagesChecked  Int @default(0) @map("pages_checked")
  criticalCount Int @default(0) @map("critical_count")
  warningCount  Int @default(0) @map("warning_count")

  // sitemap / robots findings + the per-page results.
  sitemapOk   Boolean @default(false) @map("sitemap_ok")
  robotsOk    Boolean @default(false) @map("robots_ok")
  sitemapUrls Int     @default(0) @map("sitemap_urls")
  /// [{ url, status, issues: [{ level, code, detail }] }]
  pages       Json    @map("pages")
  /// site-level findings (sitemap/robots/canonical host) as [{ level, code, detail }]
  siteIssues  Json    @map("site_issues")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("seo_technical_audits")
}

// A prioritized keyword backlog (plan step 4). Each row is a query worth working
// on, scored by demand x winnability x business value. Rows are generated from
// stored Search Console queries and then refined by a human (winnable? how
// valuable?), so `score` is recomputed whenever the inputs change.
model SeoKeyword {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  query String @map("query")

  // Latest Search Console signals for this query (the demand side).
  impressions Int   @default(0) @map("impressions")
  clicks      Int   @default(0) @map("clicks")
  position    Float @default(0) @map("position")
  ctr         Float @default(0) @map("ctr")

  // Heuristic search intent, editable by a human.
  intent String @default("other") @map("intent") // commercial | informational | branded | navigational | other

  // Where the row came from. GSC rows carry real impression/position data;
  // COMPETITOR rows were mined from a competitor's page titles and headings, so
  // they have no demand data unless the same phrase also shows up in our own
  // Search Console queries. The UI has to say which, or a mined guess would read
  // as a measured fact.
  source       String  @default("GSC") @map("source") // GSC | COMPETITOR | MANUAL
  sourceDomain String? @map("source_domain") // the competitor it was mined from

  // Human judgement. `winnable` is a tri-state stored as nullable Boolean:
  // null = not yet assessed, true/false = a human decided. `businessValue` 1-5.
  winnable      Boolean? @map("winnable")
  businessValue Int      @default(3) @map("business_value")

  // Computed priority (higher = do sooner) and where it is in the pipeline.
  score  Float  @default(0) @map("score")
  status String @default("BACKLOG") @map("status") // BACKLOG | IN_PROGRESS | PUBLISHED | PARKED

  // Optional link to the content task working this keyword.
  taskId String? @map("task_id")
  notes  String? @map("notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, query])
  @@index([propertyId, score])
  @@index([propertyId, status])
  @@index([propertyId, source])
  @@map("seo_keywords")
}

// Competitor gap analysis (plan step 5). Crawls each configured competitor's
// pages, turns their titles/H1s into a topic map, then diffs it against what we
// already cover (our own crawled pages + our Search Console queries + money
// keywords). The gaps are topics they publish for and we don't - the raw
// material for the content backlog. Stored as JSON because a run is only ever
// read as one whole report alongside its parent row.
model SeoCompetitorAudit {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  competitorsChecked Int @default(0) @map("competitors_checked")
  ourPagesChecked    Int @default(0) @map("our_pages_checked")
  gapCount           Int @default(0) @map("gap_count")

  /// per-competitor: [{ domain, ok, pagesCrawled, topics: [{ topic, url, title }] }]
  competitors Json @map("competitors")
  /// the topics they cover and we don't: [{ topic, sampleTitle, competitor, sourceUrl }]
  gaps        Json @map("gaps")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("seo_competitor_audits")
}

// The content loop (plan step 7). One row = one piece of content moving through
// brief -> write -> QA -> publish -> 30-day check. The brief gives the writer a
// SERP-informed outline; the QA gate re-crawls the published URL against the
// on-page checklist; the 30-day check compares the target query's Search Console
// position at publish vs 30 days later, so "did it work?" is answered by data,
// not opinion. Auto-publish is deliberately NOT supported (spam risk).
model SeoContentBrief {
  id         String  @id @default(uuid()) @map("id")
  propertyId String  @map("property_id")
  keywordId  String? @map("keyword_id") // the backlog keyword this works, if any

  targetQuery String @map("target_query")
  intent      String @default("other") @map("intent")

  status String @default("BRIEF") @map("status") // BRIEF | WRITING | REVIEW | PUBLISHED | MEASURED | PARKED

  /// suggested H2 outline: string[]
  outline Json    @map("outline")
  angle   String? @map("angle") @db.Text
  notes   String? @map("notes") @db.Text

  publishedUrl String?   @map("published_url") @db.Text
  publishedAt  DateTime? @map("published_at")

  /// last QA run: { checkedAt, url, pass, score, checks: [{ id, label, ok, detail }] }
  qa Json? @map("qa")

  // 30-day outcome: GSC average position for targetQuery at publish vs at review.
  baselinePosition Float?    @map("baseline_position")
  reviewAt         DateTime? @map("review_at")
  reviewPosition   Float?    @map("review_position")
  reviewOutcome    String?   @map("review_outcome") // WON | FLAT | LOST

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([reviewAt])
  @@map("seo_content_briefs")
}

// Off-page / backlinks (plan step 8). Ahrefs Webmaster Tools and Search Console
// both let you EXPORT your backlinks but have no free API, so a human pastes the
// export and we store + diff it: each import is treated as the current full set,
// so links that vanish are marked LOST and the net-new referring domains feed the
// scorecard. Granularity is one row per linking page; referring-domain counts are
// rolled up from `sourceDomain`.
model SeoBacklink {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  sourceUrl    String  @map("source_url") @db.Text // the page linking to us
  sourceDomain String  @map("source_domain") // its host, for referring-domain counts
  targetUrl    String? @map("target_url") @db.Text // our page it points at
  anchor       String? @map("anchor") @db.Text
  domainRating Int?    @map("domain_rating") // optional authority (AWT DR / Moz DA)

  source String @default("MANUAL") @map("source") // AWT | GSC | MANUAL
  status String @default("ACTIVE") @map("status") // ACTIVE | LOST

  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @default(now()) @map("last_seen")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, sourceUrl])
  @@index([propertyId, status])
  @@index([propertyId, sourceDomain])
  @@index([propertyId, firstSeen])
  @@map("seo_backlinks")
}

// Daily accident monitor (plan step 9). One row per property per daily run,
// recording whether its money pages are up + indexable and robots.txt isn't
// blocking. Kept as history so the cron can alert only on a CHANGE (page went
// down / came back), not spam the same broken state every day.
model SeoMonitorRun {
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  status     String @map("status") // OK | ISSUES
  pagesOk    Int    @default(0) @map("pages_ok")
  pagesTotal Int    @default(0) @map("pages_total")
  /// [{ url, level, code, detail }] - only real accidents (down / noindex / robots block)
  issues     Json   @map("issues")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("seo_monitor_runs")
}

// =============================================================================
// CLIENT PORTAL
// =============================================================================
// External client accounts. Deliberately a SEPARATE table from Employee: an
// Employee carries payroll, attendance, leave and org-chart relations that make
// no sense for a client, and dozens of existing queries assume "a row here is
// staff". Keeping clients out of that table means no existing HR query can ever
// return one. Their session is tagged kind:"client" (see server/auth.ts) and is
// rejected by every staff guard.
//
// What a client may see is DENY BY DEFAULT: nothing is visible until an employee
// grants them access to a specific project with a specific package. Two client
// emails on the SAME project can hold different packages and therefore see
// different data - that is the whole point of the per-grant package.
// =============================================================================

enum ClientAccessStatus {
  ACTIVE
  SUSPENDED
}

model ClientUser {
  id           String  @id @default(uuid()) @map("id")
  email        String  @unique @map("email")
  name         String  @map("name")
  phone        String? @map("phone")
  /// The client's own company/brand, shown in the portal header.
  company      String? @map("company")
  /// Null until they set one via the invite flow. Never selected by default
  /// (see server/db.ts omit list) - only the credentials provider opts back in.
  passwordHash String? @map("password_hash")

  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy Employee?             @relation("ClientUserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  access    ClientProjectAccess[]
  activity  ClientActivityLog[]

  @@index([isActive])
  @@map("client_users")
}

/// What a CLIENT did in the portal.
///
/// Separate from `audit_logs` on purpose, not by accident: `AuditLog.actorId` is
/// a foreign key to `employees`, so a client id written there is rejected by the
/// database. Widening that column to "either kind of actor" would give up the FK
/// entirely and let any string be an actor, so client activity gets its own table
/// with its own real foreign key instead.
///
/// Shown to the client themselves (portal → Activity) AND to staff, which is why
/// `summary` is written in plain language at the time of the action - a log
/// nobody can read is a log nobody checks.
model ClientActivityLog {
  id           String  @id @default(uuid()) @map("id")
  clientUserId String  @map("client_user_id")
  /// Null for account-level actions (sign-in, password change) that belong to no
  /// single project.
  projectId    String? @map("project_id")

  action     String  @map("action")
  module     String  @map("module")
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  /// Human-readable line, e.g. 'Sent campaign "Diwali Preview" to 311 recipients'.
  summary    String? @map("summary")
  changes    Json?   @map("changes")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientUserId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@map("client_activity_logs")
}

/// A reusable bundle of portal modules ("Shopify only", "Marketplace + SEO",
/// "Full suite"). `modules` holds keys from the module registry in
/// features/client-portal/modules.ts - anything not listed there is ignored at
/// read time, so a stale key can never widen access.
/// The grant: THIS client user, on THIS project, sees THESE modules.
/// One row per (user, project) - a user with no row for a project cannot see it
/// exists. Modules are stored PER GRANT rather than via a shared package, so two
/// client emails on the same project can be given different sections, and
/// changing one client never moves anyone else.
model ClientProjectAccess {
  id           String             @id @default(uuid()) @map("id")
  clientUserId String             @map("client_user_id")
  projectId    String             @map("project_id")
  /// Keys from the module registry (features/client-portal/modules.ts). Anything
  /// not in the registry is ignored at read time, so a stale key narrows access
  /// rather than widening it.
  modules      String[]           @map("modules")
  status       ClientAccessStatus @default(ACTIVE) @map("status")
  grantedById  String?            @map("granted_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grantedBy  Employee?  @relation("ClientAccessGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([clientUserId, projectId])
  @@index([projectId])
  @@map("client_project_access")
}

// =============================================================================
// MARKETPLACE / PRODUCT CATALOG
// =============================================================================
// The storage layer behind the product dashboard. Provider-agnostic on purpose:
// Shopify is the first channel, but Amazon/Flipkart/etc. differ only by
// `provider` and the credential blob. The actual per-provider SYNC lives
// separately - this schema is what both the sync and the client portal read.
// =============================================================================

enum MarketplaceProvider {
  SHOPIFY
  AMAZON
  FLIPKART
  MEESHO
  MYNTRA
  WOOCOMMERCE
  OTHER
}

model MarketplaceChannel {
  id         String              @id @default(uuid()) @map("id")
  projectId  String              @map("project_id")
  provider   MarketplaceProvider @map("provider")
  /// Display name ("Rudione Shopify (IN)") - several channels of one provider
  /// can belong to one project (multiple storefronts / regions).
  name       String              @map("name")
  /// The provider's own account handle - shop domain, seller id, etc.
  externalId String?             @map("external_id")

  /// Provider credentials, ENCRYPTED with lib/crypto. Never leaves the server
  /// and is never exposed on any portal route.
  credentials   String?   @map("credentials") @db.Text
  status        String    @default("pending") @map("status") // "connected" | "pending" | "error"
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastSyncError String?   @map("last_sync_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([projectId, provider, name])
  @@index([projectId])
  @@map("marketplace_channels")
}

model Product {
  id         String  @id @default(uuid()) @map("id")
  projectId  String  @map("project_id")
  /// Null for a product entered manually rather than synced from a channel.
  channelId  String? @map("channel_id")
  /// The provider's product id, used to upsert on re-sync.
  externalId String? @map("external_id")

  title       String  @map("title")
  sku         String? @map("sku")
  description String? @map("description") @db.Text
  imageUrl    String? @map("image_url")
  vendor      String? @map("vendor")
  category    String? @map("category")

  price          Decimal? @map("price") @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  currency       String   @default("INR") @map("currency")
  inventoryQty   Int?     @map("inventory_qty")

  /// Provider-native status, normalised to lower case ("active" | "draft" |
  /// "archived") so the portal can filter without knowing the provider.
  status String   @default("active") @map("status")
  tags   String[] @map("tags")
  /// Public storefront/listing URL, so the client can open the live product.
  url    String?  @map("url")

  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel MarketplaceChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([channelId, externalId])
  @@index([projectId, status])
  @@index([projectId, title])
  @@map("products")
}

// =============================================================================
// MONITORING - uptime + renewals
// =============================================================================
// Built after a domain auto-renewal silently failed: the registrar retried and
// failed for six days with nobody acting on it, then the site was down for
// eleven hours before anyone noticed, because order flow was the only thing
// anyone was watching. Orders stopping is a LAGGING indicator - by the time it
// tells you the site is down, you have already lost the revenue.
//
// Two independent controls, because that outage was two separate failures:
//   ProjectAsset   - what expires, when, and WHOSE job it is (catches it early)
//   UptimeMonitor  - is it actually serving right now (caps the damage)
// =============================================================================

enum MonitoredAssetKind {
  DOMAIN
  SSL
  HOSTING
  LICENSE
  OTHER
}

/// A thing that expires and will take the site down if it lapses.
model ProjectAsset {
  id        String             @id @default(uuid()) @map("id")
  projectId String             @map("project_id")
  kind      MonitoredAssetKind @default(DOMAIN) @map("kind")
  /// "digitallynext.com", "Shopify Plan", "*.example.com SSL".
  name      String             @map("name")
  /// Registrar / host / vendor: "GoDaddy", "Cloudflare".
  provider  String?            @map("provider")
  /// Where to go and fix it at 11pm.
  url       String?            @map("url")

  expiresAt DateTime @map("expires_at") @db.Date
  /// Auto-renew being ON is NOT safety - this incident had it on. It only
  /// changes what the reminder says, never whether one is sent.
  autoRenew Boolean  @default(true) @map("auto_renew")

  /// The card/account that pays for it, and when THAT expires - the actual root
  /// cause of a "failed auto-renewal" is nearly always a dead payment method.
  paymentMethod    String?   @map("payment_method")
  paymentExpiresAt DateTime? @map("payment_expires_at") @db.Date

  /// The named human accountable for this renewal. Null means nobody owns it,
  /// which the register surfaces as a problem in itself.
  ownerId String? @map("owner_id")
  notes   String? @map("notes") @db.Text

  /// Which reminder threshold was last sent (60/30/14/7/3/1/0), so the daily job
  /// nudges once per stage instead of every morning.
  lastAlertStage  Int?      @map("last_alert_stage")
  lastAlertAt     DateTime? @map("last_alert_at")
  /// Separate from lastAlertAt so a card warning and a renewal warning don't
  /// suppress each other. Both exist so the sweep can run hourly and still
  /// emit at most one of each per day.
  lastCardAlertAt DateTime? @map("last_card_alert_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   Employee? @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([expiresAt])
  @@map("project_assets")
}

enum UptimeState {
  UNKNOWN
  UP
  DOWN
}

model UptimeMonitor {
  id        String  @id @default(uuid()) @map("id")
  projectId String  @map("project_id")
  url       String  @map("url")
  label     String? @map("label")
  isActive  Boolean @default(true) @map("is_active")

  state                UptimeState @default(UNKNOWN) @map("state")
  lastCheckedAt        DateTime?   @map("last_checked_at")
  lastStatusCode       Int?        @map("last_status_code")
  lastError            String?     @map("last_error")
  /// A single timeout is noise; N in a row is an outage. Both counters exist so
  /// the state only flips after confirmation in either direction.
  consecutiveFailures  Int         @default(0) @map("consecutive_failures")
  consecutiveSuccesses Int         @default(0) @map("consecutive_successes")

  /// Who gets told first. Falls back to the project's Account Manager.
  ownerId String? @map("owner_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     Employee?        @relation("MonitorOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  incidents UptimeIncident[]

  @@unique([projectId, url])
  @@index([isActive])
  @@map("uptime_monitors")
}

/// One outage, start to finish. Kept as history so "how long were we down" has
/// an answer that isn't someone's memory.
model UptimeIncident {
  id         String    @id @default(uuid()) @map("id")
  monitorId  String    @map("monitor_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  statusCode Int?      @map("status_code")
  detail     String?   @map("detail") @db.Text

  /// Acknowledgement stops the escalation ladder. An alert nobody must ack is
  /// how six days of registrar emails got ignored.
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id")

  /// 0 = owner told, 1 = their manager, 2 = admins.
  escalationLevel Int       @default(0) @map("escalation_level")
  lastEscalatedAt DateTime? @map("last_escalated_at")

  monitor        UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  acknowledgedBy Employee?     @relation("IncidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([monitorId, startedAt])
  @@index([endedAt])
  @@map("uptime_incidents")
}

// =============================================================================
// PROJECT MAILER
// =============================================================================
// Per-project outbound email: its own SMTP account, its own templates, its own
// recipient list, and bulk campaigns sent from the client's OWN domain rather
// than ours. A client's newsletter going out from noreply@digitallynext.com
// looks like spam to their subscribers and burns OUR sending reputation when it
// bounces.
//
// Sending is QUEUED, never done in the request: one row per recipient in
// ProjectCampaignSend, drained by the in-process scheduler in small batches.
// A 2,000-recipient blast cannot be an HTTP request - it would time out halfway
// and nobody would know which half went.
// =============================================================================

model ProjectMailer {
  id        String @id @default(uuid()) @map("id")
  projectId String @map("project_id")
  /// A project can hold SEVERAL sending accounts - transactional vs newsletter,
  /// or one per brand - and the campaign picks which to send from. This is the
  /// label that picker shows.
  name      String @map("name")

  /// What recipients see in the From line.
  fromName  String  @map("from_name")
  fromEmail String  @map("from_email")
  /// Where replies go, when it isn't the From address.
  replyTo   String? @map("reply_to")

  host     String  @map("host")
  port     Int     @default(587) @map("port")
  secure   Boolean @default(false) @map("secure")
  username String  @map("username")
  /// ENCRYPTED with lib/crypto. Never selected into an API response.
  password String  @map("password") @db.Text

  isActive Boolean @default(true) @map("is_active")

  /// Result of the last "send test email", so the screen can show whether these
  /// credentials have ever actually worked rather than just that they're filled in.
  lastVerifiedAt DateTime? @map("last_verified_at")
  lastError      String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaigns ProjectCampaign[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_mailers")
}

model ProjectMailerAsset {
  id          String @id @default(uuid()) @map("id")
  projectId   String @map("project_id")
  /// The B2 object. Served through a PUBLIC route: an email client fetches
  /// images with no cookies, so the private signed-redirect used elsewhere in
  /// the app cannot work here. The uuid id is the only thing guarding it.
  objectKey   String @map("object_key")
  fileName    String @map("file_name")
  contentType String @map("content_type")
  size        Int    @map("size")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy Employee? @relation("MailerAssetAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_mailer_assets")
}

model ProjectEmailTemplate {
  id        String        @id @default(uuid()) @map("id")
  projectId String        @map("project_id")
  name      String        @map("name")
  subject   String        @map("subject")
  /// Always HTML on the wire -  only records which editor authored it,
  /// so reopening a rich-text template does not drop you into raw markup.
  bodyHtml  String        @map("body_html") @db.Text
  bodyMode  EmailBodyMode @default(RICH) @map("body_mode")
  isActive  Boolean       @default(true) @map("is_active")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy Employee?         @relation("ProjectTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  campaigns ProjectCampaign[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_email_templates")
}

model ProjectRecipient {
  id        String   @id @default(uuid()) @map("id")
  projectId String   @map("project_id")
  email     String   @map("email")
  name      String?  @map("name")
  company   String?  @map("company")
  /// Free-form segments ("newsletter", "vip") so a campaign can target a slice.
  tags      String[] @map("tags")
  /// Arbitrary merge data: { "plan": "Pro", "renewal": "12 Sep" }. Templates can
  /// reference ANY key - unknown ones render empty rather than leaking {{raw}},
  /// so a template never has to be kept in sync with the list.
  fields    Json?    @map("fields")

  /// Unsubscribes are permanent and checked at SEND time, not just at list time -
  /// somebody who opts out mid-campaign must not receive the rest of it.
  isSubscribed   Boolean   @default(true) @map("is_subscribed")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sends   ProjectCampaignSend[]

  @@unique([projectId, email])
  @@index([projectId, isSubscribed])
  @@map("project_recipients")
}

enum EmailBodyMode {
  /// Composed in the WYSIWYG editor.
  RICH
  /// Hand-written HTML.
  HTML
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model ProjectCampaign {
  id         String         @id @default(uuid()) @map("id")
  projectId  String         @map("project_id")
  templateId String?        @map("template_id")
  /// Which SMTP account this campaign sends from. Snapshotted at queue time so
  /// the runner does not have to guess if the project gains another account.
  mailerId   String?        @map("mailer_id")
  name       String         @map("name")
  subject    String         @map("subject")
  bodyHtml   String         @map("body_html") @db.Text
  bodyMode   EmailBodyMode  @default(RICH) @map("body_mode")
  status     CampaignStatus @default(DRAFT) @map("status")

  /// Snapshotted at queue time so progress is stable even if recipients change.
  totalCount  Int @default(0) @map("total_count")
  sentCount   Int @default(0) @map("sent_count")
  failedCount Int @default(0) @map("failed_count")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template  ProjectEmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mailer    ProjectMailer?        @relation(fields: [mailerId], references: [id], onDelete: SetNull)
  createdBy Employee?             @relation("CampaignAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  sends     ProjectCampaignSend[]

  @@index([projectId, createdAt])
  @@index([status])
  @@map("project_campaigns")
}

/// One row per recipient per campaign: the send log AND the work queue.
/// Being a real row is what makes a half-finished blast recoverable - the
/// scheduler just picks up whatever is still PENDING.
model ProjectCampaignSend {
  id          String  @id @default(uuid()) @map("id")
  campaignId  String  @map("campaign_id")
  recipientId String? @map("recipient_id")
  /// Denormalised: the address actually used, even if the recipient is later deleted.
  email       String  @map("email")
  name        String? @map("name")

  status String    @default("PENDING") @map("status") // PENDING | SENT | FAILED
  error  String?   @map("error") @db.Text
  sentAt DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  campaign  ProjectCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient ProjectRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([status])
  @@map("project_campaign_sends")
}
