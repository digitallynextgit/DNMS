/// One row per stretch a task spent in one status; the open row (endedAt = null) is the current status.
model TaskStatusPeriod {
  tenantId        String     @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id              String     @id @default(uuid()) @map("id")
  taskId          String     @map("task_id")
  status          TaskStatus @map("status")
  /// Null for the backdated first row.
  actorId         String?    @map("actor_id")
  startedAt       DateTime   @map("started_at")
  endedAt         DateTime?  @map("ended_at")
  durationSeconds Int?       @map("duration_seconds")
  /// Hold/discard reason, kept per period because the task only stores its current one.
  note            String?    @map("note") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")

  task  ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
