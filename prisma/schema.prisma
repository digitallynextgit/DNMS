model ProjectTask {
  tenantId         String             @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id               String             @id @default(uuid()) @map("id")
  // Null = ADHOC work with no client (meetings, interviews, internal QC): no project, no team, and the
  // assignee's line manager stands in for the team manager.
  projectId        String?            @map("project_id")
  teamId           String?            @map("team_id") // v2 - null for legacy tasks and adhoc work
  title            String             @map("title")
  description      String?            @map("description") @db.Text
  status           TaskStatus         @default(TODO) @map("status")
  priority         TaskPriority       @default(MEDIUM) @map("priority")
  assigneeId       String?            @map("assignee_id")
  creatorId        String             @map("creator_id")
  startDate        DateTime?          @map("start_date") @db.Date
  dueDate          DateTime?          @map("due_date") @db.Date
  completedAt      DateTime?          @map("completed_at")
  estimatedHours   Float?             @map("estimated_hours")
  loggedHours      Float              @default(0) @map("logged_hours")
  // Non-null = the clock is running. Set on entering IN_PROGRESS; the time until it leaves is added to loggedHours.
  inProgressSince  DateTime?          @map("in_progress_since")
  tags             String[]           @map("tags")
  // Where the work lives: the brief, the doc, the published page.
  links            String[]           @map("links")
  // Nothing writes PENDING_APPROVAL now (tasks are self-service); kept for old REJECTED rows, which views hide.
  approvalStatus   TaskApprovalStatus @default(APPROVED) @map("approval_status")
  // Raised by a manager/admin for someone else. Informational only.
  isManagerCreated Boolean            @default(true) @map("is_manager_created")
  rejectionReason  String?            @map("rejection_reason")
  // ON_HOLD needs a reason + expected resume date; DISCARDED needs a reason.
  holdReason       String?            @map("hold_reason") @db.Text
  holdExpectedDate DateTime?          @map("hold_expected_date") @db.Date
  discardReason    String?            @map("discard_reason") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  isMilestone Boolean @default(false) @map("is_milestone")

  // Which tracked site (e.g. one subdomain) this work is for. Null = the project as a whole.
  seoPropertyId String? @map("seo_property_id")

  // Set while waiting on a ProjectRequirement; cleared when it is resolved.
  requirementId String? @map("requirement_id")

  // The task this follow-up was spawned from when that one went ON_HOLD (its unfinished hours move here).
  // Holding the same task again updates this follow-up instead of creating another.
  resumedFromId String? @map("resumed_from_id")

  // The goal (or milestone) this work serves; a goal's progress derives from its tasks. Nullable on purpose:
  // unlinked tasks are flagged to the manager instead of forcing junk goals.
  goalId          String?   @map("goal_id")
  // Whether a deliverable is expected. Defaults from the team's nature; finishing without one nudges, never blocks.
  producesOutput  Boolean   @default(true) @map("produces_output")
  // "Done, nothing to log" - stops the capture prompt. Cleared when a deliverable is logged or the task leaves DONE.
  outputSkippedAt DateTime? @map("output_skipped_at")

  project        Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seoProperty    SeoProperty?          @relation(fields: [seoPropertyId], references: [id], onDelete: SetNull)
  requirement    ProjectRequirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  // SetNull: deleting the held task must not take the follow-up (and its hours) with it.
  resumedFrom    ProjectTask?          @relation("TaskResume", fields: [resumedFromId], references: [id], onDelete: SetNull)
  resumeTasks    ProjectTask[]         @relation("TaskResume")
  goal           ProjectGoal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  team           ProjectTeam?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee       Employee?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        Employee              @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  timesheets     Timesheet[]
  comments       TaskComment[]
  checklistItems TaskChecklistItem[]
  statusPeriods  TaskStatusPeriod[]
  reminderStates TaskReminderState[]
  contentEntry   ContentCalendarEntry?
  deliverables   ProjectDeliverable[]

  @@index([projectId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([approvalStatus])
  @@index([resumedFromId])
  @@index([goalId])
  @@index([assigneeId, dueDate])
  @@index([projectId, dueDate])
  @@index([projectId, status])
  @@index([tenantId])
  @@map("project_tasks")
}

model TaskComment {
  tenantId  String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String   @id @default(uuid()) @map("id")
