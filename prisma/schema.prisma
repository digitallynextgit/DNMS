model Applicant {
  tenantId        String         @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id              String         @id @default(uuid()) @map("id")
  jobPostingId    String         @map("job_posting_id")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  email           String         @map("email")
  phone           String?        @map("phone")
  // B2 object key for the CV. Signed URLs die after 7 days (B2's cap), so a fresh one is minted from this on read.
  resumeKey       String?        @map("resume_key")
  resumeUrl       String?        @map("resume_url")
  coverLetter     String?        @map("cover_letter") @db.Text
  stage           ApplicantStage @default(APPLIED) @map("stage")
  rating          Int?           @map("rating")
  notes           String?        @map("notes") @db.Text
  source          String?        @map("source")
  rejectionReason String?        @map("rejection_reason")
  appliedAt       DateTime       @default(now()) @map("applied_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([jobPostingId])
  @@index([stage])
  @@index([tenantId])
  @@map("applicants")
}

model Interview {
  tenantId      String          @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id            String          @id @default(uuid()) @map("id")
  applicantId   String          @map("applicant_id")
  interviewerId String?         @map("interviewer_id")
  type          InterviewType   @default(PHONE) @map("type")
  scheduledAt   DateTime        @map("scheduled_at")
  durationMins  Int             @default(60) @map("duration_mins")
  location      String?         @map("location")
  meetingLink   String?         @map("meeting_link")
  result        InterviewResult @default(PENDING) @map("result")
  feedback      String?         @map("feedback") @db.Text
  notes         String?         @map("notes") @db.Text
  rating        Int?            @map("rating")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewer Employee? @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@index([scheduledAt])
  @@index([tenantId])
  @@map("interviews")
}

model PasswordReset {
  id         String    @id @default(uuid()) @map("id")
  /// The platform identity resetting, so portal clients can reset too.
  userId     String    @map("user_id")
  /// Legacy: still written for staff resets so the older deployed build keeps working. Null for a client reset.
  employeeId String?   @map("employee_id")
  token      String    @unique @map("token")
  // bcrypt hash of the emailed 6-digit OTP. `token` is only returned after the OTP verifies, so it also
  // authorizes the final reset step.
  otpHash    String?   @map("otp_hash")
  // Number of failed OTP verification attempts; the row is invalidated after 5.
  attempts   Int       @default(0) @map("attempts")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// Public careers taxonomy served via GET /api/public/careers:
// CareerGroup -> CareerSubDepartment -> CareerRole -> CareerOpening.

enum CareerMode {
  FULL_TIME
  INTERNSHIP
}

enum CareerStatus {
  DRAFT
  PUBLISHED
}

model CareerGroup {
  tenantId  String       @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String       @id @default(uuid()) @map("id")
  mode      CareerMode   @map("mode")
  code      String       @map("code")
  title     String       @map("title")
  slug      String       @map("slug")
  jobsLabel String       @map("jobs_label")
  tone      String       @default("teal") @map("tone")
  order     Int          @default(0) @map("order")
  status    CareerStatus @default(DRAFT) @map("status")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  subDepartments CareerSubDepartment[]

  @@unique([tenantId, mode, slug])
  @@index([mode, status])
  @@index([tenantId])
  @@map("career_groups")
}

model CareerSubDepartment {
  tenantId  String       @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String       @id @default(uuid()) @map("id")
  groupId   String       @map("group_id")
  title     String       @map("title")
  slug      String       @map("slug")
  jobsLabel String       @map("jobs_label")
  tone      String       @default("teal") @map("tone")
  order     Int          @default(0) @map("order")
  status    CareerStatus @default(DRAFT) @map("status")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  group CareerGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles CareerRole[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([tenantId])
  @@map("career_sub_departments")
}

model CareerRole {
  tenantId        String       @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id              String       @id @default(uuid()) @map("id")
  subDepartmentId String       @map("sub_department_id")
  title           String       @map("title")
  slug            String       @map("slug")
  meta            String?      @map("meta")
  summary         String?      @map("summary") @db.Text
  intro           String?      @map("intro") @db.Text
  jobEssence      String?      @map("job_essence") @db.Text
  keyRequirements String[]     @default([]) @map("key_requirements")
  order           Int          @default(0) @map("order")
  status          CareerStatus @default(DRAFT) @map("status")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  subDepartment CareerSubDepartment @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  openings      CareerOpening[]
  applications  CareerApplication[]

  @@unique([subDepartmentId, slug])
  @@index([subDepartmentId])
  @@index([tenantId])
  @@map("career_roles")
}

enum CareerApplicationStatus {
  RECEIVED
  IN_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

// A careers application posted by the marketing site. The role is stored as slugs AND as the titles shown, so an
// application for a since-closed role (careerRoleId null) still tells HR what was applied for.
model CareerApplication {
  tenantId       String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id             String @id @map("id")
  idempotencyKey String @unique @map("idempotency_key")

  mode CareerMode @map("mode")

  groupSlug       String  @map("group_slug")
  departmentSlug  String  @map("department_slug")
  roleSlug        String  @map("role_slug")
  groupCode       String  @map("group_code")
  departmentTitle String  @map("department_title")
  roleTitle       String  @map("role_title")
  opening         String? @map("opening")

  careerRoleId String?     @map("career_role_id")
  careerRole   CareerRole? @relation(fields: [careerRoleId], references: [id], onDelete: SetNull)
  roleResolved Boolean     @default(false) @map("role_resolved")

  fullName  String  @map("full_name")
  email     String  @map("email")
  phone     String  @map("phone")
  linkedIn  String  @map("linked_in")
  portfolio String  @map("portfolio")
  resumeUrl String  @map("resume_url") @db.Text
  /// B2 key of OUR copy of the CV (resumeUrl is an external link that can vanish). Null = the best-effort copy failed.
  resumeKey String? @map("resume_key")
  message   String? @map("message") @db.Text

  submittedAt DateTime @map("submitted_at")
  sourceUrl   String   @map("source_url") @db.Text

  // Same person + role again with a different idempotency key (a real re-apply, not a retry).
  isRepeat Boolean @default(false) @map("is_repeat")

  status    CareerApplicationStatus @default(RECEIVED) @map("status")
  hrNotes   String?                 @map("hr_notes") @db.Text
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  // Referrer's employee no. exactly as typed, kept even if it matches nobody so HR can fix the link.
  referrerEmployeeNo String?   @map("referrer_employee_no")
  referrerId         String?   @map("referrer_id")
  referrer           Employee? @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  /// Set by HR when a hired applicant is linked to their new employee record; starts the one-year reward clock.
  hiredEmployeeId    String?   @map("hired_employee_id")
  hiredEmployee      Employee? @relation("ReferralHire", fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  /// Frozen at payout, so later salary changes don't move it.
  rewardAmount       Decimal?  @map("reward_amount") @db.Decimal(12, 2)
  rewardPaidAt       DateTime? @map("reward_paid_at")
  /// Set once the referrer is told the reward is due, so the eligibility job doesn't repeat it.
  rewardNotifiedAt   DateTime? @map("reward_notified_at")
  /// Raised inside DNMS by an employee rather than posted by the careers site.
  isInternalReferral Boolean   @default(false) @map("is_internal_referral")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([careerRoleId])
  @@index([referrerId])
  @@index([hiredEmployeeId])
  @@index([tenantId])
  @@map("career_applications")
}

model CareerOpening {
  tenantId  String       @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String       @id @default(uuid()) @map("id")
  roleId    String       @map("role_id")
  label     String       @map("label")
  order     Int          @default(0) @map("order")
  status    CareerStatus @default(DRAFT) @map("status")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  role CareerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([tenantId])
  @@map("career_openings")
}

// SEO: one SeoProperty per tracked site. Weekly crons write immutable SeoSnapshot rows from Search Console,
// so growth is a diff between snapshots.
model SeoProperty {
  tenantId  String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String @id @default(uuid()) @map("id")
  // NOT unique: one project can own many sites (e.g. KYG has 13 subdomains).
  projectId String @map("project_id")

  label     String  @map("label") // "Main site", "Blog", "Careers" …
  isPrimary Boolean @default(false) @map("is_primary")

  domain       String  @map("domain") // bare host, e.g. "digitallynext.com"
  // Search Console property id as GSC reports it: "sc-domain:example.com" or "https://example.com/".
  siteUrl      String? @map("site_url")
  gaPropertyId String? @map("ga_property_id") // GA4 numeric property id

  moneyKeywords String[] @default([]) @map("money_keywords")
  competitors   String[] @default([]) @map("competitors")
  // The 5-10 pages that earn money; CWV and technical checks run on these (empty = top pages by clicks).
  moneyPages    String[] @default([]) @map("money_pages")

  targetClicks   Int?   @map("target_clicks") // monthly organic clicks goal
  targetPosition Float? @map("target_position") // avg position goal for money keywords

  isActive      Boolean   @default(true) @map("is_active")
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastSyncError String?   @map("last_sync_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots        SeoSnapshot[]
  vitals           SeoVitals[]
  traffic          SeoTraffic[]
  scorecards       SeoScorecard[]
  audits           SeoTechnicalAudit[]
  tasks            ProjectTask[]
  seoKeywords      SeoKeyword[]
  competitorAudits SeoCompetitorAudit[]
  contentBriefs    SeoContentBrief[]
  backlinks        SeoBacklink[]
  monitorRuns      SeoMonitorRun[]

  @@unique([projectId, domain])
  @@index([projectId])
  @@index([isActive])
  @@index([tenantId])
  @@map("seo_properties")
}

model SeoSnapshot {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  // Inclusive date window the metrics cover (GSC data lags ~2-3 days).
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  clicks      Int    @default(0) @map("clicks")
  impressions Int    @default(0) @map("impressions")
  ctr         Float  @default(0) @map("ctr") // 0..1
  position    Float  @default(0) @map("position") // average
  source      String @default("GSC") @map("source")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  queries  SeoQueryStat[]
  pages    SeoPageStat[]

  @@unique([propertyId, periodStart, periodEnd])
  @@index([propertyId, periodEnd])
  @@index([tenantId])
  @@map("seo_snapshots")
}

model SeoQueryStat {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  snapshotId String @map("snapshot_id")

  query       String @map("query")
  clicks      Int    @default(0) @map("clicks")
  impressions Int    @default(0) @map("impressions")
  ctr         Float  @default(0) @map("ctr")
  position    Float  @default(0) @map("position")

  snapshot SeoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, clicks])
  @@index([tenantId])
  @@map("seo_query_stats")
}

model SeoPageStat {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  snapshotId String @map("snapshot_id")

  page        String @map("page") @db.Text
  clicks      Int    @default(0) @map("clicks")
  impressions Int    @default(0) @map("impressions")
  ctr         Float  @default(0) @map("ctr")
  position    Float  @default(0) @map("position")

  snapshot SeoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([snapshotId, clicks])
  @@index([tenantId])
  @@map("seo_page_stats")
}

// Core Web Vitals for one URL: CrUX field data when there's enough traffic, else PSI lab data; `source` says which.
model SeoVitals {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  url        String @map("url") @db.Text
  formFactor String @map("form_factor") // MOBILE | DESKTOP
  source     String @map("source") // CRUX_FIELD | PSI_LAB

  lcpMs            Int?    @map("lcp_ms")
  inpMs            Int?    @map("inp_ms")
  cls              Float?  @map("cls")
  fcpMs            Int?    @map("fcp_ms")
  ttfbMs           Int?    @map("ttfb_ms")
  performanceScore Int?    @map("performance_score") // lab only, 0-100
  /// GOOD | NEEDS_IMPROVEMENT | POOR - the all-three-green verdict.
  verdict          String? @map("verdict")

  checkedAt DateTime @default(now()) @map("checked_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, checkedAt])
  @@index([tenantId])
  @@map("seo_vitals")
}

// Organic traffic + conversions from GA4 (what Search Console can't answer).
model SeoTraffic {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  sessions        Int   @default(0) @map("sessions")
  engagedSessions Int   @default(0) @map("engaged_sessions")
  conversions     Float @default(0) @map("conversions")
  /// Sessions referred by AI assistants (ChatGPT, Perplexity...).
  aiReferrals     Int   @default(0) @map("ai_referrals")

  source    String   @default("GA4") @map("source")
  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, periodStart, periodEnd])
  @@index([propertyId, periodEnd])
  @@index([tenantId])
  @@map("seo_traffic")
}

// Monthly weighted scorecard. `coverage` is how much of the 100 points could actually be measured.
model SeoScorecard {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  score    Float  @map("score") // 0-100, normalised over measured weight
  coverage Float  @map("coverage") // 0-100, share of weight measurable
  band     String @map("band") // HEALTHY | WATCH | INTERVENE | ESCALATE
  /// Per-metric breakdown: value, previous, points, weight, available.
  metrics  Json   @map("metrics")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, periodStart, periodEnd])
  @@index([propertyId, periodEnd])
  @@index([tenantId])
  @@map("seo_scorecards")
}

// One technical-audit run: money pages crawled, sitemap/robots checked. Issues are JSON (always read as a set).
model SeoTechnicalAudit {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  pagesChecked  Int @default(0) @map("pages_checked")
  criticalCount Int @default(0) @map("critical_count")
  warningCount  Int @default(0) @map("warning_count")

  sitemapOk   Boolean @default(false) @map("sitemap_ok")
  robotsOk    Boolean @default(false) @map("robots_ok")
  sitemapUrls Int     @default(0) @map("sitemap_urls")
  /// [{ url, status, issues: [{ level, code, detail }] }]
  pages       Json    @map("pages")
  /// site-level findings (sitemap/robots/canonical host) as [{ level, code, detail }]
  siteIssues  Json    @map("site_issues")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([tenantId])
  @@map("seo_technical_audits")
}

// Prioritized keyword backlog: score = demand x winnability x business value, recomputed when inputs change.
model SeoKeyword {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  query String @map("query")

  impressions Int   @default(0) @map("impressions")
  clicks      Int   @default(0) @map("clicks")
  position    Float @default(0) @map("position")
  ctr         Float @default(0) @map("ctr")

  intent String @default("other") @map("intent") // commercial | informational | branded | navigational | other

  // GSC rows carry real demand data; COMPETITOR rows are mined from competitor pages and have none,
  // so the UI must say which.
  source       String  @default("GSC") @map("source") // GSC | COMPETITOR | MANUAL
  sourceDomain String? @map("source_domain") // the competitor it was mined from

  // winnable: null = not yet assessed. businessValue is 1-5.
  winnable      Boolean? @map("winnable")
  businessValue Int      @default(3) @map("business_value")

  // Higher score = do sooner.
  score  Float  @default(0) @map("score")
  status String @default("BACKLOG") @map("status") // BACKLOG | IN_PROGRESS | PUBLISHED | PARKED

  taskId String? @map("task_id")
  notes  String? @map("notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, query])
  @@index([propertyId, score])
  @@index([propertyId, status])
  @@index([propertyId, source])
  @@index([tenantId])
  @@map("seo_keywords")
}

// Competitor gap analysis: topics competitors publish for and we don't. JSON because a run is read as one report.
model SeoCompetitorAudit {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  competitorsChecked Int @default(0) @map("competitors_checked")
  ourPagesChecked    Int @default(0) @map("our_pages_checked")
  gapCount           Int @default(0) @map("gap_count")

  /// per-competitor: [{ domain, ok, pagesCrawled, topics: [{ topic, url, title }] }]
  competitors Json @map("competitors")
  /// the topics they cover and we don't: [{ topic, sampleTitle, competitor, sourceUrl }]
  gaps        Json @map("gaps")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([tenantId])
  @@map("seo_competitor_audits")
}

// One piece of content through brief -> write -> QA -> publish -> 30-day position check. No auto-publish (spam risk).
model SeoContentBrief {
  tenantId   String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String  @id @default(uuid()) @map("id")
  propertyId String  @map("property_id")
  keywordId  String? @map("keyword_id") // the backlog keyword this works, if any

  targetQuery String @map("target_query")
  intent      String @default("other") @map("intent")

  status String @default("BRIEF") @map("status") // BRIEF | WRITING | REVIEW | PUBLISHED | MEASURED | PARKED

  /// suggested H2 outline: string[]
  outline Json    @map("outline")
  angle   String? @map("angle") @db.Text
  notes   String? @map("notes") @db.Text

  publishedUrl String?   @map("published_url") @db.Text
  publishedAt  DateTime? @map("published_at")

  /// last QA run: { checkedAt, url, pass, score, checks: [{ id, label, ok, detail }] }
  qa Json? @map("qa")

  // 30-day outcome: GSC average position for targetQuery at publish vs at review.
  baselinePosition Float?    @map("baseline_position")
  reviewAt         DateTime? @map("review_at")
  reviewPosition   Float?    @map("review_position")
  reviewOutcome    String?   @map("review_outcome") // WON | FLAT | LOST

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([reviewAt])
  @@index([tenantId])
  @@map("seo_content_briefs")
}

// Backlinks pasted from an AWT / Search Console export (neither has a free API). Each import is the full current
// set, so links missing from it become LOST. One row per linking page.
model SeoBacklink {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  sourceUrl    String  @map("source_url") @db.Text // the page linking to us
  sourceDomain String  @map("source_domain") // its host, for referring-domain counts
  targetUrl    String? @map("target_url") @db.Text // our page it points at
  anchor       String? @map("anchor") @db.Text
  domainRating Int?    @map("domain_rating") // optional authority (AWT DR / Moz DA)

  source String @default("MANUAL") @map("source") // AWT | GSC | MANUAL
  status String @default("ACTIVE") @map("status") // ACTIVE | LOST

  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @default(now()) @map("last_seen")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, sourceUrl])
  @@index([propertyId, status])
  @@index([propertyId, sourceDomain])
  @@index([propertyId, firstSeen])
  @@index([tenantId])
  @@map("seo_backlinks")
}

// Daily accident monitor: one row per property per run, kept as history so the cron alerts only on a change.
model SeoMonitorRun {
  tenantId   String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String @id @default(uuid()) @map("id")
  propertyId String @map("property_id")

  status     String @map("status") // OK | ISSUES
  pagesOk    Int    @default(0) @map("pages_ok")
  pagesTotal Int    @default(0) @map("pages_total")
  /// [{ url, level, code, detail }] - only real accidents (down / noindex / robots block)
  issues     Json   @map("issues")

  createdAt DateTime @default(now()) @map("created_at")

  property SeoProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([tenantId])
  @@map("seo_monitor_runs")
}

// Client portal. Clients are a separate table from Employee so no HR query can ever return one; their session is
// kind:"client" and every staff guard rejects it. Access is deny-by-default, granted per project (ClientProjectAccess).

enum ClientAccessStatus {
  ACTIVE
  SUSPENDED
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

/// The company projects are delivered for; its people log in as ClientUsers. A project without one is internal.
model Client {
  tenantId    String       @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String       @id @default(uuid()) @map("id")
  name        String       @map("name")
  /// CL00001-style, generated once at creation. Fixed width, so it sorts.
  code        String       @map("code")
  /// URL identifier from the name at creation. Not regenerated on rename.
  slug        String?      @map("slug")
  status      ClientStatus @default(ACTIVE) @map("status")
  industry    String?      @map("industry")
  website     String?      @map("website")
  email       String?      @map("email")
  phone       String?      @map("phone")
  address     String?      @map("address") @db.Text
  /// GST / VAT / tax registration, as printed on invoices.
  taxId       String?      @map("tax_id")
  notes       String?      @map("notes") @db.Text
  /// The account manager for the relationship as a whole.
  ownerId     String?      @map("owner_id")
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  owner     Employee?    @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy Employee?    @relation("ClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  projects  Project[]
  contacts  ClientUser[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([status])
  @@index([ownerId])
  @@index([tenantId])
  @@map("clients")
}

model ClientUser {
  tenantId     String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String  @id @default(uuid()) @map("id")
  email        String  @unique @map("email")
  name         String  @map("name")
  phone        String? @map("phone")
  /// Legacy free-text company shown in the portal header; the Client row is the source of truth.
  company      String? @map("company")
  /// Null on logins made before Client rows existed.
  clientId     String? @map("client_id")
  /// Null until set via the invite flow. Omitted by default (server/db.ts); only the credentials provider selects it.
  passwordHash String? @map("password_hash")

  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy Employee?             @relation("ClientUserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  client    Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  access    ClientProjectAccess[]
  uploadedResources ProjectResource[] @relation("ResourceClientUploader")
  reviewedResources ProjectResource[] @relation("ResourceReviewer")
  activity  ClientActivityLog[]

  membership Membership?

  calendars ProjectWorkbook[] @relation("WorkbookClientAuthor")

  campaigns    ProjectCampaign[]      @relation("CampaignClientAuthor")
  templates    ProjectEmailTemplate[] @relation("TemplateClientAuthor")
  mailerAssets ProjectMailerAsset[]   @relation("MailerAssetClientAuthor")

  plannedDeliverables  ProjectDeliverable[]      @relation("DeliverableClientLogger")
  acceptedDeliverables ProjectDeliverable[]      @relation("DeliverableClientAcceptor")
  deliverableEvents    ProjectDeliverableEvent[] @relation("DeliverableEventClientActor")

  sheetEvents ProjectSheetEvent[] @relation("SheetEventClientActor")

  @@index([isActive])
  @@index([clientId])
  @@index([tenantId])
  @@map("client_users")
}

/// What a CLIENT did in the portal. Separate from audit_logs because AuditLog.actorId is an FK to employees.
/// Shown to the client and to staff, so `summary` is plain language.
model ClientActivityLog {
  tenantId     String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String  @id @default(uuid()) @map("id")
  clientUserId String  @map("client_user_id")
  /// Null for account-level actions (sign-in, password change).
  projectId    String? @map("project_id")

  action     String  @map("action")
  module     String  @map("module")
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  /// Human-readable line, e.g. 'Sent campaign "Diwali Preview" to 311 recipients'.
  summary    String? @map("summary")
  changes    Json?   @map("changes")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientUserId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@index([tenantId])
  @@map("client_activity_logs")
}

/// The grant: THIS client user sees THESE modules on THIS project. No row = the project is invisible to them.
/// Modules are per grant, so two clients on one project can see different sections.
model ClientProjectAccess {
  tenantId     String             @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id           String             @id @default(uuid()) @map("id")
  clientUserId String             @map("client_user_id")
  projectId    String             @map("project_id")
  /// Keys from features/client-portal/modules.ts; unknown keys are ignored, so a stale key never widens access.
  modules      String[]           @map("modules")
  status       ClientAccessStatus @default(ACTIVE) @map("status")
  grantedById  String?            @map("granted_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grantedBy  Employee?  @relation("ClientAccessGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([clientUserId, projectId])
  @@index([projectId])
  @@index([tenantId])
  @@map("client_project_access")
}

// Marketplace / product catalog. Provider-agnostic: channels differ only by `provider` and the credential blob.

enum MarketplaceProvider {
  SHOPIFY
  AMAZON
  FLIPKART
  MEESHO
  MYNTRA
  WOOCOMMERCE
  OTHER
}

model MarketplaceChannel {
  tenantId   String              @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String              @id @default(uuid()) @map("id")
  projectId  String              @map("project_id")
  provider   MarketplaceProvider @map("provider")
  /// Display name; one project can have several channels of a provider (storefronts / regions).
  name       String              @map("name")
  /// The provider's own account handle - shop domain, seller id, etc.
  externalId String?             @map("external_id")

  /// Provider credentials, encrypted with lib/crypto. Never exposed on any portal route.
  credentials   String?   @map("credentials") @db.Text
  status        String    @default("pending") @map("status") // "connected" | "pending" | "error"
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastSyncError String?   @map("last_sync_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([projectId, provider, name])
  @@index([projectId])
  @@index([tenantId])
  @@map("marketplace_channels")
}

model Product {
  tenantId   String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String  @id @default(uuid()) @map("id")
  projectId  String  @map("project_id")
  /// Null for a product entered manually rather than synced from a channel.
  channelId  String? @map("channel_id")
  /// The provider's product id, used to upsert on re-sync.
  externalId String? @map("external_id")

  title       String  @map("title")
  sku         String? @map("sku")
  description String? @map("description") @db.Text
  imageUrl    String? @map("image_url")
  vendor      String? @map("vendor")
  category    String? @map("category")

  price          Decimal? @map("price") @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  currency       String   @default("INR") @map("currency")
  inventoryQty   Int?     @map("inventory_qty")

  /// Provider status lower-cased ("active" | "draft" | "archived") so the portal can filter on it.
  status String   @default("active") @map("status")
  tags   String[] @map("tags")
  /// Public storefront/listing URL, so the client can open the live product.
  url    String?  @map("url")

  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel MarketplaceChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([channelId, externalId])
  @@index([projectId, status])
  @@index([projectId, title])
  @@index([tenantId])
  @@map("products")
}

// Monitoring: ProjectAsset tracks what expires and whose job it is; UptimeMonitor checks the site is serving now.

enum MonitoredAssetKind {
  DOMAIN
  SSL
  HOSTING
  LICENSE
  OTHER
}

/// A thing that expires and will take the site down if it lapses.
model ProjectAsset {
  tenantId  String             @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String             @id @default(uuid()) @map("id")
  projectId String             @map("project_id")
  kind      MonitoredAssetKind @default(DOMAIN) @map("kind")
  name      String             @map("name")
  provider  String?            @map("provider")
  url       String?            @map("url")

  expiresAt DateTime @map("expires_at") @db.Date
  /// Auto-renew ON isn't safety: it only changes what the reminder says, never whether one is sent.
  autoRenew Boolean  @default(true) @map("auto_renew")

  /// The card/account that pays for it and when that expires - failed auto-renewals are usually a dead card.
  paymentMethod    String?   @map("payment_method")
  paymentExpiresAt DateTime? @map("payment_expires_at") @db.Date

  /// The person accountable for this renewal. Null = nobody owns it, which is flagged as a problem.
  ownerId String? @map("owner_id")
  notes   String? @map("notes") @db.Text

  /// Last reminder threshold sent (60/30/14/7/3/1/0), so the daily job nudges once per stage.
  lastAlertStage  Int?      @map("last_alert_stage")
  lastAlertAt     DateTime? @map("last_alert_at")
  /// Separate from lastAlertAt so card and renewal warnings don't suppress each other (max one of each per day).
  lastCardAlertAt DateTime? @map("last_card_alert_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   Employee? @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("project_assets")
}

enum UptimeState {
  UNKNOWN
  UP
  DOWN
}

model UptimeMonitor {
  tenantId  String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String  @id @default(uuid()) @map("id")
  projectId String  @map("project_id")
  url       String  @map("url")
  label     String? @map("label")
  isActive  Boolean @default(true) @map("is_active")

  state                UptimeState @default(UNKNOWN) @map("state")
  lastCheckedAt        DateTime?   @map("last_checked_at")
  lastStatusCode       Int?        @map("last_status_code")
  lastError            String?     @map("last_error")
  /// The state flips only after N checks in a row either way (one timeout is noise).
  consecutiveFailures  Int         @default(0) @map("consecutive_failures")
  consecutiveSuccesses Int         @default(0) @map("consecutive_successes")

  /// Who gets told first. Falls back to the project's Account Manager.
  ownerId String? @map("owner_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     Employee?        @relation("MonitorOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  incidents UptimeIncident[]

  @@unique([projectId, url])
  @@index([isActive])
  @@index([tenantId])
  @@map("uptime_monitors")
}

/// One outage, start to finish.
model UptimeIncident {
  tenantId   String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String    @id @default(uuid()) @map("id")
  monitorId  String    @map("monitor_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  statusCode Int?      @map("status_code")
  detail     String?   @map("detail") @db.Text

  /// Acknowledgement stops the escalation ladder.
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id")

  /// 0 = owner told, 1 = their manager, 2 = admins.
  escalationLevel Int       @default(0) @map("escalation_level")
  lastEscalatedAt DateTime? @map("last_escalated_at")

  monitor        UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  acknowledgedBy Employee?     @relation("IncidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([monitorId, startedAt])
  @@index([endedAt])
  @@index([tenantId])
  @@map("uptime_incidents")
}

// Per-project outbound email from the client's own SMTP/domain. Sending is queued: one ProjectCampaignSend row
// per recipient, drained by the scheduler in small batches.
model ProjectMailer {
  tenantId  String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String @id @default(uuid()) @map("id")
  projectId String @map("project_id")
  /// A project can have several sending accounts; this is the label the campaign picker shows.
  name      String @map("name")

  fromName  String  @map("from_name")
  fromEmail String  @map("from_email")
  replyTo   String? @map("reply_to")

  host     String  @map("host")
  port     Int     @default(587) @map("port")
  secure   Boolean @default(false) @map("secure")
  username String  @map("username")
  /// ENCRYPTED with lib/crypto. Never selected into an API response.
  password String  @map("password") @db.Text

  isActive Boolean @default(true) @map("is_active")

  /// Result of the last test email, so the screen shows whether these credentials ever worked.
  lastVerifiedAt DateTime? @map("last_verified_at")
  lastError      String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaigns ProjectCampaign[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([tenantId])
  @@map("project_mailers")
}

model ProjectMailerAsset {
  tenantId    String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String @id @default(uuid()) @map("id")
  projectId   String @map("project_id")
  /// Served through a PUBLIC route (email clients fetch images without cookies); the uuid id is the only guard.
  objectKey   String @map("object_key")
  fileName    String @map("file_name")
  contentType String @map("content_type")
  size        Int    @map("size")

  createdById       String?  @map("created_by_id")
  /// Set instead of createdById when a client-portal account made this.
  createdByClientId String?  @map("created_by_client_id")
  createdAt         DateTime @default(now()) @map("created_at")

  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       Employee?   @relation("MailerAssetAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdByClient ClientUser? @relation("MailerAssetClientAuthor", fields: [createdByClientId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([tenantId])
  @@map("project_mailer_assets")
}

model ProjectEmailTemplate {
  tenantId  String        @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String        @id @default(uuid()) @map("id")
  projectId String        @map("project_id")
  name      String        @map("name")
  subject   String        @map("subject")
  /// Always HTML; bodyMode only records which editor authored it.
  bodyHtml  String        @map("body_html") @db.Text
  bodyMode  EmailBodyMode @default(RICH) @map("body_mode")
  isActive  Boolean       @default(true) @map("is_active")

  createdById       String?  @map("created_by_id")
  /// Set instead of createdById when a client-portal account made this.
  createdByClientId String?  @map("created_by_client_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       Employee?         @relation("ProjectTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdByClient ClientUser?       @relation("TemplateClientAuthor", fields: [createdByClientId], references: [id], onDelete: SetNull)
  campaigns       ProjectCampaign[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([tenantId])
  @@map("project_email_templates")
}

model ProjectRecipient {
  tenantId  String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String   @id @default(uuid()) @map("id")
  projectId String   @map("project_id")
  email     String   @map("email")
  name      String?  @map("name")
  company   String?  @map("company")
  /// Free-form segments ("newsletter", "vip") so a campaign can target a slice.
  tags      String[] @map("tags")
  /// Merge data ({ "plan": "Pro" }). Unknown keys render empty, so templates needn't match the list.
  fields    Json?    @map("fields")

  /// Unsubscribes are permanent and checked at send time, so opting out mid-campaign stops the rest.
  isSubscribed   Boolean   @default(true) @map("is_subscribed")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sends   ProjectCampaignSend[]

  @@unique([projectId, email])
  @@index([projectId, isSubscribed])
  @@index([tenantId])
  @@map("project_recipients")
}

enum EmailBodyMode {
  /// Composed in the WYSIWYG editor.
  RICH
  /// Hand-written HTML.
  HTML
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model ProjectCampaign {
  tenantId   String         @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String         @id @default(uuid()) @map("id")
  projectId  String         @map("project_id")
  templateId String?        @map("template_id")
  /// SMTP account to send from, fixed at queue time.
  mailerId   String?        @map("mailer_id")
  name       String         @map("name")
  subject    String         @map("subject")
  bodyHtml   String         @map("body_html") @db.Text
  bodyMode   EmailBodyMode  @default(RICH) @map("body_mode")
  status     CampaignStatus @default(DRAFT) @map("status")

  /// Snapshotted at queue time so progress is stable even if recipients change.
  totalCount  Int @default(0) @map("total_count")
  sentCount   Int @default(0) @map("sent_count")
  failedCount Int @default(0) @map("failed_count")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Who queued it: exactly one is set (staff and client-portal accounts are separate tables).
  createdById       String?  @map("created_by_id")
  createdByClientId String?  @map("created_by_client_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        ProjectEmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mailer          ProjectMailer?        @relation(fields: [mailerId], references: [id], onDelete: SetNull)
  createdBy       Employee?             @relation("CampaignAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdByClient ClientUser?           @relation("CampaignClientAuthor", fields: [createdByClientId], references: [id], onDelete: SetNull)
  sends           ProjectCampaignSend[]

  @@index([projectId, createdAt])
  @@index([status])
  @@index([tenantId])
  @@map("project_campaigns")
}

/// One row per recipient per campaign: the send log AND the work queue, so a half-finished blast resumes from PENDING.
model ProjectCampaignSend {
  tenantId    String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String  @id @default(uuid()) @map("id")
  campaignId  String  @map("campaign_id")
  recipientId String? @map("recipient_id")
  /// Denormalised: the address actually used, even if the recipient is later deleted.
  email       String  @map("email")
  name        String? @map("name")

  status String    @default("PENDING") @map("status") // PENDING | SENT | FAILED
  error  String?   @map("error") @db.Text
  sentAt DateTime? @map("sent_at")

  /// When the row was claimed (PENDING -> SENDING). Stuck-send requeue measures from this, not createdAt,
  /// which every row of a bulk campaign shares.
  claimedAt DateTime? @map("claimed_at")

  createdAt DateTime @default(now()) @map("created_at")

  campaign  ProjectCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient ProjectRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([status])
  @@index([tenantId])
  @@map("project_campaign_sends")
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
}

/// A company-wide notice, visible to every employee; only `announcement:write` holders create them.
model Announcement {
  tenantId String               @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String               @id @default(uuid()) @map("id")
  title    String               @map("title")
  body     String               @map("body")
  /// Free text ("Information", "Holiday Notification"), not an enum, so HR can add categories freely.
  category String               @map("category")
  priority AnnouncementPriority @default(NORMAL) @map("priority")

  /// Drafts are invisible to everyone but their author until published.
  isPublished Boolean   @default(true) @map("is_published")
  publishedAt DateTime  @default(now()) @map("published_at")
  /// Past this, it drops off the board on its own. Null = stays until deleted.
  expiresAt   DateTime? @map("expires_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy Employee? @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([tenantId])
  @@map("announcements")
}

/// One event's worth of photos ("Diwali 2026").
model PhotoAlbum {
  tenantId    String    @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String    @id @default(uuid()) @map("id")
  /// URL key from the title at creation; never regenerated on rename, so shared links keep working.
  slug        String    @map("slug")
  title       String    @map("title")
  description String?   @map("description")
  /// When the event happened, which is what people sort by - not upload date.
  eventDate   DateTime? @map("event_date") @db.Date

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy Employee? @relation("AlbumAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  photos    Photo[]

  @@unique([tenantId, slug])
  @@index([eventDate])
  @@index([tenantId])
  @@map("photo_albums")
}

/// A single image in an album. Bytes live in B2, served via a signed-URL redirect so the bucket stays private.
model Photo {
  tenantId    String  @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id          String  @id @default(uuid()) @map("id")
  albumId     String  @map("album_id")
  objectKey   String  @map("object_key")
  /// 480px WebP thumbnail for grids and covers. Null for videos and older images (they fall back to objectKey).
  thumbKey    String? @map("thumb_key")
  fileName    String  @map("file_name")
  contentType String  @map("content_type")
  size        Int     @map("size")
  caption     String? @map("caption")
  /// Lets the grid reserve the right space before the image loads.
  width       Int?    @map("width")
  height      Int?    @map("height")

  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  album      PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploadedBy Employee?  @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([albumId, createdAt])
  @@index([tenantId])
  @@map("photos")
}

/// A private 1:1 chat between two employees, never readable from a project surface.
/// `pairKey` = both employee ids sorted and joined, so A->B and B->A resolve to the same row.
model Conversation {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")
  pairKey  String @unique @map("pair_key")

  /// Denormalised so the conversation list can sort without touching messages.
  lastMessageAt DateTime? @map("last_message_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@index([lastMessageAt])
  @@index([tenantId])
  @@map("conversations")
}

model ConversationParticipant {
  tenantId       String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  conversationId String @map("conversation_id")
  employeeId     String @map("employee_id")

  /// Everything after this timestamp is unread.
  lastReadAt DateTime? @map("last_read_at")
  /// Hidden from the list until the next message arrives; the history stays.
  isArchived Boolean   @default(false) @map("is_archived")
  /// Pinned to the top of THIS person's list only, hence on the participant row.
  pinnedAt   DateTime? @map("pinned_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("ChatParticipant", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([conversationId, employeeId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("conversation_participants")
}

model ChatMessage {
  tenantId       String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id             String @id @default(uuid()) @map("id")
  conversationId String @map("conversation_id")
  senderId       String @map("sender_id")
  body           String @map("body")

  /// Soft delete ("deleted for everyone") so the thread doesn't reshuffle around a gap.
  deletedAt   DateTime? @map("deleted_at")
  /// "Delete for me": employee ids that hid this message. An array, not a table, since it's read on every fetch.
  hiddenFor   String[]  @map("hidden_for")
  editedAt    DateTime? @map("edited_at")
  /// Set when the message reached the recipient's device; drives the second tick.
  deliveredAt DateTime? @map("delivered_at")

  /// The message this one quotes (personal chat has no sub-threads).
  replyToId String?       @map("reply_to_id")
  replyTo   ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")

  /// Pinned by either participant; both sides see the same pinned lines.
  pinnedAt  DateTime? @map("pinned_at")
  pinnedBy  String?   @map("pinned_by")
  createdAt DateTime  @default(now()) @map("created_at")

  conversation Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Employee              @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  ChatAttachment[]
  reactions    ChatMessageReaction[]
  poll         MessagePoll?
  event        MessageEvent?
  contact      MessageContact?

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@map("chat_messages")
}

/// A configured object-storage bucket (B2 or any S3-compatible). New uploads go to the single isDefault row;
/// existing objects never move when the default changes.
model StorageAccount {
  id    String @id @default(uuid()) @map("id")
  label String @map("label")

  endpoint String @map("endpoint")
  region   String @map("region")
  bucket   String @map("bucket")
  keyId    String @map("key_id")
  /// Encrypted at rest and never selected into a response.
  appKey   String @map("app_key")

  /// Exactly one default row (enforced by the service).
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  /// Result of the last "Test connection", so a broken key shows up before anyone uploads into it.
  lastVerifiedAt DateTime? @map("last_verified_at")
  lastError      String?   @map("last_error")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy Employee? @relation("StorageAccountAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isDefault])
  @@map("storage_accounts")
}

/// Whether an attachment renders as a picture, a voice note, or a file card.
enum ChatAttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
  /// A picture that is the whole message, drawn without a bubble.
  STICKER
}

/// One row per (message, person, emoji); the unique key makes tapping the same emoji again a toggle.
model ChatMessageReaction {
  tenantId   String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String   @id @default(uuid()) @map("id")
  messageId  String   @map("message_id")
  employeeId String   @map("employee_id")
  emoji      String   @map("emoji")
  createdAt  DateTime @default(now()) @map("created_at")

  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employee Employee    @relation("ChatReactor", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([messageId, employeeId, emoji])
  @@index([messageId])
  @@index([tenantId])
  @@map("chat_message_reactions")
}

model ChatAttachment {
  tenantId  String             @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id        String             @id @default(uuid()) @map("id")
  messageId String             @map("message_id")
  kind      ChatAttachmentKind @map("kind")

  objectKey   String @map("object_key")
  fileName    String @map("file_name")
  contentType String @map("content_type")
  size        Int    @map("size")

  /// Images: lets the bubble reserve space before the picture loads.
  width       Int?  @map("width")
  height      Int?  @map("height")
  /// Voice notes: shown on the player before the audio is fetched.
  durationSec Int?  @map("duration_sec")
  /// Voice notes: amplitude peaks (0-100) so the player draws the waveform without fetching the audio.
  waveform    Int[] @map("waveform")

  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([tenantId])
  @@map("chat_attachments")
}

/// A poll on a chat message or a project reply; exactly one parent is set, so both surfaces share one table.
model MessagePoll {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")

  chatMessageId  String? @unique @map("chat_message_id")
  projectReplyId String? @unique @map("project_reply_id")

  question      String    @map("question")
  allowMultiple Boolean   @default(false) @map("allow_multiple")
  closesAt      DateTime? @map("closes_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  chatMessage  ChatMessage?         @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  projectReply ProjectMessageReply? @relation(fields: [projectReplyId], references: [id], onDelete: Cascade)
  options      MessagePollOption[]

  @@index([tenantId])
  @@map("message_polls")
}

model MessagePollOption {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")
  pollId   String @map("poll_id")
  label    String @map("label")
  position Int    @map("position")

  poll  MessagePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes MessagePollVote[]

  @@index([pollId])
  @@index([tenantId])
  @@map("message_poll_options")
}

/// One row per person per option, so "did I vote?" and un-voting both work.
model MessagePollVote {
  tenantId String   @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String   @id @default(uuid()) @map("id")
  optionId String   @map("option_id")
  voterId  String   @map("voter_id")
  votedAt  DateTime @default(now()) @map("voted_at")

  option MessagePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voter  Employee          @relation("PollVoter", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([optionId, voterId])
  @@index([voterId])
  @@index([tenantId])
  @@map("message_poll_votes")
}

/// Something happening at a time, shared into a conversation.
model MessageEvent {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")

  chatMessageId  String? @unique @map("chat_message_id")
  projectReplyId String? @unique @map("project_reply_id")

  title    String    @map("title")
  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")
  location String?   @map("location")
  notes    String?   @map("notes")

  createdAt DateTime @default(now()) @map("created_at")

  chatMessage  ChatMessage?         @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  projectReply ProjectMessageReply? @relation(fields: [projectReplyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("message_events")
}

/// A colleague's card shared into a conversation. Details are snapshotted so the card doesn't change when they do.
model MessageContact {
  tenantId String @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id       String @id @default(uuid()) @map("id")

  chatMessageId  String? @unique @map("chat_message_id")
  projectReplyId String? @unique @map("project_reply_id")

  /// Kept so the card can link through while the person is still around.
  employeeId  String? @map("employee_id")
  name        String  @map("name")
  email       String? @map("email")
  phone       String? @map("phone")
  designation String? @map("designation")
  photo       String? @map("photo")

  createdAt DateTime @default(now()) @map("created_at")

  chatMessage  ChatMessage?         @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  projectReply ProjectMessageReply? @relation(fields: [projectReplyId], references: [id], onDelete: Cascade)
  employee     Employee?            @relation("SharedContact", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("message_contacts")
}

/// AT_RISK is a status, not a derived "overdue" flag: a goal can be behind before its target date.
enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  DONE
  /// Abandoned on purpose, with a reason; stays visible.
  DISCARDED
}

/// A project goal. One level of nesting only (sub-goals have none; the API enforces it).
/// A parent's progress is the average of its children; its own `progress` is ignored.
model ProjectGoal {
  tenantId      String     @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id            String     @id @default(uuid()) @map("id")
  projectId     String     @map("project_id")
  /// Null = a main goal. Set = a sub-goal of that main goal.
  parentId      String?    @map("parent_id")
  title         String     @map("title")
  description   String?    @map("description") @db.Text
  status        GoalStatus @default(NOT_STARTED) @map("status")
  /// 0-100. Authoritative for a leaf; ignored for a goal that has sub-goals.
  progress      Int        @default(0) @map("progress")
  targetDate    DateTime?  @map("target_date") @db.Date
  /// Manual ordering within a parent (or within the project, for main goals).
  sortOrder     Int        @default(0) @map("sort_order")
  /// Free-text labels ("weekly", "primary"), not an enum, so each team can use its own words.
  tags          String[]   @default([]) @map("tags")
  /// Soft delete: hidden and excluded from progress, but the history survives.
  isActive      Boolean    @default(true) @map("is_active")
  deactivatedAt DateTime?  @map("deactivated_at")
  /// Current reason for AT_RISK / DISCARDED (the full trail is in events).
  statusReason  String?    @map("status_reason") @db.Text
  createdById   String?    @map("created_by_id")
  /// Who is accountable for this goal landing (not the creator or the doers). Null = the account manager.
  ownerId       String?    @map("owner_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       ProjectGoal?         @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     ProjectGoal[]        @relation("GoalHierarchy")
  createdBy    Employee?            @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  owner        Employee?            @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events       ProjectGoalEvent[]
  /// The work that serves this goal. Progress derives from these when present.
  tasks        ProjectTask[]
  /// Countable output promised; when present, progress comes from delivered output.
  targets      ProjectGoalTarget[]
  /// Output attributed to this goal directly (not through a task).
  deliverables ProjectDeliverable[]

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, sortOrder])
  @@index([ownerId])
  @@map("project_goals")
}

enum GoalEventType {
  CREATED
  STATUS_CHANGED
  DEACTIVATED
  REACTIVATED
  EDITED
}

/// The history of one goal: append-only, never edited. Deleted with the goal when it is permanently removed.
model ProjectGoalEvent {
  tenantId   String        @default(dbgenerated("'0197d1ab-0000-7000-8000-000000000001'")) @map("tenant_id")
  id         String        @id @default(uuid()) @map("id")
  goalId     String        @map("goal_id")
  type       GoalEventType @map("type")
  fromStatus GoalStatus?   @map("from_status")
  toStatus   GoalStatus?   @map("to_status")
  /// Required for AT_RISK and DISCARDED, optional otherwise.
  reason     String?       @map("reason") @db.Text
  actorId    String?       @map("actor_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  goal  ProjectGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actor Employee?   @relation("GoalEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@map("project_goal_events")
}

// AI connector (MCP + OAuth 2.1): DNMS is the OAuth server for AI apps, and a token acts as the person who allowed it.
// Tokens are opaque random strings; only their SHA-256 hashes are stored.

/// An OAuth client (one AI app). Global, no tenantId: the same app serves every company.
model OAuthClient {
  id           String    @id @default(uuid()) @map("id")
  /// What the app sends as client_id: a CIMD https URL, or "dnms_dcr_..." for DCR.
  clientId     String    @unique @map("client_id")
  /// "cimd" | "dcr"
  kind         String    @map("kind")
  name         String    @map("name")
  clientUri    String?   @map("client_uri")
  redirectUris String[]  @map("redirect_uris")
  /// The metadata document (CIMD) or registration request (DCR), as received.
  metadata     Json      @map("metadata")
  /// CIMD only: when the document was last fetched. Re-fetched after 24 hours.
  fetchedAt    DateTime? @map("fetched_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  grants OAuthGrant[]

  @@map("oauth_clients")
}

/// One authorization request (/api/oauth/authorize -> code on Allow -> /api/oauth/token). Global and
/// short-lived: 10 minutes pending, 60 seconds once a code exists.
model OAuthAuthorization {
  id            String    @id @default(uuid()) @map("id")
  clientId      String    @map("client_id")
  redirectUri   String    @map("redirect_uri")
  state         String?   @map("state")
  scope         String    @map("scope")
  resource      String    @map("resource")
  codeChallenge String    @map("code_challenge")
  /// SHA-256 of the one-time code. Null until Allow.
  codeHash      String?   @unique @map("code_hash")
  /// The grant created on Allow.
  grantId       String?   @map("grant_id")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_authorizations")
}

/// A connection ("Karan connected Claude"), shown on /ai-connections. Revoking it kills all its tokens.
model OAuthGrant {
  tenantId      String    @map("tenant_id")
  id            String    @id @default(uuid()) @map("id")
  membershipId  String    @map("membership_id")
  userId        String    @map("user_id")
  employeeId    String    @map("employee_id")
  clientId      String    @map("client_id")
  scope         String    @map("scope")
  resource      String    @map("resource")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  client     OAuthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tokens     OAuthToken[]
  toolCalls  McpToolCall[]

  @@index([tenantId, employeeId])
  @@index([membershipId])
  @@map("oauth_grants")
}

/// An access or refresh token. Looked up by hash with no tenant filter: the token decides the company.
model OAuthToken {
  id        String    @id @default(uuid()) @map("id")
  grantId   String    @map("grant_id")
  /// "access" | "refresh"
  kind      String    @map("kind")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Refresh tokens: when exchanged. Reuse after that is treated as theft and revokes the whole grant.
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("oauth_tokens")
}

/// One row per AI tool call. Not written for the hidden admin_ account; purged after 90 days.
model McpToolCall {
  tenantId   String   @map("tenant_id")
  id         String   @id @default(uuid()) @map("id")
  grantId    String   @map("grant_id")
  employeeId String   @map("employee_id")
  tool       String   @map("tool")
  /// e.g. "GET /api/leave/requests" for the API pass-through tool.
  target     String?  @map("target")
  ok         Boolean  @map("ok")
  status     Int?     @map("status")
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([grantId, createdAt])
  @@map("mcp_tool_calls")
}
